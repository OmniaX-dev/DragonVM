// expect-rv: 0
#include(check.ds)

var calls: i32 = 0;

sub side(var v: bool) -> bool {
    calls++;
    return v;
}

sub main() -> i32 {
    // if / else
    var x: i32 = 3;
    var r: i32 = 0;
    if (x > 2) r = 1; else r = 2;
    check(1, r == 1);
    if (x > 5) { r = 1; } else if (x == 3) { r = 3; } else { r = 4; }
    check(2, r == 3);
    // while / break / continue
    var sum: i32 = 0;
    var i: i32 = 0;
    while (true) {
        i++;
        if (i > 10) break;
        if (i % 2 == 0) continue;
        sum += i;
    }
    check(3, sum == 25);
    // do / while
    var n: i32 = 0;
    do { n++; } while (n < 5);
    check(4, n == 5);
    do { n++; } while (false);
    check(5, n == 6);
    // for, nested, with break
    var count: i32 = 0;
    for (var a: i32 = 0; a < 4; a++) {
        for (var b: i32 = 0; b < 4; b++) {
            if (b == 2) break;
            count++;
        }
    }
    check(6, count == 8);
    var f: i32 = 0;
    for (;;) { f++; if (f == 3) break; }
    check(7, f == 3);
    // short-circuit
    calls = 0;
    if (side(false) && side(true)) r = 9;
    check(8, calls == 1);
    calls = 0;
    if (side(true) || side(true)) r = 9;
    check(9, calls == 1);
    calls = 0;
    var both: bool = side(true) and side(false);
    check(10, calls == 2 && !both);
    check(11, (true or false) && not false);
    // ?:
    check(12, (x > 1 ? 10 : 20) == 10);
    check(13, (x < 1 ? 10 : 20) == 20);
    // conditions on pointers and integers
    var p: i32* = null;
    check(14, !p);
    p = &x;
    check(15, p != null && p);
    var bits: i32 = 4;
    check(16, bits && 1);
    return result();
}
