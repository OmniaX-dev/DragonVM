// std::U64 / std::I64 (int64.ds) against values computed on the host: edge cases and random values
// for every operation, the u32 / i32 overloads (sign / zero extension, the smaller types), text,
// parse errors, chaining, aliasing, constructors. Generated (the cases are tables: one call of
// each method, in the dispatchers). Signed division truncates toward zero, as for i32.
// expect-rv: 0
#import(<dragon-sdk>)

var g_failures: i32 = 0;

sub expect(var id: i32, var ok: bool) {
	if (ok)
		return;
	var buff: u8[12];
	debug_print("int64: check ");
	debug_print(std::itoa(id, buff));
	debug_print(" failed\n");
	g_failures++;
}

sub same(var a: std::U64*, var hi: u32, var lo: u32) -> bool { return a->hi == hi and a->lo == lo; }
