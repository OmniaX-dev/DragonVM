// BinU / BinI: op, a, b, expected (7 words).
sub bin_u(var op: u32, var x: std::U64*, var o: std::U64*) -> u32 {
	if (op == 0) x->add(o); else if (op == 1) x->subt(o); else if (op == 2) x->mul(o); else if (op == 3) x->div(o);
	else if (op == 4) x->mod(o); else if (op == 5) x->band(o); else if (op == 6) x->bor(o); else if (op == 7) x->bxor(o);
	else if (op == 8) x->min(o); else if (op == 9) x->max(o);
	else if (op == 10) return cast<u32>(x->cmp(o));
	else if (op == 11) return (x->lt(o) ? 1 : 0); else if (op == 12) return (x->le(o) ? 1 : 0);
	else if (op == 13) return (x->gt(o) ? 1 : 0); else if (op == 14) return (x->ge(o) ? 1 : 0);
	else if (op == 15) return (x->eq(o) ? 1 : 0); else if (op == 16) return (x->ne(o) ? 1 : 0);
	return 0xDEAD;
}
sub bin_i(var op: u32, var x: std::I64*, var o: std::I64*) -> u32 {
	if (op == 0) x->add(o); else if (op == 1) x->subt(o); else if (op == 2) x->mul(o); else if (op == 3) x->div(o);
	else if (op == 4) x->mod(o); else if (op == 5) x->min(o); else if (op == 6) x->max(o);
	else if (op == 7) return cast<u32>(x->cmp(o));
	else if (op == 8) return (x->lt(o) ? 1 : 0); else if (op == 9) return (x->le(o) ? 1 : 0);
	else if (op == 10) return (x->gt(o) ? 1 : 0); else if (op == 11) return (x->ge(o) ? 1 : 0);
	return 0xDEAD;
}
// Un: op, a, k, expected (6 words).
sub un_op(var op: u32, var x: std::U64*, var k: u32) -> u32 {
	var y: std::I64* = cast<std::I64*>(x);
	if (op == 0) x->shl(k); else if (op == 1) x->shr(k); else if (op == 2) y->shr(k); else if (op == 3) x->rol(k);
	else if (op == 4) x->ror(k); else if (op == 5) return (x->bit(k) ? 1 : 0); else if (op == 6) x->setb(k);
	else if (op == 7) x->clrb(k); else if (op == 8) return x->clz(); else if (op == 9) return x->ctz();
	else if (op == 10) return x->popc(); else if (op == 11) x->neg(); else if (op == 12) x->bnot();
	else if (op == 13) x->inc(); else if (op == 14) x->dec(); else if (op == 15) y->abs();
	else if (op == 16) return cast<u32>(y->sign()); else if (op == 17) return (x->fits32() ? 1 : 0);
	else if (op == 18) return (y->fits32() ? 1 : 0); else if (op == 19) y->dec();
	return 0xDEAD;
}

sub main() -> i32 {
	var x: std::U64;
	var o: std::U64;
	var y: std::I64;
	var p: std::I64;
	var id: i32 = 0;
	var r: u32 = 0;
	for (var i: u32 = 0; i < sizeof(BinU) / 4; i += 7) {
		x.set(BinU[i + 1], BinU[i + 2]);
		o.set(BinU[i + 3], BinU[i + 4]);
		r = bin_u(BinU[i], &x, &o);
		expect(100000 + cast<i32>(i / 7), (r == 0xDEAD ? same(&x, BinU[i + 5], BinU[i + 6]) : r == BinU[i + 6]));
	}
	for (var i: u32 = 0; i < sizeof(BinI) / 4; i += 7) {
		y.set(BinI[i + 1], BinI[i + 2]);
		p.set(BinI[i + 3], BinI[i + 4]);
		r = bin_i(BinI[i], &y, &p);
		expect(200000 + cast<i32>(i / 7), (r == 0xDEAD ? same(y.u(), BinI[i + 5], BinI[i + 6]) : r == BinI[i + 6]));
	}
	for (var i: u32 = 0; i < sizeof(Un) / 4; i += 6) {
		x.set(Un[i + 1], Un[i + 2]);
		r = un_op(Un[i], &x, Un[i + 3]);
		expect(300000 + cast<i32>(i / 6), (r == 0xDEAD ? same(&x, Un[i + 4], Un[i + 5]) : r == Un[i + 5]));
	}
	var rem: u32 = 0;
	var irem: i32 = 0;
	for (var i: u32 = 0; i < sizeof(Sc) / 4; i += 8) {
		id = 400000 + cast<i32>(i / 8) * 4;
		if (Sc[i] == 0) {
			expect(id, same(x.set(Sc[i + 1], Sc[i + 2])->div(Sc[i + 3]), Sc[i + 4], Sc[i + 5]));
			expect(id + 1, same(x.set(Sc[i + 1], Sc[i + 2])->mod(Sc[i + 3]), Sc[i + 6], Sc[i + 7]));
			expect(id + 2, same(x.set(Sc[i + 1], Sc[i + 2])->divmod(Sc[i + 3], &rem), Sc[i + 4], Sc[i + 5]) and rem == Sc[i + 7]);
		}
		else {
			var d: i32 = cast<i32>(Sc[i + 3]);
			expect(id, same(y.set(Sc[i + 1], Sc[i + 2])->div(d)->u(), Sc[i + 4], Sc[i + 5]));
			expect(id + 1, same(y.set(Sc[i + 1], Sc[i + 2])->mod(d)->u(), Sc[i + 6], Sc[i + 7]));
			expect(id + 2, same(y.set(Sc[i + 1], Sc[i + 2])->divmod(d, &irem)->u(), Sc[i + 4], Sc[i + 5]) and irem == cast<i32>(Sc[i + 7]));
		}
	}
	var buf: u8[72];
	for (var i: u32 = 0; i < sizeof(Tx) / 4; i += 4) {
		var n: u32 = i / 4;
		id = 500000 + cast<i32>(n) * 2;
		if (Tx[i] == 0) {
			expect(id, dr::strcmp(x.set(Tx[i + 2], Tx[i + 3])->str(buf, Tx[i + 1]), TxS[n]) == 0);
			expect(id + 1, o.parse(TxS[n], Tx[i + 1]) and o.eq(&x));
		}
		else {
			expect(id, dr::strcmp(y.set(Tx[i + 2], Tx[i + 3])->str(buf, Tx[i + 1]), TxS[n]) == 0);
			expect(id + 1, p.parse(TxS[n], Tx[i + 1]) and p.eq(&y));
		}
	}

	// The u32 / i32 overloads: zero / sign extension, the smaller types.
	var u8v: u8 = 200;
	var i8v: i8 = -3;
	var u16v: u16 = 60000;
	var i16v: i16 = -30000;
	expect(1, same(x.set(0, 10)->add(-1), 0, 9));
	expect(2, same(x.set(0, 10)->add(u8v), 0, 210));
	expect(3, same(x.set(0, 10)->add(i8v), 0, 7));
	expect(4, same(x.set(5)->subt(10), 0xFFFFFFFF, 0xFFFFFFFB));
	expect(5, same(x.set(-1), 0xFFFFFFFF, 0xFFFFFFFF));
	expect(6, same(x.set(0xFFFFFFFF), 0, 0xFFFFFFFF));
	expect(7, same(y.set(i16v)->mul(u16v)->u(), 0xFFFFFFFF, 0x94B62E00));		// -1800000000
	expect(8, same(y.set(-5)->mul(-7)->add(u8v)->u(), 0, 235));
	expect(9, same(x.set(1)->shl(40)->add(3)->mul(5)->subt(1), 0x500, 0x0000000E));
	expect(10, x.set(-1)->gt(0) and not y.set(-1)->gt(0));
	expect(11, y.set(-1)->lt(cast<u32>(0xFFFFFFFF)) and x.set(1, 0)->gt(cast<u32>(0xFFFFFFFF)));
	expect(12, same(x.set(0, 0xF0F0)->band(u16v), 0, 0xF0F0 & 60000) and same(x.set(7, 0xF0)->band(-16), 7, 0xF0));
	expect(13, same(x.set(0, 1)->bor(i8v), 0xFFFFFFFF, 0xFFFFFFFD) and same(x.set(3, 1)->bxor(cast<u32>(3)), 3, 2));
	expect(14, x.set(0, 5)->eq(5) and x.set(0xFFFFFFFF, 0xFFFFFFFB)->eq(-5) and y.set(-5)->eq(-5) and not y.set(-5)->eq(cast<u32>(0xFFFFFFFB)));
	expect(15, same(x.set(0, 10)->min(u8v), 0, 10) and same(x.set(0, 10)->max(u8v), 0, 200) and same(y.set(10)->min(i8v)->u(), 0xFFFFFFFF, 0xFFFFFFFD));
	// Aliasing: an operand that is the struct itself.
	x.set(3, 5);
	expect(16, same(x.mul(&x), 0x1E, 0x19));
	x.set(0x12345678, 0x9ABCDEF0);
	o.set(0, 7);
	x.divmod(&o, &o);
	expect(17, same(&x, 0x0299C335, 0xCCF668FD) and same(&o, 0, 5));		// 0x123456789ABCDEF0 / 7, % 7
	// Constructors and conversions.
	var c1: std::U64(-2);
	var c2: std::I64(7, 8);
	var c3: std::U64(&c2);
	var c4: std::I64(&c1);
	var c5: std::U64(cast<u32>(0x80000000));
	expect(18, same(&c1, 0xFFFFFFFF, 0xFFFFFFFE) and same(c2.u(), 7, 8) and same(&c3, 7, 8) and c4.to_i32() == -2 and c4.is_neg());
	expect(19, same(&c5, 0, 0x80000000) and c5.to_u32() == 0x80000000);
	// Parse errors: false, no change.
	o.set(1);
	expect(20, not o.parse("") and not o.parse("12a") and not o.parse("18446744073709551616") and not o.parse("-1") and not o.parse("0x", 16) and not o.parse("5", 37) and o.eq(1));
	p.set(1);
	expect(21, not p.parse("9223372036854775808") and not p.parse("-9223372036854775809") and not p.parse("--1") and not p.parse("+") and p.eq(1));
	expect(22, p.parse("-9223372036854775808") and same(p.u(), 0x80000000, 0) and p.parse("+42") and p.eq(42));
	expect(23, o.parse("0xFFFFffffFFFFFFFF", 16) and o.eq(-1) and o.parse("18446744073709551615") and o.eq(-1));
	return g_failures;
}
