// std::memcpy / std::memset (8-word rounds, word loops) against byte loops: every size 0 - 37 at
// every alignment of the source and the destination, overlapping copies at distances -9 .. 9 and
// (bigger copies, through the 8-word rounds) -40 .. 40 (forward: the same bytes as a byte loop,
// also dst 1 - 31 bytes above src), the bytes around untouched, the return values.
// expect-rv: 0
#import(<dragon-sdk>)

var g_failures: i32 = 0;

sub expect(var id: i32, var ok: bool) {
	if (ok)
		return;
	var buff: u8[12];
	debug_print("sdk_memcpy: check ");
	debug_print(std::itoa(id, buff));
	debug_print(" failed\n");
	g_failures++;
}

var ref: u8[256];
var got: u8[256];

sub fill_both() {
	for (var i: u32 = 0; i < g_span; i++) {
		ref[i] = cast<u8>(i * 37 + 11);
		got[i] = ref[i];
	}
}

// (the first 128 bytes for the small cases; all 256 for the bigger ones)
var g_span: u32 = 128;

sub same() -> bool {
	for (var i: u32 = 0; i < g_span; i++) {
		if (ref[i] != got[i])
			return false;
	}
	return true;
}

sub byte_copy(var d: u8*, var s: u8*, var n: u32) {
	for (var i: u32 = 0; i < n; i++)
		d[i] = s[i];
}

sub main() -> i32 {
	// Apart: source at 8 + sa, destination at 64 + da.
	for (var n: u32 = 0; n <= 37; n++) {
		for (var sa: u32 = 0; sa < 4; sa++) {
			for (var da: u32 = 0; da < 4; da++) {
				fill_both();
				byte_copy(&ref[64 + da], &ref[8 + sa], n);
				var r: void* = std::memcpy(&got[64 + da], &got[8 + sa], n);
				expect(cast<i32>(1000 + n * 16 + sa * 4 + da), same() and r == cast<void*>(&got[64 + da]));
			}
		}
	}
	// Overlapping: destination = source + gap (gap -9 .. 9).
	for (var n: u32 = 0; n <= 20; n++) {
		for (var g: i32 = -9; g <= 9; g++) {
			fill_both();
			byte_copy(&ref[cast<u32>(40 + g)], &ref[40], n);
			std::memcpy(&got[cast<u32>(40 + g)], &got[40], n);
			expect(cast<i32>(2000 + n * 20) + g + 9, same());
		}
	}
	g_span = 256;
	// Bigger, overlapping: destination = source + gap (gap -40 .. 40), sizes 33, 56, 79.
	for (var n: u32 = 33; n < 80; n += 23) {
		for (var g: i32 = -40; g <= 40; g++) {
			fill_both();
			byte_copy(&ref[cast<u32>(100 + g)], &ref[100], n);
			std::memcpy(&got[cast<u32>(100 + g)], &got[100], n);
			expect(cast<i32>(4000 + n * 100) + g + 40, same());
		}
	}
	// Bigger, apart, at every alignment (the rounds, then the words, then the bytes).
	for (var n: u32 = 60; n <= 103; n += 7) {
		for (var sa: u32 = 0; sa < 4; sa++) {
			fill_both();
			byte_copy(&ref[140 + sa], &ref[4 + sa * 3], n);
			std::memcpy(&got[140 + sa], &got[4 + sa * 3], n);
			expect(cast<i32>(5000 + n * 4 + sa), same());
		}
	}
	// memset: bigger sizes (the rounds) too.
	for (var n: u32 = 60; n <= 103; n += 7) {
		for (var a: u32 = 0; a < 4; a++) {
			fill_both();
			for (var i: u32 = 0; i < n; i++)
				ref[16 + a + i] = 0x5C;
			std::memset(&got[16 + a], 0x5C, n);
			expect(cast<i32>(6000 + n * 4 + a), same());
		}
	}
	g_span = 128;
	// memset.
	var values: u8[3] = { 0x00, 0xA5, 0xFF };
	for (var n: u32 = 0; n <= 37; n++) {
		for (var a: u32 = 0; a < 4; a++) {
			for (var v: u32 = 0; v < 3; v++) {
				fill_both();
				for (var i: u32 = 0; i < n; i++)
					ref[16 + a + i] = values[v];
				var r: void* = std::memset(&got[16 + a], values[v], n);
				expect(cast<i32>(3000 + n * 12 + a * 3 + v), same() and r == cast<void*>(&got[16 + a]));
			}
		}
	}
	return g_failures;
}
