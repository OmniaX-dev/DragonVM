// dr::memcpy / dr::memset (word loops) against byte loops: every size 0 - 37 at every alignment of
// the source and the destination, overlapping copies at distances -9 .. 9 (forward: the same bytes
// as a byte loop, also dst 1 - 3 bytes above src), the bytes around untouched, the return values.
// expect-rv: 0
#import(<dragon-sdk>)

var g_failures: i32 = 0;

sub expect(var id: i32, var ok: bool) {
	if (ok)
		return;
	var buff: u8[12];
	debug_print("sdk_memcpy: check ");
	debug_print(dr::itoa(id, buff));
	debug_print(" failed\n");
	g_failures++;
}

var ref: u8[128];
var got: u8[128];

sub fill_both() {
	for (var i: u32 = 0; i < 128; i++) {
		ref[i] = cast<u8>(i * 37 + 11);
		got[i] = ref[i];
	}
}

sub same() -> bool {
	for (var i: u32 = 0; i < 128; i++) {
		if (ref[i] != got[i])
			return false;
	}
	return true;
}

sub byte_copy(var d: u8*, var s: u8*, var n: u32) {
	for (var i: u32 = 0; i < n; i++)
		d[i] = s[i];
}

sub main() -> i32 {
	// Apart: source at 8 + sa, destination at 64 + da.
	for (var n: u32 = 0; n <= 37; n++) {
		for (var sa: u32 = 0; sa < 4; sa++) {
			for (var da: u32 = 0; da < 4; da++) {
				fill_both();
				byte_copy(&ref[64 + da], &ref[8 + sa], n);
				var r: void* = dr::memcpy(&got[64 + da], &got[8 + sa], n);
				expect(cast<i32>(1000 + n * 16 + sa * 4 + da), same() and r == cast<void*>(&got[64 + da]));
			}
		}
	}
	// Overlapping: destination = source + gap (gap -9 .. 9).
	for (var n: u32 = 0; n <= 20; n++) {
		for (var g: i32 = -9; g <= 9; g++) {
			fill_both();
			byte_copy(&ref[cast<u32>(40 + g)], &ref[40], n);
			dr::memcpy(&got[cast<u32>(40 + g)], &got[40], n);
			expect(cast<i32>(2000 + n * 20) + g + 9, same());
		}
	}
	// memset.
	var values: u8[3] = { 0x00, 0xA5, 0xFF };
	for (var n: u32 = 0; n <= 37; n++) {
		for (var a: u32 = 0; a < 4; a++) {
			for (var v: u32 = 0; v < 3; v++) {
				fill_both();
				for (var i: u32 = 0; i < n; i++)
					ref[16 + a + i] = values[v];
				var r: void* = dr::memset(&got[16 + a], values[v], n);
				expect(cast<i32>(3000 + n * 12 + a * 3 + v), same() and r == cast<void*>(&got[16 + a]));
			}
		}
	}
	return g_failures;
}
