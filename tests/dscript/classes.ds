// expect-rv: 0
// Classes: a struct that extends another class (or a struct) with ex, prot members, upcasts
// (a class pointer converts to a pointer to a class it extends), constructors (Base::new(...)
// as a statement; the base's constructor without arguments otherwise), Base::m() / Base.m() on
// this, inherited static subs, constants and static fields.
#include(check.ds)

var g_log: i32 = 0;

struct Pos { var x: i32; var y: i32; }

class Thing ex Pos {
	prot var weight: i32;
	var tag: i32 = 5;
	constexpr KIND = 3;
	static var made: i32 = 0;
	sub new() -> void { this->weight = 1; Thing::made++; g_log = g_log * 10 + 1; }
	sub new(var w: i32) -> void { this->weight = w; Thing::made++; g_log = g_log * 10 + 2; }
	sub heavier(var by: i32) -> void { this->weight += by; }
	readonly sub getWeight() -> i32 { return this->weight; }
	static sub make(var out: Thing*) -> void { out->new(9); }
}

class Box ex Thing {
	var size: i32;
	sub new(var size: i32) -> void { this->size = size; g_log = g_log * 10 + 3; }	// (Thing::new() first)
	sub heavier(var by: i32, var times: i32) -> void { Thing::heavier(by * times); }	// (an overload: Thing's stays)
	sub kind() -> i32 { return KIND * 10 + Box.KIND; }
	sub double() -> void { Thing.heavier(this->weight); }	// (Base.m(): on this)
}

class Crate ex Box {
	var lid: bool;
	sub new() -> void { g_log = g_log * 10 + 4; Box::new(7); this->lid = true; }	// (the base: explicit)
}

class Bare ex Thing { var extra: i32; }		// (no constructor: an implicit new() calls Thing::new())

sub weigh(var t: Thing*) -> i32 { return t->getWeight(); }
sub where(var p: Pos*) -> i32 { return p->x + p->y; }

sub main() -> i32 {
	var b: Box(4);
	check(1, g_log == 13 && b.size == 4 && b.getWeight() == 1 && b.tag == 5);
	b.x = 2;
	b.y = 3;
	check(2, where(&b) == 5 && weigh(&b) == 1);
	b.heavier(2);
	b.heavier(1, 3);
	check(3, b.getWeight() == 6);
	b.double();
	check(4, weigh(&b) == 12);
	check(5, b.kind() == 33 && Box.KIND == 3 && b.KIND == 3);
	g_log = 0;
	var c: Crate();
	check(6, g_log == 413 && c.size == 7 && c.lid);
	var t: Thing* = &c;
	check(7, t->getWeight() == 1);
	var p: Pos* = &c;
	p->x = 8;
	check(8, c.x == 8);
	g_log = 0;
	var bare: Bare();
	check(9, g_log == 1 && bare.getWeight() == 1);
	var made: Thing;
	Box.make(&made);		// (Thing's static sub, through Box)
	check(10, made.getWeight() == 9 && Thing::made == 4 && Box.made == 4 && c.made == 4);
	check(11, sizeof(Box) == sizeof(Pos) + 12 && sizeof(Crate) == sizeof(Box) + 1);
	var back: Box* = static_cast<Box*>(t);
	check(12, back == &c && back->size == 7);
	return result();
}
