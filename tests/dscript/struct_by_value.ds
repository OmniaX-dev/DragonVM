// Structs by value: parameters (each call gets a copy: the callee changes only its own) and
// results (also of inline subs, methods, sub pointers, variadic subs, recursion, templates, low
// blocks), a global initialized with a struct value, a result nobody uses, return before defer.
// expect-rv: 0
#import("libcore")
struct Point { var x: i32; var y: i32; };
struct Big { var a: u32[10]; var tag: u8; };
sub add(var a: Point, var b: Point) -> Point { var r: Point = { a.x + b.x, a.y + b.y }; return r; }
sub scale(var p: Point, var k: i32) -> Point { p.x *= k; p.y *= k; return p; }		// changes its own copy
inline sub swapped(var p: Point) -> Point { var t: i32 = p.x; p.x = p.y; p.y = t; return p; }
sub make_big(var tag: u8) -> Big { var b: Big; for (auto i in 0..10) b.a[i] = cast<u32>(i) * tag; b.tag = tag; return b; }
sub sum_big(var b: Big) -> u32 { var s: u32 = 0; for (auto v in b.a) s += v; return s + b.tag; }
sub origin() -> Point { var o: Point = { 0, 0 }; defer o.x = 99; return o; }		// the value before the defer
struct Vec { var p: Point; sub moved(var by: Point) -> Point { return add(this->p, by); } };
sub many(var a: Point, var n: i32, var b: Point, var m: u8) -> i32 { return a.x + b.y + n + m; }
sub va(var fmt: u32, ...) -> u32 { return va_count(); }
sub mk(var x: i32, var y: i32) -> Point { var p: Point = { x, y }; return p; }
// variadic + a struct result: the extra arguments after the hidden result and the parameters
sub sum_all(var count: u32, ...) -> Point {
	var p: Point = { 0, 0 };
	var args: std::VaList(va_start(), va_count());
	for (auto i in 0..va_count()) p.x += args.get_i32(i);
	p.y = cast<i32>(va_count());
	return p;
}
sub fib(var p: Point) -> Point {		// recursion: each call its own copies
	if (p.x <= 1) return p;
	var a = fib(mk(p.x - 1, 0));
	var b = fib(mk(p.x - 2, 0));
	return mk(a.x + b.x, p.y);
}
var g_origin: Point = add(mk(1, 2), mk(3, 4));		// in __ds_init
template(T) {
	sub twice(var v: T) -> T { return add(v, v); }
}
sub low_x(var p: Point) -> i32 { var r: i32 = 0; low { mov R1, &$p
	movo R2, *R1, dword 0x00000000
	mov $r, R2 } return r; }
sub main2() -> i32 {
	var s = sum_all(3, 10, 20, 30);
	if (s.x != 60 or s.y != 3) return 1;
	if (fib(mk(10, 7)).x != 55 or fib(mk(10, 7)).y != 7) return 2;
	if (g_origin.x != 4 or g_origin.y != 6) return 3;
	mk(1, 1);										// a result nobody uses
	var t = twice(mk(5, 6));
	if (t.x != 10 or t.y != 12) return 4;
	if (low_x(mk(42, 0)) != 42) return 5;
	return 0;
}
sub main() -> i32 {
	var a: Point = { 1, 2 };
	var b: Point = { 10, 20 };
	var c: Point = add(a, b);
	if (c.x != 11 or c.y != 22) return 1;
	var d = scale(a, 3);					// auto: a Point
	if (d.x != 3 or d.y != 6 or a.x != 1) return 2;	// a unchanged
	if (swapped(a).x != 2 or add(a, add(a, b)).y != 24) return 3;
	if (sum_big(make_big(2)) != 90 + 2) return 4;
	var o = origin();
	if (o.x != 0) return 5;
	var v: Vec; v.p = a;
	if (v.moved(b).x != 11) return 6;
	if (many(a, 100, b, 7) != 1 + 20 + 100 + 7) return 7;
	var f: sub(Point, Point) -> Point = add;	// through a sub pointer
	if (f(a, b).y != 22) return 8;
	c = add(c, c);
	if (c.x != 22) return 9;
	if (va(1, 2, 3) != 2) return 10;
	return main2();
}
