// std::data::ASCII (ascii.ds): the 256 characters of CP437 by name (1..31 and 127 also by their pictures).
// expect-rv: 0
#include(check.ds)
#import("dragon-sdk")

sub main() -> i32 {
	check(1, std::data::ASCII.Null == 0 and std::data::ASCII.StartOfHeading == 1 and std::data::ASCII.Escape == 27 and std::data::ASCII.UnitSeparator == 31);
	check(2, std::data::ASCII.Space == ' ' and std::data::ASCII.Digit0 == '0' and std::data::ASCII.Digit9 == '9' and std::data::ASCII.Tilde == '~');
	check(3, std::data::ASCII.A == 'A' and std::data::ASCII.Z == 'Z' and std::data::ASCII.a == 'a' and std::data::ASCII.z == 'z' and std::data::ASCII.Backslash == '\\');
	check(4, std::data::ASCII.Delete == 0x7F and std::data::ASCII.CCedilla == 0x80 and std::data::ASCII.BoxDoubleDownRight == 0xC9);
	check(5, std::data::ASCII.FullBlock == 0xDB and std::data::ASCII.alpha == 0xE0 and std::data::ASCII.Sigma == 0xE4 and std::data::ASCII.sigma == 0xE5);
	check(6, std::data::ASCII.NoBreakSpace == 0xFF and sizeof(std::data::ASCII) == 288);
	var row: u8[4] = { std::data::ASCII.BoxDoubleDownRight, std::data::ASCII.BoxDoubleHorizontal, std::data::ASCII.BoxDoubleDownLeft, 0 };
	check(7, row[1] == 0xCD);
	check(8, std::data::ASCII.Smiley == 1 and std::data::ASCII.ArrowLeft == std::data::ASCII.Escape and std::data::ASCII.TriangleDown == 0x1F and std::data::ASCII.House == std::data::ASCII.Delete);
	return result();
}
