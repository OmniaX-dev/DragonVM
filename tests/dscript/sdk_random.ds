// The random device (its registers, read directly): dr::random_get_next_int() in 0..INT32_MAX,
// next_float() in [0, 1), and seed(): the same seed gives the same numbers after it;
// random_get_entropy(): 32 bits of the host's entropy, not affected by the seed.
// drun-flags: --boot
// expect-rv: 0
#include(check.ds)
#import("dragon-sdk")

sub main() -> i32 {
	var differ: bool = false;
	var inRange: bool = true;
	var last: i32 = dr::random_get_next_int();
	var i: i32 = 0;
	while (i < 200)
	{
		var n: i32 = dr::random_get_next_int();
		if (n < 0)
			inRange = false;
		if (n != last)
			differ = true;
		last = n;
		var f: f32 = dr::random_get_next_float();
		if (f < 0.0 or f >= 1.0)
			inRange = false;
		i++;
	}
	check(1, inRange);
	check(2, differ);

	dr::random_set_seed(1234);
	var a1: i32 = dr::random_get_next_int();
	var a2: i32 = dr::random_get_next_int();
	var af: f32 = dr::random_get_next_float();
	dr::random_set_seed(1234);
	check(3, dr::random_get_next_int() == a1 and dr::random_get_next_int() == a2 and dr::random_get_next_float() == af);
	check(4, *cast<u32*>(dr::RandomRegisters.Seed) == 1234);
	dr::random_set_seed(99);
	check(5, dr::random_get_next_int() != a1 or dr::random_get_next_int() != a2);

	// Entropy: new bits at every read (the seed doesn't repeat them), all of them used.
	dr::random_set_seed(1234);
	var e1: u32 = dr::random_get_entropy();
	dr::random_set_seed(1234);
	var e2: u32 = dr::random_get_entropy();
	check(6, e1 != e2);
	var ones: u32 = 0;
	var zeros: u32 = 0;
	for (auto k in 0..64) {
		const e = dr::random_get_entropy();
		ones |= e;
		zeros |= ~e;
	}
	check(7, ones == 0xFFFFFFFF and zeros == 0xFFFFFFFF);		// (every bit was 1 and 0 at least once)
	return result();
}
