// Templates from a library (its interface carries them as source): struct and method
// templates, where, optional parameters; the library and the program have their own instances.
// dsc-lib: libs/tpl_lib.ds
// expect-rv: 0
#import("tpl_lib")
sub main() -> i32 {
	var s: tl::Stack<i32>;
	s.count = 0;
	s.push(5); s.push(-2); s.push(10);
	if (s.sum_as<i32>() != 13) return 1;
	if (s.pop() != 10) return 2;
	if (tl::clamp(15, 0, 10) != 10 or tl::clamp<u8>(3, 5, 9) != 5) return 3;
	if (tl::tag<u32>() != 4 or tl::tag<u32, u16>() != 6) return 4;
	if (tl::library_uses() != 7) return 5;
	var b: tl::Stack<u8>;					// the same instance as the library's: the program has its own
	b.count = 0;
	b.push(1);
	return cast<i32>(b.pop()) - 1;
}
