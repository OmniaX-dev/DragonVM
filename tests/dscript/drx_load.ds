// dr::drx::load / run: a DRX (embedded below, built without the SDK) loaded at different places,
// also overlapping the file (in place: at or below the image in the file), relocated and run.
// The child (dsc child.ds -o child.drx) returns 2 * 6 + 'e' = 113, + argv[1][0] with 2 arguments:
//   var g: u32 = 5;
//   const msg: string = "hello";
//   sub twice(var x: u32) -> u32 { return x * 2; }
//   var fp: sub(u32) -> u32 = twice;
//   sub main(var argc: i32, var argv: string*) -> i32 {
//       g += 1;
//       var r: i32 = cast<i32>(fp(g));
//       r += cast<i32>(msg[1]);
//       if (argc == 2) r += cast<i32>(argv[1][0]);
//       return r;
//   }
// expect-rv: 0
#import(<dragon-sdk>)

var g_failures: i32 = 0;

sub expect(var id: i32, var ok: bool) {
	if (ok)
		return;
	var buff: u8[12];
	debug_print("drx_load: check ");
	debug_print(dr::itoa(id, buff));
	debug_print(" failed\n");
	g_failures++;
}

const Child: u8[] = {
	0x44, 0x52, 0x58, 0x31, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00, 0x01, 0x23, 0x00, 0x00, 0x00, 0x00,
	0x00, 0x00, 0x00, 0x0B, 0x00, 0x00, 0x01, 0x43, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
	0x7C, 0x00, 0x00, 0x00, 0x13, 0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00, 0x00, 0x68, 0x65, 0x6C,
	0x6C, 0x6F, 0x00, 0x50, 0x00, 0x00, 0x00, 0x00, 0x53, 0x00, 0x00, 0x00, 0x57, 0x10, 0x0A, 0x00,
	0x00, 0x00, 0x00, 0x10, 0x0B, 0x00, 0x00, 0x00, 0x00, 0x11, 0x0C, 0x04, 0x11, 0x06, 0x0C, 0x72,
	0x00, 0x00, 0x00, 0x48, 0x00, 0x00, 0x00, 0x00, 0xE0, 0x56, 0x0A, 0x04, 0x00, 0x00, 0x00, 0x00,
	0xE0, 0x56, 0x0B, 0x04, 0xFF, 0xFF, 0xFF, 0xFC, 0x51, 0x0A, 0x51, 0x0B, 0x50, 0x00, 0x00, 0x00,
	0x02, 0x53, 0x00, 0x00, 0x00, 0x7A, 0x55, 0x10, 0x0A, 0x00, 0x00, 0x00, 0x67, 0x10, 0x0B, 0x00,
	0x00, 0x00, 0x09, 0x18, 0x0B, 0x0A, 0x55, 0xE0, 0x56, 0x0A, 0x04, 0x00, 0x00, 0x00, 0x00, 0xE1,
	0x25, 0x0A, 0x00, 0x00, 0x00, 0x02, 0x11, 0x03, 0x0A, 0x55, 0x11, 0x1A, 0x01, 0xE1, 0x23, 0x1A,
	0x00, 0x00, 0x00, 0x04, 0x11, 0x01, 0x1A, 0x10, 0x0A, 0x00, 0x00, 0x00, 0x05, 0x15, 0x0B, 0x0A,
	0xE1, 0x21, 0x0B, 0x00, 0x00, 0x00, 0x01, 0x18, 0x0A, 0x0B, 0x11, 0x0A, 0x0B, 0x11, 0x0A, 0x02,
	0x13, 0x0B, 0x00, 0x00, 0x00, 0x09, 0x13, 0x0C, 0x00, 0x00, 0x00, 0x05, 0x51, 0x0C, 0x50, 0x00,
	0x00, 0x00, 0x01, 0x54, 0x0B, 0x11, 0x0B, 0x03, 0x11, 0x0C, 0x0A, 0x18, 0x0C, 0x0B, 0x11, 0x0A,
	0x02, 0x15, 0x0B, 0x0A, 0x10, 0x0C, 0x00, 0x00, 0x00, 0x0D, 0xE1, 0x21, 0x0C, 0x00, 0x00, 0x00,
	0x01, 0x28, 0x0C, 0x0C, 0xE1, 0x20, 0x0B, 0x0C, 0x18, 0x0A, 0x0B, 0x11, 0x0A, 0x0B, 0xE0, 0x56,
	0x0A, 0x04, 0x00, 0x00, 0x00, 0x00, 0x11, 0x06, 0x0A, 0x70, 0x00, 0x00, 0x01, 0x17, 0x00, 0x00,
	0x00, 0x02, 0x11, 0x0A, 0x02, 0x15, 0x0B, 0x0A, 0xE0, 0x56, 0x0C, 0x04, 0xFF, 0xFF, 0xFF, 0xFC,
	0xE1, 0x21, 0x0C, 0x00, 0x00, 0x00, 0x04, 0x15, 0x0C, 0x0C, 0x28, 0x0C, 0x0C, 0xE1, 0x20, 0x0B,
	0x0C, 0x18, 0x0A, 0x0B, 0x11, 0x0A, 0x0B, 0xE0, 0x56, 0x0A, 0x02, 0x00, 0x00, 0x00, 0x00, 0x11,
	0x03, 0x0A, 0x55, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x19, 0x00, 0x00, 0x00, 0x30, 0x00,
	0x00, 0x00, 0x52, 0x00, 0x00, 0x00, 0x59, 0x00, 0x00, 0x00, 0x5F, 0x00, 0x00, 0x00, 0x89, 0x00,
	0x00, 0x00, 0xA2, 0x00, 0x00, 0x00, 0xA8, 0x00, 0x00, 0x00, 0xC6, 0x00, 0x00, 0x00, 0xEA
};

var area: u8[2048];

// The file at area + at; then loaded to area + to.
sub load_at(var at: u32, var to: u32, var entry: u32*) -> i32 {
	dr::memcpy(&area[at], Child, sizeof(Child));
	return dr::drx::load(&area[at], sizeof(Child), &area[to], 1024, entry);
}

sub main() -> i32 {
	var entry: u32 = 0;
	var argv: string[3];
	argv[0] = "child";
	argv[1] = "A";
	argv[2] = null;
	// Apart.
	expect(1, load_at(1024, 0, &entry) == 0 and entry == cast<u32>(&area[0]));
	expect(2, dr::drx::run(entry) == 113);
	// In place: the file read where the program goes.
	expect(3, load_at(512, 512, &entry) == 0 and entry == cast<u32>(&area[512]));
	expect(4, dr::drx::run(entry, 2, argv) == 178);
	// Overlapping, below the file; at the image's own place in the file.
	expect(5, load_at(512, 412, &entry) == 0 and dr::drx::run(entry) == 113);
	expect(6, load_at(512, 512 + 32, &entry) == 0 and dr::drx::run(entry) == 113);
	// Past the image's start in the file: refused, the destination untouched.
	expect(7, load_at(512, 512 + 33, &entry) == dr::drx::Errors.Overlap);
	expect(8, dr::memcmp(&area[512], Child, sizeof(Child)) == 0);
	// A relocation table the image would cover (moved into the image): refused in place, fine apart.
	dr::memcpy(&area[512], Child, sizeof(Child));
	area[512 + 0x14] = 0; area[512 + 0x15] = 0; area[512 + 0x16] = 0; area[512 + 0x17] = 100;
	expect(9, dr::drx::load(&area[512], sizeof(Child), &area[512], 1024, &entry) == dr::drx::Errors.Overlap);
	// A relocation past the image (the last word starts at image size - 4 = 287), also one that is
	// negative as an i32: refused, the destination untouched.
	dr::memcpy(&area[1024], Child, sizeof(Child));
	area[1024 + 323] = 0; area[1024 + 324] = 0; area[1024 + 325] = 0x01; area[1024 + 326] = 0x20;	// 288
	area[0] = 0x5A;
	expect(10, dr::drx::load(&area[1024], sizeof(Child), &area[0], 1024, &entry) == dr::drx::Errors.RelocationOutOfRange and area[0] == 0x5A);
	area[1024 + 323] = 0xFF; area[1024 + 324] = 0xFF; area[1024 + 325] = 0xFF; area[1024 + 326] = 0xF0;
	expect(11, dr::drx::load(&area[1024], sizeof(Child), &area[0], 1024, &entry) == dr::drx::Errors.RelocationOutOfRange and area[0] == 0x5A);
	area[1024 + 325] = 0x01; area[1024 + 326] = 0x1F;		// 287: the last word, fine
	area[1024 + 323] = 0; area[1024 + 324] = 0;
	expect(12, dr::drx::load(&area[1024], sizeof(Child), &area[0], 1024, &entry) == 0);
	return g_failures;
}
