// expect-rv: 0
#include(check.ds)

sub main() -> i32 {
    var a: i32 = 17;
    var b: i32 = -5;
    check(1, a + b == 12);
    check(2, a - b == 22);
    check(3, a * b == -85);
    check(4, a / b == -3);
    check(5, a % b == 2);
    check(6, b / 2 == -2);
    check(7, -a == -17);
    check(8, (a & 3) == 1);
    check(9, (a | 8) == 25);
    check(10, (a ^ 1) == 16);
    check(11, ~0 == -1);
    check(12, (1 << 31) < 0);
    check(13, (b >> 1) == -3);              // arithmetic shift
    var u: u32 = 0xF0000000;
    check(14, (u >> 4) == 0x0F000000);      // logical shift (constant)
    var n: i32 = 8;
    check(15, (u >> n) == 0x00F00000);      // logical shift (runtime helper)
    check(16, u > 5);                       // unsigned comparison
    check(17, cast<i32>(u) < 5);            // signed comparison
    check(18, u / 16 == 0x0F000000);        // unsigned division
    var big: u32 = 0xFFFFFFFF;
    check(19, big % 10 == 5);
    // Small types wrap and extend.
    var c: u8 = 250;
    c = c + 10;
    check(20, c == 4);
    var s: i8 = 127;
    s++;
    check(21, s == -128);
    check(22, cast<i32>(s) == -128);
    var w: i16 = -2;
    var uw: u16 = cast<u16>(w);
    check(23, uw == 65534);
    check(24, cast<i16>(uw) == -2);
    var x: u8 = 200;
    var y: i32 = x;                         // zero-extended
    check(25, y == 200);
    var z: i8 = cast<i8>(x);                // sign-extended
    check(26, z == -56);
    // Compound assignments.
    var k: i32 = 10;
    k += 5; check(27, k == 15);
    k -= 3; check(28, k == 12);
    k *= 2; check(29, k == 24);
    k /= 5; check(30, k == 4);
    k %= 3; check(31, k == 1);
    k <<= 4; check(32, k == 16);
    k >>= 2; check(33, k == 4);
    k |= 3; check(34, k == 7);
    k &= 5; check(35, k == 5);
    k ^= 1; check(36, k == 4);
    var cu: u32 = 0x80000000;
    cu >>= n;
    check(37, cu == 0x00800000);
    // ++ / --
    var i: i32 = 5;
    check(38, i++ == 5);
    check(39, i == 6);
    check(40, ++i == 7);
    check(41, i-- == 7);
    check(42, --i == 5);
    // Constants are folded (and still right).
    check(43, (3 + 4) * 2 == 14);
    check(44, 0xFFFFFFFF == cast<u32>(-1));
    check(45, 'A' == 65);
    check(46, sizeof(i16) == 2 && sizeof<u8*> == 4);
    return result();
}
