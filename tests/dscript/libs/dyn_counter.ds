// A shared library (dynamic_linking.ds): writable globals of every kind, a constant array, a
// string, a static local, a low block using a global. Compiled as a .dlib and as a .drl.
namespace dc {
	var counter: u32 = 5;
	var table: u32[4] = { 1, 2, 3, 4 };
	const primes: u32[4] = { 2, 3, 5, 7 };
	var name: string = "counter";
	var small: u8 = 200;
	var signed16: i16 = -300;
	struct Point { var x: i32; var y: i32; };
	var origin: Point = { 10, -20 };
	var computed: u32 = later();			// initialized by the library's init, at run time

	sub later() -> u32 { return 40 + 2; }
	sub bump(var by: u32) -> u32 { counter += by; return counter; }
	sub calls() -> u32 { static var n: u32 = 0; n++; return n; }
	sub sum_table() -> u32 { var s: u32 = 0; for (var i: u32 = 0; i < 4; i++) s += table[i] + primes[i]; return s; }
	sub name_length() -> u32 { var n: u32 = 0; while (name[n] != 0) n++; return n; }
	sub counter_address() -> u32* { return &counter; }
	sub move_origin(var dx: i32) { origin.x += dx; origin.y -= dx; }
	// $counter in a low block: read, and written back (the first operand).
	sub low_read() -> u32 { var r: u32 = 0; low { mov R1, $counter
		mov $r, R1 } return r; }
	sub low_write(var v: u32) { low { mov R1, $v
		mov $counter, R1 } }
}
