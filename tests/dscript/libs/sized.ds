// A library with value templates (templates_values_library.ds): the template is in its interface (as written).
namespace sz {
	struct Limits { var lo: i32; var hi: i32; };
	constexpr PERCENT: Limits = { 0, 100 };
	template(T, N: u32 = 4) {
		struct Ring { var items: T[N]; var count: u32; readonly sub capacity() -> u32 { return N; } };
		static_assert(N >= 2, "a ring holds at least two items");
	}
	template(L: Limits) { sub clamp(var v: i32) -> i32 { return v < L.lo ? L.lo : (v > L.hi ? L.hi : v); } }
	if constexpr (sizeof(Limits) == 8) { sub limits_size() -> u32 { return 8; } }
	// (a low block in a template: the interface writes it back as source)
	template(T) { sub bits_of(var v: T) -> u32 { var r: u32; low { mov $r, $v } return r; } }
}
