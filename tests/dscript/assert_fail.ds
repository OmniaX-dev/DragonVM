// A false assert prints where it is and what failed, then stops the machine.
// expect-output: Assertion failed: x * 2 == 7 (assert_fail.ds:9): math is broken\n
#include(<assert.ds>)
#include(<bios.ds>)

sub main() -> i32 {
	var x: i32 = 3;
	assert(x > 0);
	assert(x * 2 == 7, "math is broken");
	TextSingle::println("not reached");
	return 0;
}
