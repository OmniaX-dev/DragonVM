// A false assert prints where it is and what failed, then stops the machine.
// expect-output: Assertion failed: x * 2 == 7 (assert_fail.ds:13): math is broken\n
#import("dragon-sdk")

// The libraries don't define __assert_fail: the program does (here, the SDK's halt).
sub __assert_fail(var file: string, var line: u32, var condition: string, var message: string) {
	dr::assert_fail_halt(file, line, condition, message);
}

sub main() -> i32 {
	var x: i32 = 3;
	assert(x > 0);
	assert(x * 2 == 7, "math is broken");
	dr::TextSingle::println("not reached");
	return 0;
}
