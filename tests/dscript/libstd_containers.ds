// expect-rv: 0
// libstd's names for libcore's containers (std::Vector, Stack, Map, HashMap, String: malloc /
// free): they compile, and are the Basic ones with std::MallocAllocator. (Used in a branch that
// doesn't run: malloc asks a kernel for pages; the containers themselves are tested with an
// allocator of their own in container_*.ds.)
#import("libstd")
var g_never: bool = false;
sub main() -> i32 {
	static_assert(is_type(std::Vector<u32>, std::BasicVector<u32, std::MallocAllocator>));
	static_assert(is_type(std::String, std::BasicString<std::MallocAllocator>));
	static_assert(is_type(std::Map<std::String, u32>, std::BasicMap<std::String, u32, std::MallocAllocator>));
	if (g_never) {
		var v: std::Vector<std::String>;
		v.push("a");
		var s: std::String = v.pop();
		s.appendf("{}", 1);
		var st: std::Stack<u32>;
		st.push(1);
		st.pop();
		var m: std::Map<std::String, u32>;
		m.set(s, 1);
		m.get("a");
		var h: std::HashMap<u32, std::String>;
		h.set(1, "x");
		for (const ref e in h)
			std::print(e.value);
		for (const ref e in m)
			std::print(e.key);
	}
	return 0;
}
