// expect-output: Hello, DragonOS!\n-42 / 4294967295 / x
#import(<dragon-sdk>)

sub main() -> void {
    dr::TextSingle::println("Hello, DragonOS!");
    dr::TextSingle::print(-42);
    dr::TextSingle::print(" / ");
    dr::TextSingle::print(cast<u32>(0xFFFFFFFF));
    dr::TextSingle::print(" / ");
    dr::TextSingle::print('x');
}
