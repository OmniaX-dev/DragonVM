// std::utoa: unsigned integers, in any base from 2 to 36.
// expect-rv: 0
#include(check.ds)
#import("dragon-sdk")

sub main() -> i32 {
	var b: u8[33];
	check(1, std::strcmp(std::utoa(0, b), "0") == 0);
	check(2, std::strcmp(std::utoa(4294967295, b), "4294967295") == 0);
	check(3, std::strcmp(std::utoa(0xFFFFFFFF, b, 16), "ffffffff") == 0);
	check(4, std::strcmp(std::utoa(0xFFFFFFFF, b, 2), "11111111111111111111111111111111") == 0);
	check(5, std::strcmp(std::utoa(35, b, 36), "z") == 0);
	check(6, std::strcmp(std::utoa(10, b, 1), "") == 0);
	check(7, std::strcmp(std::utoa(10, b, 37), "") == 0);
	return result();
}
