// std::math (libcore's math.ds) and ftoa / print(f32): the FPU functions through the SDK, the integer
// overloads of min / max / abs / clamp, the constants, and the text of floats.
// drun-flags: --boot
// expect-output: 3.141593|-2.50|0.000|-0.000000|inf|-inf|nan|1.234568e+12|100|0.100000000|7|3.5
#import("dragon-sdk")

var g_failures: i32 = 0;

sub expect(var id: i32, var ok: bool) {
	if (ok)
		return;
	var buff: u8[12];
	debug_print("sdk_math: check ");
	debug_print(std::itoa(id, buff));
	debug_print(" failed\n");
	g_failures++;
}

sub near(var a: f32, var b: f32) -> bool {
	return std::math::abs(a - b) < 1e-5;
}

sub main() -> i32 {
	expect(1, std::math::f32_bits(std::math::sqrt(16)) == std::math::f32_bits(4.0) and std::math::is_nan(std::math::sqrt(-1)));
	expect(2, std::math::floor(-1.5) == -2 and std::math::ceil(-1.5) == -1 and std::math::round(2.5) == 3 and std::math::trunc(-2.7) == -2);
	expect(3, std::math::abs(-3.25) == 3.25 and std::math::abs(-7) == 7);
	expect(4, near(std::math::sin(std::math::HALF_PI), 1) and near(std::math::cos(std::math::PI), -1) and near(std::math::tan(0), 0));
	expect(5, near(std::math::exp(1), std::math::E) and near(std::math::log(std::math::E), 1) and near(std::math::log2(8), 3) and near(std::math::log10(1000), 3));
	expect(6, std::math::pow(2, 10) == 1024 and near(std::math::atan2(1, 1), std::math::PI / 4) and near(std::math::atan(1), std::math::PI / 4));
	expect(7, near(std::math::asin(1), std::math::HALF_PI) and near(std::math::acos(1), 0) and near(std::math::fmod(7.5, 2), 1.5));
	expect(8, std::math::min(1.5, -2) == -2 and std::math::max(1.5, -2) == 1.5 and std::math::min(3, 4) == 3 and std::math::max(cast<u32>(3), cast<u32>(4)) == 4);
	expect(9, std::math::clamp(5.5, 0, 1) == 1 and std::math::clamp(-3, 0, 10) == 0 and std::math::lerp(2, 4, 0.25) == 2.5);
	expect(10, std::math::is_inf(std::math::INFINITY) and std::math::is_inf(-std::math::INFINITY) and not std::math::is_finite(std::math::NAN) and std::math::is_finite(std::math::F32_MAX));
	expect(11, std::math::f32_from_bits(0x3F800000) == 1 and std::math::f32_bits(1.0 + std::math::F32_EPSILON) == 0x3F800001);

	dr::TextSingle::print(std::math::PI);
	dr::TextSingle::print("|");
	dr::TextSingle::print(-2.5, 2);
	dr::TextSingle::print("|");
	dr::TextSingle::print(0.0004, 3);
	dr::TextSingle::print("|");
	dr::TextSingle::print(-0.0);
	dr::TextSingle::print("|");
	dr::TextSingle::print(std::math::INFINITY);
	dr::TextSingle::print("|");
	dr::TextSingle::print(-std::math::INFINITY);
	dr::TextSingle::print("|");
	dr::TextSingle::print(std::math::NAN);
	dr::TextSingle::print("|");
	dr::TextSingle::print(1234567890123.0);
	dr::TextSingle::print("|");
	dr::TextSingle::print(99.9999, 0);
	dr::TextSingle::print("|");
	dr::TextSingle::print(0.1, 9);
	dr::TextSingle::print("|");
	dr::TextSingle::print(7);						// still the integer overload
	dr::TextSingle::print("|");
	var buff: u8[24];
	dr::TextSingle::print(std::ftoa(3.5, buff, 1));
	return g_failures;
}
