#once

struct Point {
	var x: i32;
	var y: i32 = 7;
	sub sum(var extra: i32) -> i32 { return this->x + this->y + extra; }
};

enum Color { Red, Green = 5, Blue }

const ORIGIN_X = 0x10;
const GREETING = "hello";

sub area(var w: i32, var h: i32 = 2) -> i32 {
	return w * h;
}

struct Geo {
	static sub twice(var v: i32) -> i32 { return v * 2; }
};
