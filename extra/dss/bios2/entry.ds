#include(data.ds)
#include(<bios.ds>)
#include(<dpt.ds>)
#include(int20.ds)
#include(int30.ds)

sub main() {
	*cast<u8*>(VGARegisters.VideoMode) = VGAVideoModes.TextSingleColor;
	low { sflg $CPUFlags.InterruptsEnabled }
	__int20_set_interrupt_vector_entry(0x20, cast<u32>(&__int_20_handler));
	__int20_set_interrupt_vector_entry(0x30, cast<u32>(&__int_30_handler));

	__print_machine_info();
	__load_mbr_data_block();

	// Exit BIOS mode
	low {
		%low $INST_BIOS_NODE_TOGGLE 0x00
		jmp $MemoryLayout.MBR
	}
}

sub __load_mbr_data_block() {
	var disk: u8 = *cast<u8*>(CMOSRegisters.BootDisk);
	var ddd: DiskDriverData;
	ddd.mode = DiskMode.Read;
	ddd.disk = disk;
	ddd.address = 0x00000000;
	ddd.dataSize = 512;
	ddd.memoryAddress = MemoryLayout.MBR;
	low {
		mov R10, $INT20_LOAD_FROM_DDD_BLOCKING
		mov R9, $ddd
		int 0x20
	}
}

sub __print_machine_info() {
	for (var i: u32 = 0; i < sizeof(BiosLogo) / sizeof(BiosLogo[0]); i++) {
	    print(BiosLogo[i]);
	    new_line();
	}
	// TODO: Add back the info
}
