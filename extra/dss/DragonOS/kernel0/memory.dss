@guard _MEMORY_DSS_

@define _REG_OFFSET 0x09
@define _REG_S1 0x07
@define _REG_S2 0x08

## The RAM starts at 0x01010000 (CMOS_Settings.MEM_START) and its last address is in
## CMOS_Settings.MEM_SIZE; the stack grows down from the end of the RAM
## (CMOS_Settings.STACK_SIZE bytes).
@define _USABLE_MEM_START 0x01020000
@define _MEM_TABLE_ADDR 0x01014000

.code

_init_memory_handler:
	nop
	ret
