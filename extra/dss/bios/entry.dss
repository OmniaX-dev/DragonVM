.load 0x00000000       															## BIOS is mapped to address 0x00000000 in memory
.entry _bios_entry_point
.fixed 16777216, 0xFF  ## BIOS Needs to be 16 MiB (16777216 Bytes) exactly

@include <data.dss>
@include <utils.dss>
@include <drivers.dss>
@include <display.dss>

## ============================= BIOS Program =============================
.code
_bios_entry_point:
	movb [VGA_Registers.VIDEO_MODE], VGA_VideoModes.TEXT_SINGLE_COLOR			## Enable Text_Single_Color graphics mode
	mov FL, 0b00000000000000000000000000000001									## Zero the FL Register and enable interrupts
	mov reg(S_REG_OFFSET), 0x00000000											## Zero the offset register
	movb [{MemoryAddresses.INT_VEC + (0x20 * IntVector.ENTRY_SIZE)}], 0xFF 		## Setting up int 0x20 handler
	mov [{MemoryAddresses.INT_VEC + (0x20 * IntVector.ENTRY_SIZE) + 1}], $_int_20_handler	## --

	mov R10, 0x00																## Setting up int 0x30 handler by using int 0x20 functionality
	mov R9, $_int_30_handler													##  -Passing the handler's address
	mov R8, 0x30																##  -Passing the interrupt's code to setup
	int 0x20																	##  -Calling int 0x20 with 0x00 as parameter, to set new handler up

	movb [{MemoryAddresses.DISK_INTERFACE + DiskRegisters.MODE_SELECTOR}], DiskMode.READ			## Mode = Read
	movb R1, [CMOS_Settings.BOOT_DISK]
	movb [{MemoryAddresses.DISK_INTERFACE + DiskRegisters.DISK_SELECTOR}], R1						## Disk = Default
	mov  [{MemoryAddresses.DISK_INTERFACE + DiskRegisters.DISK_ADDRESS}], 0x20C000
	mov  [{MemoryAddresses.DISK_INTERFACE + DiskRegisters.DATA_SIZE}], 5566
	mov  [{MemoryAddresses.DISK_INTERFACE + DiskRegisters.MEMORY_ADDRESS}], 0x01020000
	movb [{MemoryAddresses.DISK_INTERFACE + DiskRegisters.SIGNAL}], DiskSignals.START				## Signal = Start
_test_wait_loop:
	movb ACC, [{MemoryAddresses.DISK_INTERFACE + DiskRegisters.RO_STATUS}]						## Moving <Status> register into ACC
	jne $_test_wait_loop, DiskStatus.FREE
	jmp 0x01020000

	push 0
	call $_print_machine_info_signle_color										## Print BIOS logo and machine info

	## MBR Loading
	zflg Flags.InterruptsEnabled												## Disable interrupts
	push 0
	call $_load_mbr_data_block
	sflg Flags.InterruptsEnabled												## Enable interrupts
	## ----

	%low INST_BIOS_NODE_TOGGLE 0x00												## Disable BIOS Mode before leaving the BIOS
	jmp MemoryAddresses.MBR         											## Jump to start of MBR in memory
	hlt                															## Just in case somehow execution reaches this point
## ========================================================================
