// ringbuffer.ds - a FIFO ring buffer of fixed-size elements.
//
// The buffer does not allocate: the caller gives it the storage (any array), the size of one
// element and the capacity in elements, which must be a power of two (the indices are masked
// instead of taken modulo).
//
//     var storage: Event[64];
//     var rb: RingBuffer;
//     rb.init(&storage[0], sizeof(Event), 64);
//     rb.push(&ev);              // false if full
//     rb.pop(&ev);               // false if empty
//
// head and tail are free-running counters: they are never wrapped, only masked when a slot is
// addressed, so size = head - tail (correct across the u32 overflow too) and all 'capacity'
// slots are usable (no empty slot is needed to tell full from empty).
//
// One producer and one consumer (e.g. an interrupt sub pushing, main popping) can share a
// buffer without disabling interrupts: push only writes head (after the element is copied),
// pop only writes tail (after the element is read). push_overwrite and clear write both, so
// they are not safe in that setup.

#once

struct RingBuffer {
    priv var data: u8*;
    priv var elem_size: u32;
    priv var mask: u32;         // capacity - 1
    priv var head: u32;         // count of elements pushed (next write)
    priv var tail: u32;         // count of elements popped (next read)

    // storage must hold capacity * elem_size bytes; capacity: a power of two, at most 2^31.
    // Returns false (and leaves the buffer unusable) if the arguments are invalid.
    sub init(var storage: void*, var elem_size: u32, var capacity: u32) -> bool {
        if (storage == null || elem_size == 0) { return false; }
        if (capacity == 0 || capacity > 0x8000_0000 || (capacity & (capacity - 1)) != 0) {
            return false;
        }
        this->data = storage;
        this->elem_size = elem_size;
        this->mask = capacity - 1;
        this->head = 0;
        this->tail = 0;
        return true;
    }

    sub capacity() -> u32 { return this->mask + 1; }
    sub size() -> u32 { return this->head - this->tail; }
    sub is_empty() -> bool { return this->head == this->tail; }
    sub is_full() -> bool { return this->head - this->tail == this->mask + 1; }
    sub clear() { this->tail = this->head; }

    // Copies the element at 'item' in. false if the buffer is full (nothing is written).
    sub push(var item: void*) -> bool {
        if (this->is_full()) { return false; }
        RingBuffer.copy(this->slot(this->head), item, this->elem_size);
        this->head++;           // published only after the element is complete
        return true;
    }

    // Like push, but when full the oldest element is dropped to make room.
    // Returns true if an element was dropped.
    sub push_overwrite(var item: void*) -> bool {
        var dropped = false;
        if (this->is_full()) {
            this->tail++;
            dropped = true;
        }
        RingBuffer.copy(this->slot(this->head), item, this->elem_size);
        this->head++;
        return dropped;
    }

    // Copies the oldest element to 'out' and removes it. false if the buffer is empty.
    sub pop(var out: void*) -> bool {
        if (this->is_empty()) { return false; }
        RingBuffer.copy(out, this->slot(this->tail), this->elem_size);
        this->tail++;           // the slot is given back only after it was read
        return true;
    }

    // Copies the oldest element to 'out' without removing it. false if the buffer is empty.
    sub peek(var out: void*) -> bool {
        if (this->is_empty()) { return false; }
        RingBuffer.copy(out, this->slot(this->tail), this->elem_size);
        return true;
    }

    // Removes up to n of the oldest elements without reading them; returns how many.
    sub skip(var n: u32) -> u32 {
        var count = this->size();
        if (n < count) { count = n; }
        this->tail += count;
        return count;
    }

    // Pointer to the i-th oldest element (0 = the next pop), in place; null if i >= size().
    // Valid until that element is popped or overwritten.
    sub at(var i: u32) -> void* {
        if (i >= this->size()) { return null; }
        return this->slot(this->tail + i);
    }

    priv sub slot(var index: u32) -> u8* {
        return this->data + (index & this->mask) * this->elem_size;
    }

    priv static sub copy(var dst: u8*, var src: u8*, var n: u32) {
        for (var i: u32 = 0; i < n; i++) { dst[i] = src[i]; }
    }
};
