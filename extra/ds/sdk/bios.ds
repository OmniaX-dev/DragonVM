// DScript SDK: the BIOS text output (int 0x30, single color text mode).
// The BIOS must have run (it installs the interrupt handlers).
#once

#include(utils.ds)
#include(print.ds)
#include(hardware.ds)

struct BitField32 {
	priv var m_value: u32 = 0;

	inline sub set(var mask: u32) {
		this->m_value |= mask;
	}
	inline sub unset(var mask: u32) {
		this->m_value &= ~mask;
	}
	inline sub get(var mask: u32) -> bool {
		return (this->m_value & mask) == mask;
	}
};

struct VGAText16Cell {
	var character: u8;
	var foreground: u8;
	var background: u8;
	var x: u8;
	var y: u8;
};

struct DiskDriverData {
	var mode: u8;
	var disk: u8;
	var reserverd: u16;
	var address: u32;
	var dataSize: u32;
	var memoryAddress: u32;
};



const DebugProfilerTIme: struct {
	var Millis: u8 							= 0x00;
	var Secs: u8 							= 0x01;
	var Micros: u8							= 0x02;
	var Nanos: u8							= 0x03;
};


// ============================= Memory Mapped Devices and Registers =============================
const MemoryLayout: struct {
	var MBR: u32 							= 0x01000680;
	var InterruptVector: u32 				= 0x01000080;
	var DiskInterface: u32					= 0x01000880;
	var RAM: u32							= 0x01010000;
	var CMOS: u32							= 0x01000000;
	var VGA: u32							= 0x01000900;
	var Keyboard: u32						= 0x01000580;
};
const InterruptVectorData: struct {
	var EntrySize: u32						= 0x5;
};
const CMOSRegisters: struct {
	var MemoryStart: u32					= MemoryLayout.CMOS + 0x0000;
	var MemorySize: u32						= MemoryLayout.CMOS + 0x0004;
	var ClockSpeed: u32						= MemoryLayout.CMOS + 0x0008;
	var ScreenColumns: u32					= MemoryLayout.CMOS + 0x000C;
	var ScreenRows: u32						= MemoryLayout.CMOS + 0x0010;
	var StackSize: u32						= MemoryLayout.CMOS + 0x0014;
	var ScreenRedrawRate: u32				= MemoryLayout.CMOS + 0x0018;
	var BootDisk: u32						= MemoryLayout.CMOS + 0x0019;
	var DiskList: u32						= MemoryLayout.CMOS + 0x007C;
};
const CPUFlags: struct {
	var InterruptsEnabled: u32				= 0;
};
const HardwareInterrupts: struct {
	var DiskInterfaceFinished: u8			= 0x80;
	var KeyPressed: u8						= 0xA0;
	var KeyReleased: u8						= 0xA1;
	var TextEntered: u8						= 0xA2;

	var Text16ScreenRefreshed: u8			= 0xE0;
};
const VGARegisters: struct {
	var VideoMode: u32 						= MemoryLayout.VGA + 0x0000;
	var ClearColor: u32						= MemoryLayout.VGA + 0x0001;
	var Palette: u32						= MemoryLayout.VGA + 0x0002;
	var Signal: u32							= MemoryLayout.VGA + 0x0003;
	var TextSingleChar: u32					= MemoryLayout.VGA + 0x0004;
	var TextSingleInvert: u32				= MemoryLayout.VGA + 0x0005;
	var TextSingleStr: u32					= MemoryLayout.VGA + 0x0008;
	var Text16Str: u32						= MemoryLayout.VGA + 0x0030;
	var Text16Cell: u32						= MemoryLayout.VGA + 0x0034;
	var Flags: u32							= MemoryLayout.VGA + 0x007C;
	var MemoryControllerX: u32				= MemoryLayout.VGA + 0x0080;
	var MemoryControllerXByte: u32			= MemoryLayout.VGA + 0x0080 + 3;
	var MemoryControllerY: u32				= MemoryLayout.VGA + 0x0084;
	var MemoryControllerYByte: u32			= MemoryLayout.VGA + 0x0084 + 3;
	var MemoryControllerChar: u32			= MemoryLayout.VGA + 0x0088;
	var MemoryControllerBGCol: u32			= MemoryLayout.VGA + 0x0089;
	var MemoryControllerFGCol: u32			= MemoryLayout.VGA + 0x008A;
	var BufferStart: u32					= MemoryLayout.VGA + 0x00E0;
};
const KeyboardRegisters: struct {
	var ModifiersBitfield: u32				= MemoryLayout.Keyboard + 0x0000;
	var KeyCode: u32						= MemoryLayout.Keyboard + 0x0004;
};
const VGAVideoModes: struct {
	var TextSingleColor: u8					= 0x00;
	var Text16Color: u8						= 0x01;
};
const VGATextSingleColorSignals: struct {
	var Continue: u8 						= 0x00;
	var PrintChar: u8						= 0x02;
	var StoreChar: u8						= 0x03;
	var PrintFlushBuffer: u8				= 0x04;
	var FlushBuffer: u8						= 0x05;
	var PrintBuffer: u8						= 0x06;
	var PrintString: u8						= 0x07;
	var RefreshScreen: u8 					= 0xE0;
	var ClearScreen: u8 					= 0xE1;
	var RedrawScreen: u8 					= 0xE2;
};
const VGAText16ColorSignals: struct {
	var Continue: u8 						= 0x00;
	var SwapBuffer: u8						= 0x10;
	var WriteVRAM: u8						= 0x11;
	var Scroll: u8							= 0x12;
	var PrintString: u8						= 0x13;
	var ForceRefreshScreen: u8				= 0xE0;
	var ForceClearScreen: u8				= 0xE1;
	var ForceRedrawScreen: u8				= 0xE2;
};
const DiskMode: struct {
	var Read: u8 							= 0x00;
	var Write: u8 							= 0x01;
};
const DiskSignals: struct {
	var Start: u8 							= 0x00;
	var Cancel: u8 							= 0x01;
	var Ignore: u8 							= 0xFF;
};
const DiskStatus: struct {
	var Free: u8 							= 0x00;
	var Waiting: u8 						= 0x01;
	var Reading: u8 						= 0x02;
};
const DiskRegisters: struct {
	var Signal: u32 						= MemoryLayout.DiskInterface + 0x0000;
	var Mode: u32							= MemoryLayout.DiskInterface + 0x0001;
	var Disk: u32							= MemoryLayout.DiskInterface + 0x0002;
	var DiskAddress: u32					= MemoryLayout.DiskInterface + 0x0004;
	var DataSize: u32						= MemoryLayout.DiskInterface + 0x0008;
	var MemoryAddress: u32					= MemoryLayout.DiskInterface + 0x000C;
	var Status: u32							= MemoryLayout.DiskInterface + 0x0010;
	var CurrentDisk: u32					= MemoryLayout.DiskInterface + 0x0011;
	var CurrentDiskAddress: u32				= MemoryLayout.DiskInterface + 0x0014;
	var RemainingDataSize: u32				= MemoryLayout.DiskInterface + 0x0018;
	var CurrentMemoryAddress: u32			= MemoryLayout.DiskInterface + 0x001C;
	var BlockSize: u32						= MemoryLayout.DiskInterface + 0x0050;
};
// ===============================================================================================
