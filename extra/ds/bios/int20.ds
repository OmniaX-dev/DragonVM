#once

#import(<dragon-sdk>)

#include(allocator.ds)

interrupt sub __int_20_handler() {
	var code: u32;
	var param1: u32;
	var param2: u32;
	low {
		mov $code, R10
		mov $param1, R9
		mov $param2, R8
	}
	if (code == INT20_START_DISK_CONTROLLER)
	{
		var ddd: dr::DiskDriverData* = cast<dr::DiskDriverData*>(param1);
		__int20_load_from_ddd(ddd);
	}
	else if (code == INT20_GET_DISK_LIST)
	{
		// TODO: Implement
	}
	else if (code == INT20_LOAD_FROM_DDD_BLOCKING) // selector is a dr::DiskDriverData*
	{
		var ddd: dr::DiskDriverData* = cast<dr::DiskDriverData*>(param1);
		__int20_load_from_ddd(ddd, true);
	}
	else if (code == INT20_SET_NEW_INT_HANDLER)
	{
		if (param2 > 0xFF)
			return; // TODO: Eventually this should probably raise some kind of error/warning
		dr::set_interrupt_vector_entry(param2, cast<sub()>(param1));
	}
	else if (code == INT20_CLEAR_INT_HANDLER)
	{
		if (param1 > 0xFF)
			return; // TODO: Eventually this should probably raise some kind of error/warning
		dr::clear_interrupt_vector_entry(param1);
	}
	else if (code == INT20_ALLOC_HEAP)
	{
		if (not param2) return;
		dr::enable_interrupts();
		*cast<u32*>(param2) = cast<u32>(Allocator::alloc(param1));
		dr::disable_interrupts();
	}
	else if (code == INT20_FREE_HEAP)
	{
		if (not param1) return;
		dr::enable_interrupts();
		var result: u32 = Allocator::free(cast<void*>(param1)) ? 1 : 0;
		low { mov RV, $result }
		dr::disable_interrupts();
	}
	else
	{
		// TODO: Eventually this should probably raise some kind of error/warning
	}
}

struct DiskInterfaceRegs { var signal: u8; var mode: u8; var disk: u8; var reserved: u8; var address: u32;
						   var dataSize: u32; var memoryAddress: u32; var status: u8; };
sub __int20_load_from_ddd(var ddd: dr::DiskDriverData*, var blocking: bool = false) {
        var regs: DiskInterfaceRegs* = cast<DiskInterfaceRegs*>(dr::MemoryLayout.DiskInterface);
        regs->mode = ddd->mode;
        regs->disk = ddd->disk;
        regs->address = ddd->address;
        regs->dataSize = ddd->dataSize;
        regs->memoryAddress = ddd->memoryAddress;
        if (!blocking) {
            regs->signal = dr::DiskSignals.Start;
            return;
        }
        low { zflg $dr::CPUFlags.InterruptsEnabled }
        regs->signal = dr::DiskSignals.Start;
        while (regs->status != dr::DiskStatus.Free) {}
        low { sflg $dr::CPUFlags.InterruptsEnabled }
}
