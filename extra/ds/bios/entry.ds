#once

#import(<dragon-sdk>)

#include(int20.ds)
#include(int30.ds)
#include(data.ds)

sub main() {
	*cast<u8*>(dr::VGARegisters.VideoMode) = dr::VGAVideoModes.TextSingleColor;
	dr::enable_interrupts();
	assert(sizeof(VGARegs) == 256);
	dr::set_interrupt_vector_entry(0x20, &__int_20_handler);
	dr::set_interrupt_vector_entry(0x30, &__int_30_handler);

	var stack_size: u32 = dr::read_cmos(dr::CMOSRegisters.StackSize);
	var heap_size: u32 = 4*1024*1024;
	var heap_addr: u32 = dr::read_cmos(dr::CMOSRegisters.MemoryStart) + dr::read_cmos(dr::CMOSRegisters.MemorySize) - stack_size - heap_size;
	Allocator::init(cast<u8*>(heap_addr), heap_size);

	__print_machine_info(stack_size + heap_size);
	__load_mbr_data_block();
	low { debug_break };

	// var dpt_block: DPTBlock;
	// dpt_load_block(&dpt_block);
	// var buff: u8[12];
	// for (var i: i8 = 0; i < dpt_block.partitionCount; i++)
	// {
	// 	if (dpt_is_partition_bootable(&dpt_block.entries[i]))
	// 		println(dpt_block.entries[i].label);
	// 	else
	// 		println("false");
	// }
	// low { hlt }

	// Exit BIOS mode
	low {
		%low $INST_BIOS_NODE_TOGGLE 0x00
		jmp $dr::MemoryLayout.RAM
	}
}

sub __load_mbr_data_block() {
	var disk: u8 = dr::get_boot_disk();
	var ddd: dr::DiskDriverData;
	ddd.mode = dr::DiskMode.Read;
	ddd.disk = disk;
	ddd.address = 0x00000000;
	ddd.dataSize = 4194304;
	ddd.memoryAddress = dr::MemoryLayout.RAM;
	dr::raise_interrupt(0x20, INT20_LOAD_FROM_DDD_BLOCKING, cast<u32>(&ddd));
}

sub __print_machine_info(var reserved_ram: u32) {
	for (var i: u32 = 0; i < sizeof(BiosLogo) / sizeof(BiosLogo[0]); i++) {
		dr::TextSingle::print(BiosLogo[i]);
		if (i == 1)
		{
			dr::TextSingle::print(' ');
			dr::raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
			dr::TextSingle::print(BiosName);
			dr::TextSingle::print(' ');
			dr::TextSingle::print(cast<u16>(BiosVersion >> 16));
			dr::TextSingle::print('.');
			dr::TextSingle::print(cast<u16>(BiosVersion & 0xFFFF));
			dr::raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
		}
		else if (i == 2)
		{
			dr::TextSingle::print(" Clock: ");
			var speed: u32 = *cast<u32*>(dr::CMOSRegisters.ClockSpeed);
			var dec: u32 = 0;
			var unit: string = "    ";
			unit = "Hz";
			if (speed > 1000)
			{
				dec = speed % 1000;
				speed /= 1000;
				unit = "KHz";
				if (speed > 1000)
				{
					dec = speed % 1000;
					speed /= 1000;
					unit = "MHz";
				}
			}
			dr::TextSingle::print(speed);
			dr::TextSingle::print(".");
			dr::TextSingle::print(dec);
			dr::TextSingle::print(" ");
			dr::TextSingle::print(unit);
		}
		else if (i == 3)
		{
			dr::TextSingle::print(" Memory: ");
			var memStart: u32 = *cast<u32*>(dr::CMOSRegisters.MemoryStart);
			var memSize: u32 = *cast<u32*>(dr::CMOSRegisters.MemorySize);
			var mem: u32 = memSize - reserved_ram;
			var buff: u8[10];
			dr::format_size(mem, buff, true, 2);
			dr::TextSingle::print(buff);
			dr::TextSingle::print("/");
			dr::format_size(memSize, buff);
			dr::TextSingle::print(buff);
		}
		dr::TextSingle::new_line();
	}
	// TODO: Add back the info
}
