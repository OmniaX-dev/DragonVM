#import(<dragon-sdk>)

#include(int20.ds)
#include(int30.ds)
#include(data.ds)

const BOOTLOADER_PATH: string = "/init/boot.img";

sub main() {
	*cast<u8*>(dr::VGARegisters.VideoMode) = dr::VGAVideoModes.TextSingleColor;
	dr::enable_interrupts();
	assert(sizeof(dr::VGADevice) == 256);
	dr::set_interrupt_vector_entry(0x20, &__int_20_handler);
	dr::set_interrupt_vector_entry(0x30, &__int_30_handler);

	var stack_size: u32 = dr::read_cmos(dr::CMOSRegisters.StackSize);
	var heap_size: u32 = 4*1024*1024;
	var heap_addr: u32 = dr::read_cmos(dr::CMOSRegisters.MemoryStart) + dr::read_cmos(dr::CMOSRegisters.MemorySize) - stack_size - heap_size;
	Allocator::init(cast<u8*>(heap_addr), heap_size);

	var dpt_block: dr::DPTBlock;
	if (not dr::dpt_load_block(&dpt_block))
	{ debug_print("Not a DPT block"); low { hlt } } //TODO: Error
	var init_part: dr::DPTPartitionBlock*;
	if (not __get_init_part(&dpt_block, &init_part))
	{ debug_print("No INIT partition found"); low { hlt } } //TODO: Error

	__print_machine_info(stack_size + heap_size);

	dr::time::sleep(2000); //This is just for show

	if (__boot_init_part(init_part) != 0)
	{ debug_print("Failed to boot init partition"); low { hlt } } //TODO: Error
}

sub __get_init_part(var dpt_block: dr::DPTBlock*, var outPart: dr::DPTPartitionBlock**) -> bool {
	var fs: dr::fs::FileSystem;
	var disk: dr::dfs::DiskPartition;
	for (var i: i8 = 0; i < dpt_block->partitionCount; i++)
	{
		var part = &dpt_block->entries[i];
		if (dr::dpt_is_partition_init(part))
		{
			dr::dfs::dpt_partition(&disk, part);
			if (fs.mount_partition(&disk, true))
			{
				if (not fs.is_file(BOOTLOADER_PATH)) continue;
				fs.unmount();
				*outPart = part;
				return true;
			}
		}
	}
	*outPart = null;
	return false;
}

sub __boot_init_part(var init_part: dr::DPTPartitionBlock*) -> i32 {
	var fs: dr::fs::FileSystem;
	var vol = fs.volume();
	assert(false, "Bootloader size constraint missing in __boot_init_part");
	// if (node.size > 0x01410000 - dr::MemoryLayout.RAM or dr::MemoryLayout.RAM + node.size > heap_addr) return -1;
	var r: i32 = fs.read_all(BOOTLOADER_PATH, cast<u8*>(dr::MemoryLayout.RAM), 0);
	if (r < 0) return r - 1000;
	low {
		%low $INST_BIOS_NODE_TOGGLE 0x00
		jmp $dr::MemoryLayout.RAM
		hlt
	}
	return 0; // Unreacheable
}

sub __print_machine_info(var reserved_ram: u32) {
	for (var i: u32 = 0; i < sizeof(BiosLogo) / sizeof(BiosLogo[0]); i++) {
		dr::TextSingle::print(BiosLogo[i]);
		if (i == 1)
		{
			dr::TextSingle::print(' ');
			dr::raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
			dr::TextSingle::print(BiosName);
			dr::TextSingle::print(' ');
			dr::TextSingle::print(cast<u16>(BiosVersion >> 16));
			dr::TextSingle::print('.');
			dr::TextSingle::print(cast<u16>(BiosVersion & 0xFFFF));
			dr::raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
		}
		else if (i == 2)
		{
			dr::TextSingle::print(" Clock: ");
			var speed: u32 = *cast<u32*>(dr::CMOSRegisters.ClockSpeed);
			var dec: u32 = 0;
			var unit: string = "    ";
			unit = "Hz";
			if (speed > 1000)
			{
				dec = speed % 1000;
				speed /= 1000;
				unit = "KHz";
				if (speed > 1000)
				{
					dec = speed % 1000;
					speed /= 1000;
					unit = "MHz";
				}
			}
			dr::TextSingle::print(speed);
			dr::TextSingle::print(".");
			dr::TextSingle::print(dec);
			dr::TextSingle::print(" ");
			dr::TextSingle::print(unit);
		}
		else if (i == 3)
		{
			dr::TextSingle::print(" Memory: ");
			var memStart: u32 = *cast<u32*>(dr::CMOSRegisters.MemoryStart);
			var memSize: u32 = *cast<u32*>(dr::CMOSRegisters.MemorySize);
			var mem: u32 = memSize - reserved_ram;
			var buff: u8[10];
			dr::format_size(mem, buff, true, 2);
			dr::TextSingle::print(buff);
			dr::TextSingle::print("/");
			dr::format_size(memSize, buff);
			dr::TextSingle::print(buff);
		}
		dr::TextSingle::new_line();
	}
	// TODO: Add back the info
}
