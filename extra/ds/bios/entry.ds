#include(data.ds)
#include(<bios.ds>)
#include(<dpt.ds>)
#include(int20.ds)
#include(int30.ds)

sub main() {
	*cast<u8*>(VGARegisters.VideoMode) = VGAVideoModes.TextSingleColor;
	set_interrupts_enabled(true);
	set_interrupt_vector_entry(0x20, &__int_20_handler);
	set_interrupt_vector_entry(0x30, &__int_30_handler);

	__print_machine_info();
	__load_mbr_data_block();

	// var dpt_block: DPTBlock;
	// dpt_load_block(&dpt_block);
	// var buff: u8[12];
	// for (var i: i8 = 0; i < dpt_block.partitionCount; i++)
	// {
	// 	if (dpt_is_partition_bootable(&dpt_block.entries[i]))
	// 		println(dpt_block.entries[i].label);
	// 	else
	// 		println("false");
	// }
	// low { hlt }

	// Exit BIOS mode
	low {
		%low $INST_BIOS_NODE_TOGGLE 0x00
		jmp $MemoryLayout.MBR
	}
}

sub __load_mbr_data_block() {
	var disk: u8 = get_boot_disk();
	var ddd: DiskDriverData;
	ddd.mode = DiskMode.Read;
	ddd.disk = disk;
	ddd.address = 0x00000000;
	ddd.dataSize = 512;
	ddd.memoryAddress = MemoryLayout.MBR;
	raise_interrupt(0x20, INT20_LOAD_FROM_DDD_BLOCKING, cast<u32>(&ddd));
}

sub __print_machine_info() {
	for (var i: u32 = 0; i < sizeof(BiosLogo) / sizeof(BiosLogo[0]); i++) {
		TextSingle::print(BiosLogo[i]);
		if (i == 1)
		{
			TextSingle::print(' ');
			raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
			TextSingle::print(BiosName);
			TextSingle::print(' ');
			TextSingle::print(cast<u16>(BiosVersion >> 16));
			TextSingle::print('.');
			TextSingle::print(cast<u16>(BiosVersion & 0xFFFF));
			raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
		}
		else if (i == 2)
		{
			TextSingle::print(" Clock: ");
			var speed: u32 = *cast<u32*>(CMOSRegisters.ClockSpeed);
			var dec: u32 = 0;
			var unit: string = "    ";
			unit = "Hz";
			if (speed > 1000)
			{
				dec = speed % 1000;
				speed /= 1000;
				unit = "KHz";
				if (speed > 1000)
				{
					dec = speed % 1000;
					speed /= 1000;
					unit = "MHz";
				}
			}
			TextSingle::print(speed);
			TextSingle::print(".");
			TextSingle::print(dec);
			TextSingle::print(" ");
			TextSingle::print(unit);
		}
		else if (i == 3)
		{
			TextSingle::print(" Memory: ");
			var memStart: u32 = *cast<u32*>(CMOSRegisters.MemoryStart);
			var memSize: u32 = *cast<u32*>(CMOSRegisters.MemorySize);
			var mem: u32 = memSize - memStart;
			var buff: u8[10];
			format_size(mem, buff, true, 2);
			TextSingle::print(buff);
			TextSingle::print("/");
			format_size(memSize, buff);
			TextSingle::print(buff);
		}
		TextSingle::new_line();
	}
	// TODO: Add back the info
}
