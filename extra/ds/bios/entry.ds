#import(<dragon-sdk>)

#include(int20.ds)
#include(int30.ds)
#include(data.ds)

const BOOTLOADER_PATH: string = "/init/boot.img";
const MAX_BOOTLOADER_SIZE: u32 = 1024*1024*10; // 10 MiB

sub main() {
	*cast<u8*>(dr::VGARegisters.VideoMode) = dr::VGAVideoModes.TextSingleColor;
	dr::enable_interrupts();
	assert(sizeof(dr::VGADevice) == 256);
	// The BIOS's services: programs in user mode may call them (a kernel can take that back with
	// dr::set_interrupt_user_callable).
	dr::set_interrupt_vector_entry(0x20, &__int_20_handler, true);
	dr::set_interrupt_vector_entry(0x30, &__int_30_handler, true);

	var stack_size: u32 = dr::read_cmos(dr::CMOSRegisters.StackSize);
	var heap_size: u32 = 4*1024*1024;
	var heap_addr: u32 = dr::read_cmos(dr::CMOSRegisters.MemoryStart) + dr::read_cmos(dr::CMOSRegisters.MemorySize) - stack_size - heap_size;
	// The system heap (dr::malloc): a kernel can replace it (dr::set_system_heap).
	dr::set_system_heap(dr::Heap::create(cast<u8*>(heap_addr), heap_size));

	var dpt_block: dr::DPTBlock;
	if (not dr::dpt_load_block(&dpt_block))
	{ debug_print("Not a DPT block"); low { hlt } } //TODO: Error
	var init_part: dr::DPTPartitionBlock*;
	if (not __get_init_part(&dpt_block, &init_part))
	{ debug_print("No INIT partition found"); low { hlt } } //TODO: Error

	__print_machine_info(stack_size + heap_size);

	// dr::time::sleep(2000); //This is just for show

	var r: i32 = __boot_init_part(init_part);
	if (r != 0)
	{
		debug_print("Failed to boot init partition: ");
		var buff: u8[10];
		debug_print(std::itoa(r, buff));
		low { hlt }
	} //TODO: Error
}

sub __get_init_part(var dpt_block: dr::DPTBlock*, var outPart: dr::DPTPartitionBlock**) -> bool {
	var fs: dr::fs::FileSystem;
	var disk: dr::dfs::DiskPartition;
	for (var i: i8 = 0; i < dpt_block->partitionCount; i++)
	{
		var part = &dpt_block->entries[i];
		if (dr::dpt_is_partition_init(part))
		{
			dr::dfs::dpt_partition(&disk, part);
			if (fs.mount_partition(&disk, true))
			{
				if (not fs.is_file(BOOTLOADER_PATH)) continue;
				fs.unmount();
				*outPart = part;
				return true;
			}
		}
	}
	*outPart = null;
	return false;
}

sub __boot_init_part(var init_part: dr::DPTPartitionBlock*) -> i32 {
	var fs: dr::fs::FileSystem;
	var disk: dr::dfs::DiskPartition;
	dr::dfs::dpt_partition(&disk, init_part);
	if (not fs.mount_partition(&disk, true))
		return -1;
	defer fs.unmount();
	var info: dr::fs::Info;
	if (not fs.info(BOOTLOADER_PATH, &info))
		return -2;
	if (info.size > MAX_BOOTLOADER_SIZE)
		return -3;
	var load_addr: u8* = cast<u8*>(dr::MemoryLayout.RAM);
	var r: i32 = fs.read_all(BOOTLOADER_PATH, load_addr, info.size);
	if (r < 0) return r - 1000;
	var entry_addr: u32 = 0;
	r = dr::drx::load(load_addr, info.size, load_addr, MAX_BOOTLOADER_SIZE, &entry_addr);
	if (r != dr::drx::Errors.NoError)
		return r - 2000;
	fs.unmount();
	// The boot loader runs in supervisor mode, as the BIOS (and so does the kernel it loads).
	const argc: u32 = 2;
	var argv: u8*[argc];
	argv[0] = dr::malloc(11);	// a u32 in decimal: up to 10 digits and the terminator
	argv[1] = dr::malloc(11);
	std::utoa(cast<u32>(load_addr), argv[0]);
	std::utoa(info.size, argv[1]);
	dr::drx::run(entry_addr, argc, argv); // Bootloader should never return from main
	low { hlt };
	return 0; // Unreacheable
}

sub __print_machine_info(var reserved_ram: u32) {
	for (var i: u32 = 0; i < sizeof(BiosLogo) / sizeof(BiosLogo[0]); i++) {
		dr::TextSingle::print(BiosLogo[i]);
		if (i == 1)
		{
			dr::TextSingle::print(' ');
			dr::raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
			dr::TextSingle::print(BiosName);
			dr::TextSingle::print(' ');
			dr::TextSingle::print(cast<u16>(BiosVersion >> 16));
			dr::TextSingle::print('.');
			dr::TextSingle::print(cast<u16>(BiosVersion & 0xFFFF));
			dr::raise_interrupt(0x30, INT30_INVERT_COLORS_TEXT_SINGLE);
		}
		else if (i == 2)
		{
			dr::TextSingle::print(" Clock: ");
			var speed: u32 = *cast<u32*>(dr::CMOSRegisters.ClockSpeed);
			var dec: u32 = 0;
			var unit: string = "    ";
			unit = "Hz";
			if (speed > 1000)
			{
				dec = speed % 1000;
				speed /= 1000;
				unit = "KHz";
				if (speed > 1000)
				{
					dec = speed % 1000;
					speed /= 1000;
					unit = "MHz";
				}
			}
			dr::TextSingle::print(speed);
			dr::TextSingle::print(".");
			dr::TextSingle::print(dec);
			dr::TextSingle::print(" ");
			dr::TextSingle::print(unit);
		}
		else if (i == 3)
		{
			dr::TextSingle::print(" Memory: ");
			var memStart: u32 = *cast<u32*>(dr::CMOSRegisters.MemoryStart);
			var memSize: u32 = *cast<u32*>(dr::CMOSRegisters.MemorySize);
			var mem: u32 = memSize - reserved_ram;
			var buff: u8[10];
			std::format_size(mem, buff, true, 2);
			dr::TextSingle::print(buff);
			dr::TextSingle::print("/");
			std::format_size(memSize, buff);
			dr::TextSingle::print(buff);
		}
		dr::TextSingle::new_line();
	}
}
