#include(sched.ds)

namespace proc {
		// sys_wait(pid, out_code): pid -1 = any child. The child's pid; out_code (if not 0) gets its code.
		sub sys_wait(var pid: i32, var out_code: u32) -> i32 {
            if (out_code != 0 and not proc::user_writable(&proc::g_current->as, out_code, 4))
                return std::SystemErrors.BadAddress;
            var has_child: bool = false;
            for (var i: u32 = 0; i < proc::MAX_PROCESSES; i++) {
                var c: proc::Process* = &proc::g_processes[i];
                if (c->state == proc::ProcessState.Free or c->state == proc::ProcessState.Dead or c->parent != proc::g_current->pid)
                    continue;
                if (pid != -1 and c->pid != cast<u32>(pid))
                    continue;
                has_child = true;
                if (c->state == proc::ProcessState.Zombie) {          // already ended: no need to block
                    if (out_code != 0)
                        *cast<i32*>(out_code) = c->exit_code;
                    c->state = proc::ProcessState.Dead;                // reap_dead frees it
                    g_reap_pending = true;
                    return cast<i32>(c->pid);
                }
            }
            if (not has_child)
                return std::ProcessErrors.NoChild;
            proc::g_current->wait_pid = pid;
            proc::g_current->wait_out = out_code;
            proc::block_current(proc::BlockReason.Wait);                    // doesn't return: deliver() sets its rv
            return 0;
		}

		// Spawn(path: string, argc, argv: string*): the new process's pid. The caller keeps running.
		sub sys_spawn(var path: u32, var argc: u32, var argv: u32) -> i32 {
	        var as: AddressSpace* = &g_current->as;
	        var r: i32 = __internal::copy_user_string(as, path, g_spawn_path, MAX_PATH);
	        if (r == std::SystemErrors.TooLong) return std::FileErrors.PathTooLong;
	        if (r < 0)
	            return r;
	        if (argc > MAX_ARGS)
	            return std::SystemErrors.TooMany;
	        if (argc > 0 and not user_readable(as, argv, argc * 4))
	            return std::SystemErrors.BadAddress;
	        var used: u32 = 0;
	        for (var i: u32 = 0; i < argc; i++) {
	            r = __internal::copy_user_string(as, *cast<u32*>(argv + i * 4), &g_spawn_strings[used], ARGS_BYTES - used);
	            if (r < 0)
	                return r;
	            g_spawn_argv[i] = &g_spawn_strings[used];
	            used += cast<u32>(r) + 1;
	        }
	        var err: i32 = 0;
	        var child: Process* = process_start(g_spawn_path, argc, g_spawn_argv, g_current->pid, &err);
	        if (not child)
	            return err;
	        return cast<i32>(child->pid);
		}

		// Sleep(ms): the process waits at least ms milliseconds. 0 when it wakes.
		sub sys_sleep(var ms: u32) -> i32 {
		    if (ms == 0)
		        return std::Ok;                                   // nothing to wait for (later: a yield)
		    if (ms > 0x7FFFFFFF)
		        ms = 0x7FFFFFFF;                                  // ~24.8 days: wake_sleepers compares the times signed
		    g_current->wake_time = dr::time_get_millis() + ms;
		    g_sleepers++;
		    block_current(BlockReason.Sleep);                     // doesn't return: wake() sets its rv
		    return std::Ok;
		}

		sub sys_alloc_pages(var count: u32) -> i32 {
		    var as: AddressSpace* = &g_current->as;
		    if (count == 0 or count > g_pages.total_pages())  return std::SystemErrors.InvalidArgument;   // (also keeps count * PAGE_SIZE from wrapping)
		    var addr: u32 = g_pages.alloc(count);
		    if (addr == 0) return std::SystemErrors.NoMemory;
		    std::memset(cast<void*>(addr), 0, count * PAGE_SIZE);    // these pages may have held another process's data
		    if (not as_map_heap(as, addr, count)) {
		        g_pages.free(addr, count);
		        return std::SystemErrors.TooMany;
		    }
		    return cast<i32>(addr);
		}

		// Gives back [start, start + count * PAGE_SIZE): it has to lie entirely inside the process's own Heap
		// regions (it may span several of them, or only part of one). All or nothing: a failed call changes nothing.
		sub sys_free_pages(var start: u32, var count: u32) -> i32 {
	        var as: AddressSpace* = &g_current->as;
	        if ((start & (PAGE_SIZE - 1)) != 0 or start == 0 or count == 0)
	            return std::SystemErrors.InvalidArgument;
	        if (count >= (0u - start) / PAGE_SIZE)                  // the range would wrap past the top of memory
	            return std::SystemErrors.BadAddress;
	        var end: u32 = start + count * PAGE_SIZE;

	        // 1. Check: the Heap regions overlapping the range have to cover all of it. Regions never overlap
	        //    each other, so "the overlaps add up to the whole range" means no gaps, and no Image, Stack or
	        //    Shared pages inside it. A region that sticks out on both sides has to be split, which needs a slot.
	        var covered: u32 = 0;
	        var split: bool = false;
	        for (var i: u32 = 0; i < as->count; i++) {
	            var r: Region* = &as->regions[i];
	            if (r->kind != RegionKind.Heap or not r->owned)
	                continue;
	            var r_end: u32 = r->start + r->pages * PAGE_SIZE;
	            var lo: u32 = r->start > start ? r->start : start;
	            var hi: u32 = r_end < end ? r_end : end;
	            if (lo < hi) {
	                covered += hi - lo;
	                split = split or (r->start < start and r_end > end);
	            }
	        }
	        if (covered != end - start)
	            return std::SystemErrors.BadAddress;
	        if (split and as->count == AS_MAX_REGIONS)
	            return std::SystemErrors.TooMany;

	        // 2. Apply: each overlapping region is removed, shortened at one end, or split in two.
	        var i: u32 = 0;
	        while (i < as->count) {
	            var r: Region* = &as->regions[i];
	            var r_end: u32 = r->start + r->pages * PAGE_SIZE;
	            if (r->kind != RegionKind.Heap or not r->owned or r_end <= start or r->start >= end) {
	                i++;
	                continue;
	            }
	            if (r->start >= start and r_end <= end) {               // all of it: remove
	                as->regions[i] = as->regions[as->count - 1];        // the last one moves in: look at slot i again
	                as->count--;
	                continue;
	            }
	            if (r->start < start and r_end > end) {                  // the middle: split, the tail gets a new slot
	                var tail: Region* = &as->regions[as->count];
	                *tail = *r;
	                tail->start = end;
	                tail->pages = (r_end - end) / PAGE_SIZE;
	                as->count++;
	                r->pages = (start - r->start) / PAGE_SIZE;
	            }
	            else if (r->start < start)                               // its end: shorten
	                r->pages = (start - r->start) / PAGE_SIZE;
	            else {                                                   // its beginning: move the start up
	                r->pages = (r_end - end) / PAGE_SIZE;
	                r->start = end;
	            }
	            i++;
	        }

	        // 3. The pages: no access for the process any more, then back to the allocator in one go.
	        dr::cpu::set_page_permissions(as->map, start, count * PAGE_SIZE, dr::cpu::Permissions.None);
	        g_pages.free(start, count);
	        return 0;
		}

		sub sys_get_pid() -> i32 {
			return g_current->pid;
		}

		sub sys_get_parent_pid() -> i32 {
			if (g_current->pid == 1) return 0; // TODO: What to return here?
			var parent: Process* = find_process(g_current->parent);
			if (not parent) return -1; // Shoud there be an error?
			return parent->pid;
		}
}
