#import("dragon-sdk")

#include(video.ds)
#include(syscall.ds)
#include(panic.ds)

const USER_MODE_BASE_FAULT = 128;

sub fault_name(var v: u8) -> string {
	if (v == dr::cpu::Faults.DivisionByZero) return "division by zero";
	if (v == dr::cpu::Faults.InvalidInstruction) return "invalid instruction";
	if (v == dr::cpu::Faults.PrivilegedInstruction) return "privileged instruction";
	if (v == dr::cpu::Faults.AccessViolation) return "access violation";
	if (v == dr::cpu::Faults.StackOverflow) return "stack overflow";
	if (v == dr::cpu::Faults.General) return "general fault";
	return "unknown fault";
}

sub dump_frame(var f: TrapFrame*) {
	kernel_log("IP=", false); kernel_log(f->ip, 16, false);
	kernel_log(" SP=", false); kernel_log(f->sp, 16, false);
	kernel_log(" FP=", false); kernel_log(f->fp, 16, false);
	kernel_log(" FL=", false); kernel_log(f->fl, 16, false);
	kernel_log(" mode=", false); kernel_log(f->mode == 0 ? "user" : "kernel", true);
	for (var n: u32 = 1; n <= 20; n++)
	{
		kernel_log("R", false); kernel_log(n, 10, false); kernel_log("=", false); kernel_log(f->regs.R(n), 16, false);
		if (n % 4 == 0) kernel_log(""); else kernel_log("  ", false);
	}
	kernel_log("ACC=", false); kernel_log(f->acc, 16, false);
	kernel_log(" RV=", false); kernel_log(f->rv, 16);
}

sub backtrace(var fp: u32) {
	kernel_log("backtrace:");
	for (var depth: u32 = 0; depth < 16 and fp != 0; depth++) {
		var w: u32* = cast<u32*>(fp);
		kernel_log("  ", false); kernel_log(w[3], 16);
		fp = w[2];
	}
}

namespace __internal {
	inline sub __on_fault() {
		var vector: u8 = dr::cpu::fault_vector();
		var addr: u32 = dr::cpu::fault_address();
		var ip: u32 = dr::cpu::fault_ip();
		var f: TrapFrame* = current_trap_frame();

		if (f->mode == 0) {
			kernel_log("process <", false); kernel_log(proc::g_current->pid, 10, false); kernel_log("> was killed: ", false);
			kernel_log(fault_name(vector)); kernel_log(" at address ", false); kernel_log(addr, 16, true);
			proc::process_exit(proc::g_current, USER_MODE_BASE_FAULT + vector);
		} else {
			panic_begin(fault_name(vector));
		}
		kernel_log("address=", false); kernel_log(addr, 16, false);
		kernel_log(" ip=", false); kernel_log(ip, 16);
		dump_frame(f);
		backtrace(f->fp);
		halt_forever();
	}
}
