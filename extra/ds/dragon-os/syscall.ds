#import(<dragon-sdk>)

#include(fault.ds)

const SYSCALL: u32 = 0x40;
const SYSCALL_EXIT: u32 = 0x10;
const SYSCALL_PRINT: u32 = 0x11;

struct SavedRegisters {
	var r: u32[20];              // r[0] = R20 ... r[19] = R1   →  Rn = r[20 - n]
	inline sub R(var n: u32) -> u32 { return this->r[20 - n]; }
	inline sub set_R(var n: u32, var val: u32) { this->r[20 - n] = val; }
};

struct TrapFrame {               // at trap_frame() + 4
	var frame_size: u32;         // 1
	var fp: u32;                 // 2  interrupted code's FP
	var ip: u32;                 // 3
	var acc: u32;                // 4
	var pp: u32;                 // 5
	var regs: SavedRegisters;    // 6..25
	var argc: u32;               // 26
	var marker: u32;             // 27
	var fl: u32;                 // 28
	var offset: u32;             // 29
	var s2: u32;                 // 30
	var s1: u32;                 // 31
	var rv: u32;                 // 32
	var mode: u32;               // 33  0 = user
	var sp: u32;                 // 34
};
struct SyscallFrame {            // at trap_frame() + 4
	var frame_size: u32;         // 1
	var fp: u32;                 // 2  interrupted code's FP
	var ip: u32;                 // 3
	var acc: u32;                // 4
	var pp: u32;                 // 5
	var regs: SavedRegisters;    // 6..25
	var argc: u32;               // 26
	var marker: u32;             // 27
	var mode: u32;               // 28  0 = user
	var sp: u32;                 // 29
};
inline sub current_trap_frame() -> TrapFrame* { return cast<TrapFrame*>(dr::cpu::trap_frame() + 4); }
inline sub current_syscall_frame() -> SyscallFrame* { return cast<SyscallFrame*>(dr::cpu::trap_frame() + 4); }

interrupt sub on_fault() { __on_fault(); }

interrupt sub on_timer() {}

interrupt sub on_syscall() {
	var f: SyscallFrame* = current_syscall_frame();
	var function: u32 = f->regs.R(9);
	if (function == SYSCALL_PRINT)
		on_print(f->regs.R(8), f->regs.R(7));
}

sub on_print(var param1: u32, var param2: u32) {
	if (dr::vga_is_textSingle())
	{
		// param1 = u8* string
		// param2 = new_line
		dr::TextSingle.print(cast<u8*>(param1)); // TODO: Check the entire string is accessible by the calling process
		if (param2 != 0)
			dr::TextSingle.new_line();
	}
}

// TODO: This belongs in a user-side library eventually
sub syscall(var function: u32, var out_rv: u32*, ...typed) -> bool {
	var args: dr::VaList(va_start(), va_count(), va_types());
	var null_rv: u32 = 0;
	if (not out_rv)
		out_rv = &null_rv;
	if (function == SYSCALL_PRINT)
	{
		if (args.count == 0) return false;
		else {
			if (args.type_of(0) != dr::VaTypes.String) return false;
			var str: u8* = args.get_string(0);
			var nl: u32 = 0;
			if (args.count > 1 and args.get_bool(1))
				nl = 1;
			low {
				mov R9, $SYSCALL_PRINT
				mov R8, $str
				mov R7, $nl
				int $SYSCALL
			}
			*out_rv = 0;
			return true;
		}
	}
	return false;
}

sub init_interrupt_vector() {
	for (var v: u8 = 0; v <= dr::cpu::Faults.General; v++)
		dr::set_interrupt_vector_entry(v, &on_fault);
	dr::set_interrupt_vector_entry(SYSCALL, &on_syscall, true);
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.Timer, &on_timer);
}
