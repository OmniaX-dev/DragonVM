#import("dragon-sdk")

#include(../memory/memory.ds)

namespace proc {
	const AS_MAX_REGIONS: u32 = 256;               // heap regions merge when adjacent: this is for scattered ones
	const MAX_PROCESSES: u32 = 256;                // RAM runs out first: each process needs ~100 KiB of pages
	const KSTACK_PAGES: u32 = 2;                    // 8 KiB: traps and syscalls only
	const USTACK_PAGES: u32 = 16;                   // 64 KiB
	const FRAME_WORDS: u32 = 34;
	const PROC_NAME_MAX_LEN: u32 = std::PROCESS_NAME_MAX;

	enum RegionKind: u8 { Image, Stack, Heap, Shared }
	struct Region {
		var start: u32;                 // page-aligned
		var pages: u32;
		var permissions: u8;    		// dr::cpu::Permissions
		var kind: RegionKind;
		var owned: bool;                // its pages are the process's: freed with it (false: shared, e.g. the trampoline)
	};

	// A process's own random numbers (xoshiro128**, as libcore's std::rand::engine::Xoshiro128ss, but
	// a plain struct: Process slots are cleared with memset, which a class's table pointer wouldn't
	// survive). Seeded from the Random device's entropy when the process starts; SeedRandom
	// reseeds only the caller's, so no process can change (or predict) another's numbers.
	struct ProcessRandom {
		var s: u32[4];
		sub seed(var seed: u32) {
			var sm: std::rand::__internal::SplitMix32 = { seed };
			for (var i: u32 = 0; i < 4; i++)
				this->s[i] = sm.next();
		}
		sub next() -> u32 {
			var r: u32 = std::rand::__internal::rotl32(this->s[1] * 5, 7) * 9;
			var t: u32 = this->s[1] << 9;
			this->s[2] ^= this->s[0];
			this->s[3] ^= this->s[1];
			this->s[1] ^= this->s[2];
			this->s[0] ^= this->s[3];
			this->s[2] ^= t;
			this->s[3] = std::rand::__internal::rotl32(this->s[3], 11);
			return r;
		}
	};

	struct AddressSpace {
		var map: u8*;                   // the permission map (16 KiB = 4 pages, from g_pages)
		var regions: Region[AS_MAX_REGIONS];
		var count: u32;
	};

	enum BlockReason: u8 { None, Sleep, Wait, Key }
	enum ProcessState: u8 {
		Free,           // an unused slot
		New,            // taken by process_start, being built: not runnable yet
		Ready,          // can run, waiting for its turn
		Running,        // the one on the CPU (g_current)
		Blocked,        // waiting for something (a key, the disk, a child): later
		Zombie,         // ended; its kernel stack and slot are not freed yet (see "end process")
		Dead            // collected: reap_dead frees its kernel stack and its slot
	}
	struct Process {
		var pid: u32;
		var state: ProcessState;
		var name: u8[PROC_NAME_MAX_LEN];
		var parent: u32;                        // the pid that started it (for wait / the exit code, later)
		var exit_code: i32;

		var as: AddressSpace;             		// its map and its regions (image, stack, ...)
		var entry: u32;                         // the DRX entry point (in its image)
		var user_stack_top: u32;                // for set_user_stack (the stack check)
		var user_stack_size: u32;

		var kernel_stack: u32;                  // the pages (KSTACK_PAGES), for freeing
		var kernel_top: u32;                    // for set_kernel_stack: where its traps land
		var frame: u32;                         // its saved trap frame (an address on its kernel stack), while it isn't running

		var slot: u32;
		var rv: u32;
		var block: BlockReason;
		var wake_time: u32;
		var wait_pid: i32;
		var wait_out: u32;
		var key_kinds: u32;                     // blocked in ReadKey: the events it wants (input::WANT_*)
		var random: ProcessRandom;              // Random / RandomF32 / SeedRandom: its own generator
	};

	var g_processes: Process[MAX_PROCESSES];
	var g_current: Process* = null;
	var g_next_pid: u32 = 1;
	var g_trampoline: u32 = 0;
	var g_idle: Process* = null;           // runs when nothing else is Ready (init_idle)
	var g_idle_entry: u32 = 0;
	var g_idle_proc: Process;              // not in g_processes: never Ready, never found, never reaped

	// false: no memory for the map
	sub as_create(var as: AddressSpace*) -> bool {
		var map: u32 = g_pages.alloc(dr::cpu::PermissionMapSize / PAGE_SIZE);   // 4 pages
		if (map == 0)
			return false;
		as->map = cast<u8*>(map);
		as->count = 0;
		std::memset(as->map, 0, dr::cpu::PermissionMapSize);                                     // all None
		return true;
	}

	// Gives the process [start, start + pages * PAGE_SIZE) with permissions, and remembers it.
	sub as_map(var as: AddressSpace*, var start: u32, var pages: u32, var permissions: u8, var kind: RegionKind, var owned: bool) -> bool {
		if (as->count == AS_MAX_REGIONS or (start & (PAGE_SIZE - 1)) != 0 or pages == 0)
			return false;
		var r: Region* = &as->regions[as->count];
		r->start = start;
		r->pages = pages;
		r->permissions = permissions;
		r->kind = kind;
		r->owned = owned;
		as->count++;
		dr::cpu::set_page_permissions(as->map, start, pages * PAGE_SIZE, permissions);
		return true;
	}

	// The region starting at start: back to None, its pages freed if the process owned them.
	sub as_unmap(var as: AddressSpace*, var start: u32) -> bool {
		for (var i: u32 = 0; i < as->count; i++) {
			var r: Region* = &as->regions[i];
			if (r->start != start)
				continue;
			dr::cpu::set_page_permissions(as->map, r->start, r->pages * PAGE_SIZE, dr::cpu::Permissions.None);
			if (r->owned)
				g_pages.free(r->start, r->pages);
			as->regions[i] = as->regions[as->count - 1];    // (the last one in its place)
			as->count--;
			return true;
		}
		return false;
	}

	sub as_destroy(var as: AddressSpace*) {
		for (var i: u32 = 0; i < as->count; i++) {
			if (as->regions[i].owned)
				g_pages.free(as->regions[i].start, as->regions[i].pages);
		}
		g_pages.free(cast<u32>(as->map), dr::cpu::PermissionMapSize / PAGE_SIZE);
		as->count = 0;
		as->map = null;
	}

	// Heap pages for the process: if they start right where one of its Heap regions ends,
	// or end right where one starts, that region grows. Otherwise they get a new slot (as_map).
	sub as_map_heap(var as: AddressSpace*, var start: u32, var pages: u32) -> bool {
        if ((start & (PAGE_SIZE - 1)) != 0 or pages == 0)
            return false;
        var end: u32 = start + pages * PAGE_SIZE;
        for (var i: u32 = 0; i < as->count; i++) {
            var r: Region* = &as->regions[i];
            if (r->kind != RegionKind.Heap or not r->owned)
                continue;
            var r_end: u32 = r->start + r->pages * PAGE_SIZE;
            if (r_end == start or r->start == end) {
                if (r->start == end)
                    r->start = start;             // growing downwards
                r->pages += pages;
                dr::cpu::set_page_permissions(as->map, start, pages * PAGE_SIZE, dr::cpu::Permissions.ReadWrite);
                return true;
            }
        }
        return as_map(as, start, pages, dr::cpu::Permissions.ReadWrite, RegionKind.Heap, true);
	}

	inline sub user_readable(var as: proc::AddressSpace*, var ptr: u32, var size: u32) -> bool { return __internal::as_check_user_permission(as, ptr, size, dr::cpu::Permissions.Read); }
	inline sub user_writable(var as: proc::AddressSpace*, var ptr: u32, var size: u32) -> bool { return __internal::as_check_user_permission(as, ptr, size, dr::cpu::Permissions.Write); }

	sub switch_to(var p: Process*) { // never returns
		dr::disable_interrupts();
		g_current = p;
		p->state = ProcessState.Running;
		dr::cpu::set_permission_map(p->as.map);
		dr::cpu::set_user_stack(p->user_stack_top, p->user_stack_size);
		var frame: u32 = p->frame;
		var rv: u32 = p->rv;
		dr::cpu::set_kernel_stack(p->kernel_top, KSTACK_PAGES * PAGE_SIZE);     // last: see below
		low {
			mov R1, $frame
			mov RV, $rv
			mov FP, R1
			mov SP, R1
			sflg $dr::CPUFlags.InterruptsEnabled
			rti
		}
	}

	sub init_trampoline() {
		var start: u32 = 0;
		var end: u32 = 0;
		__internal::trampoline_code(&start, &end);
		kernel_assert(end > start and end - start <= PAGE_SIZE, "The trampoline doesn't fit a page.");
		g_trampoline = g_pages.alloc(1);
		kernel_assert(g_trampoline != 0, "No page for the trampoline.");
		std::memset(cast<void*>(g_trampoline), 0, PAGE_SIZE);
		std::memcpy(cast<void*>(g_trampoline), cast<void*>(start), end - start);

		// The idle loop: one instruction at the end of the page, "jmp <its own address>"
		// (opcode 0x7C, then the address, big endian).
		g_idle_entry = g_trampoline + PAGE_SIZE - 8;
		var code: u8* = cast<u8*>(g_idle_entry);
		code[0] = 0x7C;
		code[1] = cast<u8>(g_idle_entry >> 24);
		code[2] = cast<u8>(g_idle_entry >> 16);
		code[3] = cast<u8>(g_idle_entry >> 8);
		code[4] = cast<u8>(g_idle_entry);
	}

	// The process that runs when no other can: the idle loop, in user mode (the timer preempts
	// it as any process). Its own kernel stack (its traps land there), no user stack.
	sub init_idle() {
	    var p: Process* = &g_idle_proc;
	    std::memset(p, 0, sizeof(Process));
	    std::strcpy(p->name, "idle");
	    kernel_assert(as_create(&p->as), "No memory for the idle process.");
	    kernel_assert(as_map(&p->as, g_trampoline, 1, dr::cpu::Permissions.Read, RegionKind.Shared, false), "Idle: map");
	    p->kernel_stack = g_pages.alloc(KSTACK_PAGES);
	    kernel_assert(p->kernel_stack != 0, "No memory for the idle process.");
	    p->kernel_top = p->kernel_stack + KSTACK_PAGES * PAGE_SIZE - 4;
	    build_start_frame(p, 0, 0, 0);
	    cast<u32*>(p->frame)[3] = g_idle_entry;    // IP: the loop, not the trampoline
	    g_idle = p;
	}

	// The frame process p starts from: rti "returns" to the trampoline, in user mode, on its stack.
	sub build_start_frame(var p: Process*, var argc: u32, var argv: u32, var user_sp: u32) {
		var fp: u32 = p->kernel_top - FRAME_WORDS * 4;          // f[34] is kernel_top itself
		var f: u32* = cast<u32*>(fp);
		std::memset(f, 0, (FRAME_WORDS + 1) * 4);               // f[0] .. f[34]; everything else is 0
		f[1] = 9 * 4;                                           // the frame size bookkeeping (as the CPU writes it)
		f[2] = 0;                                               // FP 0: the program's backtraces stop at the trampoline
		f[3] = g_trampoline;                                    // IP: where rti goes
		f[25] = p->entry;                                       // R1: the DRX entry
		f[24] = argc;                                           // R2
		f[23] = argv;                                           // R3: the argv copy in the process's memory
		f[27] = 0x48574952;                                     // the marker: FL, OFFSET, S2, S1, RV saved above
		f[28] = 1 << dr::CPUFlags.InterruptsEnabled;    		// FL: interrupts on in the process
		f[33] = 0;                                              // the mode rti returns to: user
		f[34] = user_sp;                                        // the SP rti returns to
		p->frame = fp;
	}

	// A Free slot of the table, reset (everything 0) and taken (New), with its pid and slot index.
	// null: the table is full.
	sub alloc_slot() -> Process* {
		for (var i: u32 = 0; i < MAX_PROCESSES; i++) {
			var p: Process* = &g_processes[i];
			if (p->state != ProcessState.Free)
				continue;
			std::memset(p, 0, sizeof(Process));     // nothing left over from the slot's last process
			p->slot = i;
			p->pid = g_next_pid++;                  // never reused (pid 0: none / the idle process)
			p->state = ProcessState.New;
			return p;
		}
		return null;
	}

	// Gives a slot back: a Zombie collected by Wait, or a New one process_start gave up on.
	// Its pages must be freed already (as_destroy, the kernel stack).
	sub free_slot(var p: Process*) {
		std::memset(p, 0, sizeof(Process));         // state 0 = Free
	}

	sub process_start(var path: string, var argc: u32, var argv: u8**, var parent: u32, var out_err: i32*) -> Process* {
		// TODO: switch asserts/panics to undo
		var __discardError: i32 = 0;
		if (not out_err) out_err = &__discardError;
		var p: Process* = alloc_slot();
		if (not p) {
			*out_err = std::SystemErrors.TooMany;
			return null;
		}

		var info: dr::fs::Info;
		if (not g_root_fs.info(path, &info)) {
			*out_err = g_root_fs.last_error();
			proc::free_slot(p);
			return null;
		}
		if (info.type != dr::fs::Type.File) {
			*out_err = std::ExecErrors.NotAFile;
			proc::free_slot(p);
			return null;
		}

		var image_pages: u32 = PageAllocator::pages_for(info.size);
		if (image_pages == 0) {
			*out_err = std::ExecErrors.Empty;
			proc::free_slot(p);
			return null;
		}
		var image: u8* = cast<u8*>(g_pages.alloc(image_pages));
		if (not image) {
			*out_err = std::SystemErrors.NoMemory;
			proc::free_slot(p);
			return null;
		}
		var r: i32 = g_root_fs.read_all(path, image, info.size);
		if (r < 0) {
			*out_err = g_root_fs.last_error();
			g_pages.free(cast<u32>(image), image_pages);
			proc::free_slot(p);
			return null;
		}
		var entry_addr: u32 = 0;
		r = dr::drx::load(image, info.size, image, image_pages * PAGE_SIZE, &entry_addr);
		if (r != std::Ok) {
			*out_err = r;
			g_pages.free(cast<u32>(image), image_pages);
			proc::free_slot(p);
			return null;
		}

		__internal::path_basename(path, p->name, PROC_NAME_MAX_LEN);
		p->parent = parent;
		p->entry = entry_addr;
		p->random.seed(*cast<u32*>(dr::RandomRegisters.Entropy));
		if (not proc::as_create(&p->as)) {
			*out_err = std::SystemErrors.NoMemory;
			g_pages.free(cast<u32>(image), image_pages);
			proc::free_slot(p);
			return null;
		}

		// 2. The image: zero the rest of the last page (the pages held whatever was there before),
		//    then let the process read, write and run it.
		std::memset(image + info.size, 0, image_pages * PAGE_SIZE - info.size);
		if (not proc::as_map(&p->as, cast<u32>(image), image_pages, dr::cpu::Permissions.ReadWrite, proc::RegionKind.Image, true)) {
			*out_err = std::SystemErrors.NoMemory;
			proc::as_destroy(&p->as);
			g_pages.free(cast<u32>(image), image_pages);
			proc::free_slot(p);
			return null;
		}

		// 3. The user stack: a guard page (stays None: running off the stack is an access
		//    violation) and USTACK_PAGES under it.
		var stack: u32 = g_pages.alloc(1 + proc::USTACK_PAGES);
		if (stack == 0) {
			*out_err = std::SystemErrors.NoMemory;
			proc::as_destroy(&p->as);
			proc::free_slot(p);
			return null;
		}

		std::memset(cast<void*>(stack), 0, (1 + proc::USTACK_PAGES) * PAGE_SIZE);
		if (not proc::as_map(&p->as, stack, 1 + proc::USTACK_PAGES, dr::cpu::Permissions.ReadWrite, proc::RegionKind.Stack, true)) {
			*out_err = std::SystemErrors.NoMemory;
			g_pages.free(stack, 1 + proc::USTACK_PAGES);
			proc::as_destroy(&p->as);
			proc::free_slot(p);
			return null;
		}
		dr::cpu::set_page_permissions(p->as.map, stack, PAGE_SIZE, dr::cpu::Permissions.None);   // the guard
		p->user_stack_top = stack + (1 + proc::USTACK_PAGES) * PAGE_SIZE - 4;           // the top word
		p->user_stack_size = proc::USTACK_PAGES * PAGE_SIZE;

		// 4. The kernel stack: the process's traps land here. Not in its map: None for it.
		p->kernel_stack = g_pages.alloc(proc::KSTACK_PAGES);
		if (p->kernel_stack == 0) {
			*out_err = std::SystemErrors.NoMemory;
			proc::as_destroy(&p->as);
			proc::free_slot(p);
			return null;
		}

		p->kernel_top = p->kernel_stack + proc::KSTACK_PAGES * PAGE_SIZE - 4;

		// 5. The trampoline: read and execute only, shared (not freed with the process).
		if (not proc::as_map(&p->as, proc::g_trampoline, 1, dr::cpu::Permissions.Read, proc::RegionKind.Shared, false)) {
			*out_err = std::SystemErrors.NoMemory;
			g_pages.free(p->kernel_stack, proc::KSTACK_PAGES);
			proc::as_destroy(&p->as);
			proc::free_slot(p);
			return null;
		}

		var argv_addr: u32 = 0;
		var user_sp: u32 = __internal::push_args(p, argc, argv, &argv_addr);
		build_start_frame(p, argc, argv_addr, user_sp);
		p->state = ProcessState.Ready;
		return p;
	}

	namespace __internal {
		sub as_check_user_permission(var as: proc::AddressSpace*, var ptr: u32, var size: u32, var permission: u8) -> bool {
			if (size == 0)
				return true;
			if (ptr + size < ptr)
				return false;                                                   // wraps around the address space
			var page: u32 = ptr & ~(PAGE_SIZE - 1);
			while (page < ptr + size) {
				if ((dr::cpu::page_permissions(as->map, page) & permission) == 0)
					return false;
				page += PAGE_SIZE;
			}
			return true;
		}

		sub trampoline_code(var out_start: u32*, var out_end: u32*) {
			var start: u32 = 0;
			var end: u32 = 0;
			low {
				mov R1, $__trampoline_start
				mov R2, $__trampoline_end
				mov $start, R1
				mov $end, R2
				jmp $__trampoline_end
			__trampoline_start:                 ## the process starts here: R1 = entry, R2 = argc, R3 = argv
				push R2                         ## argc
				push R3                         ## argv
				push 0x00000002                 ## the argument count (the DRX entry convention)
				call R1                         ## __ds_start → main(argc, argv); main's value in RV
				mov R8, RV                      ## the exit code
				mov R9, 0x00000010              ## Exit
				int 0x40                        ## doesn't return
				hlt                             ## (if it does: a privileged instruction fault, the kernel ends it)
			__trampoline_end:
			}
			*out_start = start;
			*out_end = end;
		}

		// TODO: This should go in a new std::path filesystem, kind of like a simpler version of std::filesystem in C++
		sub path_basename(var path: string, var out: u8*, var capacity: u32) {
			var start: u32 = 0;
			for (var i: u32 = 0; path[i] != 0; i++) {
				if (path[i] == '/')
					start = i + 1;
			}
			var n: u32 = 0;
			while (path[start + n] != 0 and n < capacity - 1) {
				out[n] = path[start + n];
				n++;
			}
			out[n] = 0;
		}
	}
}
