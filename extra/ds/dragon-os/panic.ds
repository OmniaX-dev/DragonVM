#import("dragon-sdk")

#include(video.ds)

var g_panicking: bool = false;

sub panic_begin(var title: string) {
	dr::disable_interrupts();
	if (g_panicking)
		halt_forever();
	vga::init_video();
	g_panicking = true;
	kernel_log("", true);
	kernel_log("*** KERNEL PANIC: ", false);
	kernel_log(title, true);
}

sub halt_forever() {
	while (true) low { hlt } // in a loop: in case eventually something can wake the CPU
}

sub panic(var msg: string) {
	panic_begin(msg);
	halt_forever();
}

inline sub kernel_assert(var cond: bool, var msg: string) {
	if (not cond) panic(msg);
}

// A failed assert(...) in the kernel: the panic screen, with where and what.
sub __assert_fail(var file: string, var line: u32, var condition: string, var message: string) {
	panic_begin("assertion failed");
	kernel_log(condition, false);
	kernel_log(" (", false);
	kernel_log(file, false);
	kernel_log(":", false);
	kernel_log(line, 10, false);
	kernel_log(")", true);
	if (message[0] != 0)
		kernel_log(message, true);
	halt_forever();
}
