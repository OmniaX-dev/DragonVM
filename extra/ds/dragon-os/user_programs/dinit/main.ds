#import("stdlib")

struct Str { var data: u8[20]; };

class Test {
	priv var str: Str;
	priv var num: u32;
	sub del() {}
	sub new(var a: u32, var b: const ref Str) {
		this->num = a;
		this->str = b;
	}
	readonly sub get() -> const ref Str {
		return this->str;
	}
	readonly sub get_num() -> u32 {
		return this->num;
	}
	sub set_num(var n: u32) { this->num = n; }
};

sub main() -> i32 {
	var str: std::String;
	while(true) {
		auto r = std::read_char();
		if (r > 0)
		{
			str.clear();
		 	str += cast<u8>(r);
			std::print(str, false);
		}
	}


	std::Random::auto_seed();
	var argv: string[1];
	var arg: u8[12];
	argv[0] = arg;
	std::strcpy(arg, "42");
	std::spawn("/bin/wingsh", 1, argv);
	std::strcpy(arg, "42");
	std::spawn("/bin/wingsh", 1, argv);
	var buff: u8[12];
	var child_count: u32 = 2;
    while (true) {
        var code: i32;
        var pid: i32 = std::wait(-1, &code);    // any child
        if (child_count > 0) child_count--;
        if (pid > 0)
        {
	        std::print("Process ", false); std::print(std::itoa(pid, buff), false);
	        std::print(" exited with code ", false); std::print(std::itoa(code, buff));
        }
        var j: i32 = std::Random::get_i32(0, 32 - child_count);
        for (var i: i32 = 0; i < j; i++)
        {
	        std::itoa(std::Random::get_i32(0, 100), arg);			// (argv[0] is arg)
	        var rv: i32 = std::spawn("/bin/wingsh", 1, argv);
			if (rv > 0) child_count++;
        }
    }
}
