#import(<dragon-sdk>)

#include(syscall.ds)
#include(video.ds)
#include(logging.ds)
#include(args.ds)
#include(memory.ds)
#include(kernel0.ds)
#include(panic.ds)
#include(process.ds)


sub init_stack_and_switch(var __kernel_main: sub()) {
	const stack_pages: u32 = 16;
	const stack_size: u32 = stack_pages * PAGE_SIZE;
	var stack: u32 = g_pages.alloc(stack_pages);
	kernel_assert(stack != 0, "Failed to allocate initial kernel stack.");
	dr::cpu::switch_stack(stack + stack_size - 4, stack_size, __kernel_main);
}

sub print_logo() {
	const LOGO_LINES: u8 = 17;
	var logo: string[LOGO_LINES] = {
	"===============================================",
	"              ______________",
	"        ,===:'.,            `-._",
	"             `:.`---.__         `-._",
	"               `:.     `--.         `.",
	"                 \\.        `.         `.",
	"         (,,(,    \\.         `.   ____,-`.,",
	"      (,'     `/   \\.   ,--.___`.'",
	"  ,  ,'  ,--.  `,   \\.;'         `",
	"   `{D, {    \\  :    \\;",
	"     V,,'    /  /    //",
	"     j;;    /  ,' ,-//.    ,---.      ,",
	"     \\;'   /  ,' /  _  \\  /  _  \\   ,'/",
	"           \\   `'  / \\  `'  / \\  `.' /",
	"            `.___,'   `.__,'   `.__,'",
	"===============================================",
	"Welcome to DragonOS! :)"
	};
	for (var i = 0; i < LOGO_LINES; i++)
		kernel_log(logo[i]);
}

sub main(var argc: i32, var argv: string*) -> i32 {
	init_interrupt_vector();
	init_video();
	kernel_assert(argc > 1, "Missing arguments to load the kernel.");
	print_logo();
	init_allocator(argc, argv);
	copy_args(g_heap, argc, argv);
	init_stack_and_switch(kernel_main);
	panic("Reached the end of main().");
}
