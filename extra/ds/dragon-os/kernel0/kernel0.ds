#import(<dragon-sdk>)

#define(KEY_BUFF_SIZE = 128)

var keyBuff: u32[KEY_BUFF_SIZE];
var keyRingBuff: dr::RingBuffer;
var pressedKey: u32 = 0;

sub main() {
	dr::vga_set_video_mode(dr::VGAVideoModes.Text16Color);
	dr::vga_enable_double_buffering(false);
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.KeyPressed, &key_pressed_handler);
	dr::Text16.clear_screen(dr::DefaultPaletteText16.Black);
	dr::Text16.print("Hello DragonOS :)", 0, 0, dr::DefaultPaletteText16.Blue, dr::DefaultPaletteText16.Black);

	keyRingBuff.init(keyBuff, sizeof(u32), KEY_BUFF_SIZE);
	var console: dr::Text16Console();
	var game: SnakeGame(&console, dr::DefaultPaletteText16.DarkGreen);
	game.mainLoop();
}

interrupt sub key_pressed_handler() {
	pressedKey = *cast<u32*>(dr::KeyboardRegisters.KeyCode);
	if (not keyRingBuff.push(&pressedKey))
	{
		//TODO: Handle missed key presses
	}
}

struct SnakeGame {
	priv enum Cell: u8 { Empty = 0, Snake, Food };

	priv var m_console: dr::Text16Console* = null;
	priv var m_board: u8* = null;
	priv var m_body: i32* = null;
	priv var m_board_w: u16 = 0;
	priv var m_board_h: u16 = 0;
	priv var m_capacity: u16 = 0;
	priv var m_head_index: i32 = 0;
	priv var m_tail_index: i32 = 0;
	priv var m_growth: i32 = 0;
	priv var m_direction_x: i32 = 1;
	priv var m_direction_y: i32 = 0;
	priv var m_valid: bool = false;
	priv var m_tick_delay: u32 = 150;
	priv var m_level: u32 = 1;
	priv var m_level_length: u32 = 8;
	priv var m_speedup: u32 = 12;
	priv var m_score: u32 = 0;
	priv var m_lastTime: u32 = 0;
	priv var m_backgroundColor: u8 = dr::DefaultPaletteText16.Black;
	priv var m_offset_x: u16 = 1;
	priv var m_offset_y: u16 = 2;
	priv var m_horizontalLine: u8* = null;

	sub new(var console: dr::Text16Console*, var bgcol: u8) {
		if (not console) return;
		this->m_console = console;
		this->m_board_w = (console->get_console_width() - this->m_offset_x - 1) / 2;
		this->m_board_h = console->get_console_height() - this->m_offset_y - 1;
		this->m_capacity = this->m_board_w * this->m_board_h;
		this->m_board = dr::malloc(this->m_capacity);
		if (not this->m_board) return;
		dr::memset(this->m_board, Cell.Empty, this->m_capacity);
		this->m_body = dr::malloc(this->m_capacity * sizeof(i32));
		if (not this->m_body) return;
		this->m_console->clear(bgcol);
		this->m_backgroundColor = bgcol;

		this->m_horizontalLine = dr::malloc((this->m_board_w * 2) + 1);
		if (not this->m_horizontalLine) return;
		for (var i: u16 = 0; i < this->m_board_w * 2; i++)
			this->m_horizontalLine[i] = dr::ASCII.BoxDoubleHorizontal;
		this->m_horizontalLine[this->m_board_w * 2] = '\0';
		this->draw_border();

		this->m_head_index = 0;
		this->m_tail_index = 0;
		this->m_body[0] = (this->m_board_h / 2) * this->m_board_w + this->m_board_w / 2;
		this->m_board[this->m_body[0]] = Cell.Snake;
		this->draw_cell(this->m_body[0], dr::ASCII.FullBlock, dr::DefaultPaletteText16.Yellow);
		this->m_growth = 3;
		this->place_food();

		this->m_valid = true;
	}
	sub mainLoop() {
		while(true) {
			if (dr::time::millis() - this->m_lastTime < this->m_tick_delay)
				continue;
			this->draw_top_bar();
			this->m_lastTime = dr::time::millis();
			if (!this->read_input())
				break;
			if (!this->game_tick())
				break;
			this->m_console->present();
		}
		while(true); //TODO: Temporary
	}

	inline priv sub next_slot(var index: i32) -> i32 {
		index++;
		if (index == this->m_capacity)
			index = 0;
		return index;
	}
	inline priv sub prev_slot(var index: i32) -> i32 {
		if (index == 0)
			return this->m_capacity - 1;
		return index - 1;
	}
	inline priv sub snake_len() -> i32 {
		var distance: i32 = this->m_head_index - this->m_tail_index;
		if (distance < 0)              // head has wrapped around past the end
			distance += this->m_capacity;
		return distance + 1;
	}
	priv sub draw_cell(var pos: i32, var symbol: u8, var col: u8) {
		var column: i32 = pos % this->m_board_w;
		var row: i32    = pos / this->m_board_w;
		this->m_console->store_colors()->bg(this->m_backgroundColor)->fg(col);
		this->m_console->xy(this->m_offset_x + column * 2, this->m_offset_y + row)->print(symbol)->print(symbol);
		this->m_console->restore_colors();
	}
	priv sub draw_top_bar() {
		for (var i: i32 = 0; i < this->m_console->get_console_width(); i++)
			this->m_console->xy(i, 0)->bg(dr::DefaultPaletteText16.DarkGreen)->fg(dr::DefaultPaletteText16.Yellow)->print(' ');
		this->m_console->xy(0, 0);
		this->m_console->print("Score: ")->print(this->m_score)->x(20)->print("Level: ")->print(this->m_level)->x(40)->print("Length: ")->print(this->snake_len());
	}
	priv sub draw_border() {
		var left: u16 = this->m_offset_x - 1;
		var right: u16 = this->m_offset_x + this->m_board_w * 2;
		var top: u16 = this->m_offset_y - 1;
		var bottom: u16 = this->m_offset_y + this->m_board_h;
		this->m_console->store_colors()->bg(dr::DefaultPaletteText16.DarkGreen)->fg(dr::DefaultPaletteText16.Lime);
		this->m_console->xy(left, top)->print(dr::ASCII.BoxDoubleDownRight)->print(this->m_horizontalLine)->print(dr::ASCII.BoxDoubleDownLeft);
		for (var y: u16 = top + 1; y < bottom; y++)
		{
			this->m_console->xy(left, y)->print(dr::ASCII.BoxDoubleVertical);
			this->m_console->xy(right, y)->print(dr::ASCII.BoxDoubleVertical);
		}
		this->m_console->xy(left, bottom)->print(dr::ASCII.BoxDoubleUpRight)->print(this->m_horizontalLine)->print(dr::ASCII.BoxDoubleUpLeft);
		this->m_console->restore_colors();
	}
	priv sub place_food() {
		var position: i32 = 0;
		do {
			position = dr::random::next() % this->m_capacity;
		} while (this->m_board[position] != Cell.Empty);

		this->m_board[position] = Cell.Food;
		this->draw_cell(position, dr::ASCII.FullBlock, dr::DefaultPaletteText16.Lime);
	}
	priv sub game_tick() -> i32 {
		this->m_score += this->m_level * this->snake_len();
		if (this->snake_len() / this->m_level_length == this->m_level)
		{
			if (this->m_tick_delay > this->m_speedup)
			{
				this->m_tick_delay -= this->m_speedup;
				this->m_level++;
			}
		}
		var head_position: i32 = this->m_body[this->m_head_index];
		var new_column: i32 = head_position % this->m_board_w + this->m_direction_x;
		var new_row: i32    = head_position / this->m_board_w + this->m_direction_y;
		if (new_column < 0 || new_column >= this->m_board_w || new_row < 0 || new_row >= this->m_board_h)
			return 0;
		var new_head_position: i32 = new_row * this->m_board_w + new_column;
		if (this->m_growth == 0) {
			var tail_position: i32 = this->m_body[this->m_tail_index];
			this->m_board[tail_position] = Cell.Empty;
			this->draw_cell(tail_position, ' ', dr::DefaultPaletteText16.Green);
			this->m_tail_index = this->next_slot(this->m_tail_index);
		}
		else
		{
			this->m_growth--;
		}
		if (this->m_board[new_head_position] == Cell.Snake)
			return 0;
		var ate_food: i32 = (this->m_board[new_head_position] == Cell.Food);
		this->m_head_index = this->next_slot(this->m_head_index);
		this->m_body[this->m_head_index] = new_head_position;
		this->m_board[new_head_position] = Cell.Snake;
		this->draw_cell(new_head_position, dr::ASCII.FullBlock, dr::DefaultPaletteText16.Yellow);
		if (this->snake_len() > 1)
			this->draw_cell(this->m_body[this->prev_slot(this->m_head_index)], dr::ASCII.FullBlock, dr::DefaultPaletteText16.Green);
		if (ate_food)
		{
			this->m_growth += 1;
			this->place_food();
		}
		return 1;
	}
	priv sub read_input() -> i32 {
		var chosen_x: i32 = this->m_direction_x;
		var chosen_y: i32 = this->m_direction_y;

		var key: u32 = 0;
		while (keyRingBuff.pop(&key)) {
			var key_x: i32 = 0;
			var key_y: i32 = 0;
			if (key == dr::KeyCodes.UpArrow)
				key_y = -1;
			else if (key == dr::KeyCodes.DownArrow)
				key_y = 1;
			else if (key == dr::KeyCodes.LeftArrow)
				key_x = -1;
			else if (key == dr::KeyCodes.RightArrow)
				key_x = 1;
			else if (key == dr::KeyCodes.LowerCase_q or key == dr::KeyCodes.UpperCase_Q)
				return 0;
			else continue;
			var is_reversal: i32 = (key_x == -this->m_direction_x && key_y == -this->m_direction_y);
			if (!is_reversal) {
				chosen_x = key_x;
				chosen_y = key_y;
			}
		}
		this->m_direction_x = chosen_x;
		this->m_direction_y = chosen_y;
		return 1;
	}
};
