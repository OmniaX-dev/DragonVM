#import("dragon-sdk")

#include(fault.ds)
#include(../sched/sched.ds)
#include(../sched/sys.ds)
#include(../dev/keyboard.ds)
#include(../fs/vfs.ds)

const MAX_PRINT_LEN = 512;
const SYSCALL: u32 										= 0x40;

const SYSCALL_EXIT: u32 								= 0x00_10;
const SYSCALL_PRINT: u32 								= 0x00_11;

const SYSCALL_GET_PID: u32 								= 0x01_00;
const SYSCALL_GET_PARENT_PID: u32 						= 0x01_01;
const SYSCALL_YIELD: u32 								= 0x01_02;
const SYSCALL_SPAWN: u32 								= 0x01_03;
const SYSCALL_WAIT: u32 								= 0x01_04;
const SYSCALL_SLEEP: u32 								= 0x01_05;
const SYSCALL_KILL: u32 								= 0x01_06;

const SYSCALL_ALLOC_PAGES: u32							= 0x02_00;
const SYSCALL_FREE_PAGES: u32							= 0x02_01;

const SYSCALL_READ_KEY: u32 							= 0x03_00;
// const SYSCALL_CONSOLE_CLEAR: u32						= 0x03_01;
// const SYSCALL_CONSOLE_SET_COLOR: u32					= 0x03_02;
// const SYSCALL_CONSOLE_SET_CURSOR: u32					= 0x03_03;

const SYSCALL_OPEN: u32 									= 0x04_00;
const SYSCALL_CLOSE: u32 								= 0x04_01;
const SYSCALL_READ: u32 									= 0x04_02;
const SYSCALL_WRITE: u32 								= 0x04_03;
const SYSCALL_SEEK: u32 									= 0x04_04;
const SYSCALL_TRUNCATE: u32 								= 0x04_05;
const SYSCALL_FSTAT: u32 								= 0x04_06;
const SYSCALL_STAT: u32 									= 0x04_07;
const SYSCALL_IOCTL: u32 								= 0x04_08;

// const SYSCALL_OPEN_DIR: u32 							= 0x05_00;
// const SYSCALL_READ_DIR: u32 							= 0x05_01;
// const SYSCALL_MAKE_DIR: u32 							= 0x05_02;
// const SYSCALL_REMOVE: u32 								= 0x05_03;
// const SYSCALL_RENAME: u32 								= 0x05_04;
// const SYSCALL_LINK: u32 								= 0x05_05;
// const SYSCALL_STAT_FS: u32 								= 0x05_06;

const SYSCALL_SYS_INFO: u32 							= 0x06_00;
const SYSCALL_PROCESS_LIST: u32 						= 0x06_01;

const SYSCALL_RANDOM: u32 								= 0x10_00;
const SYSCALL_RANDOM_F32: u32 							= 0x10_01;
const SYSCALL_SEED_RANDOM: u32 							= 0x10_02;
const SYSCALL_RANDOM_ENTROPY: u32 						= 0x10_03;

const SYSCALL_TIME_MILLIS: u32 							= 0x11_00;
const SYSCALL_TIME_CYCLES: u32 							= 0x11_01;
const SYSCALL_TIME_UNIX: u32 							= 0x11_02;

struct SavedRegisters {
	var r: u32[20];              // r[0] = R20 ... r[19] = R1   →  Rn = r[20 - n]
	inline sub R(var n: u32) -> u32 { return this->r[20 - n]; }
	inline sub set_R(var n: u32, var val: u32) { this->r[20 - n] = val; }
};

struct TrapFrame {               // at trap_frame() + 4
	var frame_size: u32;         // 1
	var fp: u32;                 // 2  interrupted code's FP
	var ip: u32;                 // 3
	var acc: u32;                // 4
	var pp: u32;                 // 5
	var regs: SavedRegisters;    // 6..25
	var argc: u32;               // 26
	var marker: u32;             // 27
	var fl: u32;                 // 28
	var offset: u32;             // 29
	var s2: u32;                 // 30
	var s1: u32;                 // 31
	var rv: u32;                 // 32
	var mode: u32;               // 33  0 = user
	var sp: u32;                 // 34
};
struct SyscallFrame {            // at trap_frame() + 4
	var frame_size: u32;         // 1
	var fp: u32;                 // 2  interrupted code's FP
	var ip: u32;                 // 3
	var acc: u32;                // 4
	var pp: u32;                 // 5
	var regs: SavedRegisters;    // 6..25
	var argc: u32;               // 26
	var marker: u32;             // 27
	var mode: u32;               // 28  0 = user
	var sp: u32;                 // 29
};
inline sub current_trap_frame() -> TrapFrame* { return cast<TrapFrame*>(dr::cpu::trap_frame() + 4); }
inline sub current_syscall_frame() -> SyscallFrame* { return cast<SyscallFrame*>(dr::cpu::trap_frame() + 4); }

namespace __internal {
	interrupt sub on_fault() { __on_fault(); }

	interrupt sub on_timer() {
        var frame: u32 = dr::cpu::trap_frame();
        if (proc::g_slice_left > 0) proc::g_slice_left--;        // every tick counts, in user mode or not
        if (proc::g_slice_left > 0 and proc::g_current != proc::g_idle) return;    // idle: look every tick
        if (not dr::cpu::trap_from_user(frame)) return;       // the kernel isn't preempted
        proc::g_current->frame = frame;
        if (proc::g_current != proc::g_idle)
            proc::g_current->state = proc::ProcessState.Ready;
        proc::schedule();
	}

	// After each screen redraw (the machine's screen_redraw_rate a second): only counted, for
	// /dev/video's GetVSyncCount. From user or kernel mode alike (nothing else to do).
	interrupt sub on_vsync() { video::g_vsync_count++; }

	interrupt sub on_syscall() {
		proc::g_current->frame = dr::cpu::trap_frame();
		var f: SyscallFrame* = current_syscall_frame();
		var function: u32 = f->regs.R(9);
		var rv: i32 = std::Ok;
		switch(function) {
			is SYSCALL_EXIT 							{ proc::process_exit(proc::g_current, cast<i32>(f->regs.R(8))); }
			is SYSCALL_PRINT 							{ rv = vga::sys_print(cast<string>(f->regs.R(8)), f->regs.R(7) != 0); }
// ===========================================================================
			is SYSCALL_GET_PID 							{ rv = proc::g_current->pid; }
			is SYSCALL_GET_PARENT_PID 					{ rv = proc::g_current->parent; }
			is SYSCALL_YIELD 							{ rv = 0; }
			is SYSCALL_SPAWN 							{ rv = proc::sys_spawn(f->regs.R(8), f->regs.R(7), f->regs.R(6), f->regs.R(5)); }	// path, argc, argv, flags
			is SYSCALL_WAIT 							{ rv = proc::sys_wait(cast<i32>(f->regs.R(8)), f->regs.R(7)); }
			is SYSCALL_SLEEP 							{ rv = proc::sys_sleep(f->regs.R(8)); }
			is SYSCALL_KILL 							{ rv = proc::sys_kill(f->regs.R(8), cast<i32>(f->regs.R(7))); }
// ===========================================================================
			is SYSCALL_ALLOC_PAGES 						{ rv = proc::sys_alloc_pages(f->regs.R(8)); }
			is SYSCALL_FREE_PAGES 						{ rv = proc::sys_free_pages(f->regs.R(8), f->regs.R(7)); }
// ===========================================================================
			is SYSCALL_READ_KEY 						{ rv = input::sys_read_key(f->regs.R(8), f->regs.R(7)); }
// ===========================================================================
			is SYSCALL_OPEN 							{ rv = vfs::sys_open(f->regs.R(8), f->regs.R(7)); }							// path, mode
			is SYSCALL_CLOSE 							{ rv = vfs::sys_close(f->regs.R(8)); }										// fd
			is SYSCALL_READ 							{ rv = vfs::sys_read(f->regs.R(8), f->regs.R(7), f->regs.R(6)); }			// fd, buffer, size
			is SYSCALL_WRITE 							{ rv = vfs::sys_write(f->regs.R(8), f->regs.R(7), f->regs.R(6)); }			// fd, data, size
			is SYSCALL_SEEK 							{ rv = vfs::sys_seek(f->regs.R(8), cast<i32>(f->regs.R(7)), f->regs.R(6)); }	// fd, offset, from
			is SYSCALL_TRUNCATE 						{ rv = vfs::sys_truncate(f->regs.R(8), f->regs.R(7)); }						// fd, size
			is SYSCALL_FSTAT 							{ rv = vfs::sys_fstat(f->regs.R(8), f->regs.R(7)); }						// fd, out
			is SYSCALL_STAT 							{ rv = vfs::sys_stat(f->regs.R(8), f->regs.R(7)); }							// path, out
			is SYSCALL_IOCTL 							{ rv = vfs::sys_ioctl(f->regs.R(8), f->regs.R(7), f->regs.R(6)); }			// fd, command, arg
// ===========================================================================
			is SYSCALL_SYS_INFO 						{ rv = proc::sys_sysinfo(f->regs.R(8)); }
			is SYSCALL_PROCESS_LIST 					{ rv = proc::sys_process_list(f->regs.R(8), f->regs.R(7)); }
// ===========================================================================
			is SYSCALL_RANDOM 							{ rv = proc::sys_random(); }				// (the caller's own generator)
			is SYSCALL_RANDOM_F32 						{ rv = proc::sys_random_f32(); }
			is SYSCALL_SEED_RANDOM 						{ rv = proc::sys_seed_random(f->regs.R(8)); }
			is SYSCALL_RANDOM_ENTROPY 					{ rv = *cast<u32*>(dr::RandomRegisters.Entropy); }
// ===========================================================================
			is SYSCALL_TIME_MILLIS 						{ rv = *cast<u32*>(dr::TimerRegisters.Milliseconds); }
			is SYSCALL_TIME_CYCLES 						{ rv = *cast<u32*>(dr::TimerRegisters.CyclesLow); }
			is SYSCALL_TIME_UNIX 						{ rv = *cast<u32*>(dr::TimerRegisters.UnixTime); }
// ===========================================================================
			else 										{ rv = std::SystemErrors.NoSuchCall; }
		}
		if (proc::g_slice_left == 0 or function == SYSCALL_YIELD) {
		    proc::g_current->rv = cast<u32>(rv);                 // switch_to puts it in RV when it runs again
		    proc::g_current->state = proc::ProcessState.Ready;
		    proc::schedule();                                    // doesn't return
		}
		low { mov RV, $rv }
	}
}

sub init_interrupt_vector() {
	for (var v: u8 = 0; v <= dr::cpu::Faults.General; v++)
		dr::set_interrupt_vector_entry(v, &__internal::on_fault);
	dr::set_interrupt_vector_entry(SYSCALL, &__internal::on_syscall, true);
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.Timer, &__internal::on_timer);
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.VSync, &__internal::on_vsync);
}
