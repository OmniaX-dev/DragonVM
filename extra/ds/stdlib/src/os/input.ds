// The keyboard: key events from the kernel (ReadKey). Characters for text, presses and releases
// for the keys that type nothing (arrows, F-keys, ctrl+...).
//
//     var c: i32 = std::read_char();          // waits for the next character
//     var e: std::KeyEvent;
//     if (std::read_key(&e, false) >= 0 and e.kind == std::KeyEventKinds.Pressed and e.code == std::data::KeyCodes.UpArrow) ...
#include(syscall.ds)

namespace std {
	const KeyEventKinds: struct {
		var Pressed: u32 = 1;
		var Released: u32 = 2;
		var Text: u32 = 3;				// code: the character the key typed (shift, caps lock applied)
	};
	// read_key's kinds: the events wanted (the others are dropped); 0: Pressed and Text.
	const KeyKinds: struct {
		var Pressed: u32 = 1 << 1;
		var Released: u32 = 1 << 2;
		var Text: u32 = 1 << 3;
		var All: u32 = (1 << 1) | (1 << 2) | (1 << 3);
	};
	// KeyEvent.modifiers
	const KeyModifiers: struct {
		var LeftShift: u32 = 1 << 0;
		var LeftCtrl: u32 = 1 << 1;
		var LeftAlt: u32 = 1 << 2;
		var LeftSuper: u32 = 1 << 3;
		var RightShift: u32 = 1 << 4;
		var RightCtrl: u32 = 1 << 5;
		var RightAlt: u32 = 1 << 6;
		var RightSuper: u32 = 1 << 7;
		var CapsLock: u32 = 1 << 8;
		var NumLock: u32 = 1 << 9;
		var ScrollLock: u32 = 1 << 10;
		var Shift: u32 = (1 << 0) | (1 << 4);
		var Ctrl: u32 = (1 << 1) | (1 << 5);
		var Alt: u32 = (1 << 2) | (1 << 6);
	};

	struct KeyEvent {
		var code: u32;				// std::data::KeyCodes (a Text event: the character)
		var modifiers: u32;			// KeyModifiers
		var kind: u32;				// KeyEventKinds

		// From the kernel's word: bits 0-15 the code, 16-26 the modifiers, 27-28 the kind.
		sub new(var word: u32 = 0) {
			this->code = word & 0xFFFF;
			this->modifiers = (word >> 16) & 0x7FF;
			this->kind = (word >> 27) & 3;
		}
		readonly inline sub has(var modifiers: u32) -> bool { return (this->modifiers & modifiers) != 0; }
	};

	// The next key event of these kinds (KeyKinds; 0: Pressed and Text) into out. wait: blocks
	// until one comes; otherwise SystemErrors.WouldBlock when there is none. 0, or an error.
	sub read_key(var out: ref KeyEvent, var wait: bool = true, var kinds: u32 = 0) -> i32 {
		var r: i32 = syscall4(SystemCalls.ReadKey, wait ? 1 : 0, kinds);
		if (r < 0)
			return r;
		out.new(cast<u32>(r));
		return 0;
	}

	// The next character typed (waits for it; wait false: WouldBlock when there is none), or an error.
	sub read_char(var wait: bool = true) -> i32 {
		var r: i32 = syscall4(SystemCalls.ReadKey, wait ? 1 : 0, KeyKinds.Text);
		return r < 0 ? r : r & 0xFFFF;
	}
}
