// System calls: how a DragonOS program asks the kernel for things (int 0x40, the function in R9,
// its arguments in R8, R7, ...; the result in RV).
#import("libcore")

namespace std {
	enum SystemCalls: u32 {
		Exit = 0x0010,
		Print = 0x0011,

		GetPid = 0x0100,
		GetParentPid = 0x0101,
		Yield = 0x0102,
		Spawn = 0x0103,
		Wait = 0x0104,
		Sleep = 0x0105,
		Kill = 0x0106,

		AllocPages = 0x0200,
		FreePages = 0x0201,

		ReadKey = 0x0300,
		ConsoleClear = 0x0301,
		ConsoleSetColor = 0x0302,
		ConsoleSetCursor = 0x0303,

		Open = 0x0400,
		Close = 0x0401,
		Read = 0x0402,
		Write = 0x0403,
		Seek = 0x0404,
		Truncate = 0x0405,
		FStat = 0x0406,
		Stat = 0x0407,

		OpenDir = 0x0500,
		ReadDir = 0x0501,
		MakeDir = 0x0502,
		Remove = 0x0503,
		Rename = 0x0504,
		Link = 0x0505,
		StatFs = 0x0506,

		SysInfo = 0x0600,
		ProcessList = 0x0601,

		Random = 0x1000,
		RandomF32 = 0x1001,
		SeedRandom = 0x1002,
		RandomEntropy = 0x1003,

		TimeMillis = 0x1100,
		TimeCycles = 0x1101,
		TimeUnix = 0x1102,
	};

	// A system call with up to 4 arguments (R8, R7, R6, R5; the unused ones are 0) and its result
	// (RV): >= 0 a value (an fd, a count, a pid, ...), < 0 an error. Pointers and strings go as
	// cast<u32>(p). The typed wrappers (std::fs::open, ...) are one line on top of it:
	//     return syscall4(SystemCalls.Open, cast<u32>(path), mode);
	sub syscall4(var function: u32, var a: u32 = 0, var b: u32 = 0, var c: u32 = 0, var d: u32 = 0) -> i32 {
		var rv: i32 = 0;
		low {
			mov R9, $function
			mov R8, $a
			mov R7, $b
			mov R6, $c
			mov R5, $d
			int 0x40
			mov $rv, RV
		}
		return rv;
	}
	// TODO: out_rv should be i32*
	sub syscall(var function: u32, var out_rv: u32*, ...typed) -> bool {
		var l_is_simple_call = sub(var fn: u32) -> bool {
			return fn == SystemCalls.Random or
				   fn == SystemCalls.RandomF32 or
				   fn == SystemCalls.TimeMillis or
				   fn == SystemCalls.TimeCycles or
				   fn == SystemCalls.TimeUnix;
		};
		var args: VaList(va_start(), va_count(), va_types());
		var null_rv: u32 = 0;
		if (not out_rv)
			out_rv = &null_rv;
		if (l_is_simple_call(function))
		{
			low {
				mov R9, $function
				int 0x40
				mov [$out_rv], RV
			}
			return true;
		}
		if (args.count <= 4)
			*out_rv = syscall4(function, args.get_u32(0), args.get_u32(1), args.get_u32(2), args.get_u32(3));
		else return false; // TODO: Add cases when new syscalls with more than 4 parameter exist
		return true;
	}

	inline sub print(var path: const ref std::String, var nl: bool = true) -> i32 {
    	return syscall4(SystemCalls.Print, cast<u32>(path.c_str()), (nl ? 1 : 0));
	}

	inline sub random_entropy() -> u32 {
		return cast<u32>(syscall4(SystemCalls.RandomEntropy));
	}
}
