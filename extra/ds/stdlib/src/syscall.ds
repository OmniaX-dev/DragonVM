// System calls: how a DragonOS program asks the kernel for things (int 0x40, the function in R9,
// its arguments in R8, R7, ...; the result in RV).
#import(<libcore>)

namespace std {
	enum SystemCalls: u32 {
		Exit = 0x0010,
		Print = 0x0011,

		Random = 0x1000,
		RandomF32 = 0x1001,
		SeedRandom = 0x1002,

		TimeMillis = 0x1100,
		TimeCycles = 0x1101,
		TimeUnix = 0x1102,
	};

	// A system call with up to 4 arguments (R8, R7, R6, R5; the unused ones are 0) and its result
	// (RV): >= 0 a value (an fd, a count, a pid, ...), < 0 an error. Pointers and strings go as
	// cast<u32>(p). The typed wrappers (std::fs::open, ...) are one line on top of it:
	//     return syscall4(SystemCalls.Open, cast<u32>(path), mode);
	sub syscall4(var function: u32, var a: u32 = 0, var b: u32 = 0, var c: u32 = 0, var d: u32 = 0) -> i32 {
		var rv: i32 = 0;
		low {
			mov R9, $function
			mov R8, $a
			mov R7, $b
			mov R6, $c
			mov R5, $d
			int 0x40
			mov $rv, RV
		}
		return rv;
	}

	sub syscall(var function: u32, var out_rv: u32*, ...typed) -> bool {
		var l_is_simple_call = sub(var fn: u32) -> bool {
			return fn == SystemCalls.Random or
				   fn == SystemCalls.RandomF32 or
				   fn == SystemCalls.TimeMillis or
				   fn == SystemCalls.TimeCycles or
				   fn == SystemCalls.TimeUnix;
		};
		var args: VaList(va_start(), va_count(), va_types());
		var null_rv: u32 = 0;
		if (not out_rv)
			out_rv = &null_rv;
		if (l_is_simple_call(function))
		{
			low {
				mov R9, $function
				int 0x40
				mov [$out_rv], RV
			}
			return true;
		}
		else if (function == SystemCalls.Print) //TODO: Eventually put each branch in an __internal:: dedicated function
		{
			if (args.count == 0) return false;
			else {
				if (args.type_of(0) != VaTypes.String) return false;
				var str: u8* = args.get_string(0);
				var nl: u32 = 0;
				if (args.count > 1 and args.get_bool(1))
					nl = 1;
				low {
					mov R9, $function
					mov R8, $str
					mov R7, $nl
					int 0x40
				}
				*out_rv = 0;
				return true;
			}
		}
		else if (function == SystemCalls.Exit)
		{
			// The process ends: the exit code (default 0) goes to the kernel. Doesn't return.
			var code: i32 = 0;
			if (args.count > 0)
				code = args.get_i32(0);
			low {
				mov R9, $function
				mov R8, $code
				int 0x40
			}
			return false;		// (only if the kernel didn't end the process)
		}
		else if (function == SystemCalls.SeedRandom)
		{
			if (args.count == 0) return false;
			var seed: i32 = args.get_i32(0);
			low {
				mov R9, $function
				mov R8, $seed
				int 0x40
			}
			*out_rv = 0;
			return true;
		}
		return false;
	}
}
