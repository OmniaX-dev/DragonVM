
namespace std {
	namespace rand {
		namespace engine {
			interface Engine {
				sub seed(var s: u32);
				sub next() -> u32;
			};
			class Sfc32 impl Engine {
				priv var a: u32;
				priv var b: u32;
				priv var c: u32;
				priv var d: u32;
				override sub seed(var s: u32) {
					var sm: __internal::SplitMix32 = { s };
					this->a = sm.next(); this->b = sm.next(); this->c = sm.next();
					this->d = 1;
					for (var i = 0; i < 12; ++i) this->next();
				}
				override sub next() -> u32 {
					var t: u32 = this->a + this->b + this->d++;
					this->a = this->b ^ (this->b >> 9);
					this->b = this->c + (this->c << 3);
					this->c = __internal::rotl32(this->c, 21) + t;
					return t;
				}
			};
			class Xoshiro128ss impl Engine {
				priv var s: u32[4];
				override sub seed(var s: u32) {
					var sm: __internal::SplitMix32 = { s };
					for (var i = 0; i < 4; ++i) this->s[i] = sm.next();
				}
				override sub next() -> u32 {
					var r: u32 = __internal::rotl32(this->s[1] * 5, 7) * 9;
					var t: u32 = this->s[1] << 9;
					this->s[2] ^= this->s[0];
					this->s[3] ^= this->s[1];
					this->s[1] ^= this->s[2];
					this->s[0] ^= this->s[3];
					this->s[2] ^= t;
					this->s[3] = __internal::rotl32(this->s[3], 11);
					return r;
				}
			};
			class MT19937 impl Engine {
				constexpr N: i32 = 624;
				constexpr M: i32 = 397;
				priv var mt: u32[N];
				priv var idx: i32;
				override sub seed(var s: u32) {
					this->mt[0] = s;
					for (var i = 1; i < N; ++i)
						this->mt[i] = 1812433253u * (this->mt[i - 1] ^ (this->mt[i - 1] >> 30)) + cast<u32>(i);
					this->idx = N;
				}
				sub twist() {
					for (var i = 0; i < N; ++i) {
						var y: u32 = (this->mt[i] & 0x80000000u) | (this->mt[(i + 1) % N] & 0x7FFFFFFFu);
						var v: u32 = this->mt[(i + M) % N] ^ (y >> 1);
						if (y & 1) v ^= 0x9908B0DFu;
						this->mt[i] = v;
					}
					this->idx = 0;
				}
				override sub next() -> u32 {
					if (this->idx >= N) this->twist();
					var y: u32 = this->mt[this->idx++];
					y ^= y >> 11;
					y ^= (y << 7)  & 0x9D2C5680u;
					y ^= (y << 15) & 0xEFC60000u;
					y ^= y >> 18;
					return y;
				}
			};
		}

		template(T) where (size_of(T) <= 4 and is_integer(T)) or is_type(T, f32) {
			struct UniformDistribution {
				if constexpr (is_type(T, f32))
				{
					priv var lo: f32;
					priv var span: f32;
				}
				else
				{
					priv var base: u32;
					priv var range: u32;
					priv var mask: u32;
				}

				sub set(var lo: T, var hi: T) {
					if constexpr (is_type(T, f32)) {
						this->lo = lo;
						this->span = hi - lo;
					}
					else
					{
						this->base  = cast<u32>(lo);
						this->range = cast<u32>(hi) - this->base;
						var m: u32 = this->range;
						m |= m >> 1;  m |= m >> 2;  m |= m >> 4;
						m |= m >> 8;  m |= m >> 16;
						this->mask = m;
					}
				}
				if constexpr (is_type(T, f32)) { static sub unit(var rng: ref engine::Engine) -> T {
					var bits: u32 = 0x3F800000u | (rng.next() >> 9);
					var f: f32 = bitcast<f32>(bits);
					return f - 1.0f;
				}}
				readonly sub next(var rng: ref engine::Engine) -> T {
					if constexpr (is_type(T, f32)) {
						var hi: f32 = this->lo + this->span;
						var x: f32;
						do { x = this->lo + this->span * UniformDistribution::unit(rng); } while (x >= hi);
						return x;
					}
					else
					{
						var r: u32;
						do { r = rng.next() & this->mask; } while (r > this->range);
						return cast<T>(this->base + r);
					}
				}
			};
		}

		template(T, Seed: u32 = 0) where ((size_of(T) <= 4 and is_integer(T)) or is_type(T, f32)) {
			sub uniform_distribution(var min: T, var max: T) -> T {
				static var rng: engine::Sfc32;
				static var seeded: bool = false;
				if (not seeded) { rng.seed(Seed); seeded = true; }
				var dist: UniformDistribution<T>;
				dist.set(min, max);
				return dist.next(rng);
			}
			sub uniform_distribution(var min: T, var max: T, var rng: ref engine::Engine) -> T {
				var dist: UniformDistribution<T>;
				dist.set(min, max);
				return dist.next(rng);
			}
		}

		namespace __internal {
			struct SplitMix32 {
				var m_state: u32;

				sub next() -> u32 {
					var z: u32 = (this->m_state += 0x9E3779B9u);
					z ^= z >> 16; z *= 0x21F0AAADu;
					z ^= z >> 15; z *= 0x735A2D97u;
					z ^= z >> 15;
					return z;
				}
			};

			constexpr sub rotl32(var x: u32, var k: i32) -> u32 { return (x << k) | (x >> (32 - k)); }
		}

		template(E) where is_base_of(engine::Engine, E) {
			struct RandomGenerator {
				priv var m_seed: u32 = 0;
				priv var m_rng: E;

				sub new(var seed: u32) { this->seed(seed); }

				inline sub seed(var seed: u32) { this->m_rng.seed(seed); this->m_seed = seed; }
				inline sub get_seed() -> u32 { return this->m_seed; }

				inline sub get_f32(var min: f32 = 0.0f, var max: f32 = 1.0f) -> f32 { return this->__get<f32>(min, max); }
				inline sub get_i8(var min: i8 = std::INT8_MIN, var max: i8 = std::INT8_MAX) -> i8 { return this->__get<i8>(min, max); }
				inline sub get_u8(var min: u8 = std::UINT8_MIN, var max: u8 = std::UINT8_MAX) -> u8 { return this->__get<u8>(min, max); }
				inline sub get_i16(var min: i16 = std::INT16_MIN, var max: i16 = std::INT16_MAX) -> i16 { return this->__get<i16>(min, max); }
				inline sub get_u16(var min: u16 = std::UINT16_MIN, var max: u16 = std::UINT16_MAX) -> u16 { return this->__get<u16>(min, max); }
				inline sub get_i32(var min: i32 = std::INT32_MIN, var max: i32 = std::INT32_MAX) -> i32 { return this->__get<i32>(min, max); }
				inline sub get_u32(var min: u32 = std::UINT32_MIN, var max: u32 = std::UINT32_MAX) -> u32 { return this->__get<u32>(min, max); }

				inline sub get_bool(var true_percentage: f32 = 0.5f) -> bool { return this->get_f32() >= (1.0f - std::math::clamp(true_percentage, 0.0f, 1.0f)); }

				template(T) where is_numeric(T) {
					priv sub swap_if_first_is_bigger(var n1: T*, var n2: T*) {
						if (*n1 <= *n2) return;
						var n3: T = *n1;
						*n1 = *n2;
						*n2 = n3;
					}
					priv sub __get(var min: T, var max: T) -> T {
						if (min == max) return min;
						this->swap_if_first_is_bigger<T>(&min, &max);
						return std::rand::uniform_distribution<T>(min, max, this->m_rng);
					}
				}
			};// TODO: Eventually add get_from_vector, noise_gen, get_string, etc.
		}
	}
}
