// stack.ds - std::BasicStack<T, A>: last in, first out (a BasicVector underneath; A as there).
//
//     var s: std::Stack<u32>;
//     s.push(1); s.push(2);
//     s.pop();        // 2
//     s.top();        // a pointer to 1
namespace std {
	template(T, A) {
		struct BasicStack {
			priv var m_items: BasicVector<T, A>;

			// false: no memory (v is destroyed).
			sub push(var v: own T) -> bool {
				var ok: bool = this->m_items.push(take(&v));		// (moved on: push owns it now)
				forget(v);
				return ok;
			}
			// The top value, moved out (the stack must not be empty).
			inline sub pop() -> T { return this->m_items.pop(); }
			// The top value (the stack must not be empty).
			inline sub top() -> T* { return this->m_items.back(); }
			readonly inline sub size() -> u32 { return this->m_items.size(); }
			readonly inline sub empty() -> bool { return this->m_items.empty(); }
			inline sub clear() { this->m_items.clear(); }
			inline sub reserve(var n: u32) -> bool { return this->m_items.reserve(n); }
			// Bottom to top.
			readonly inline sub begin() -> u32 { return 0; }
			readonly inline sub end() -> u32 { return this->m_items.size(); }
			readonly inline sub next(var i: u32) -> u32 { return i + 1; }
			inline sub get(var i: u32) -> T* { return this->m_items.at(i); }
		};
	}
}
