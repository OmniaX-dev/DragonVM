#include(int64.ds)

namespace std {

	template(T) where is_unsigned(T) or is_type(T, U64) {
		struct BitField {
			priv var m_value: T;

			inline sub set(var mask: T) {
				if constexpr (is_type(T, U64))
					this->m_value.bor(mask);
				else
					this->m_value |= mask;
			}
			inline sub clr(var mask: T) {
				if constexpr (is_type(T, U64))
					this->m_value.band(mask.new_bnot());
				else
					this->m_value &= ~mask;
			}
			inline sub val(var mask: T, var value: bool) {
				if (value) this->set(mask);
				else this->clr(mask);
			}
			inline sub tgl(var mask: T) {
				if constexpr (is_type(T, U64))
					this->m_value.bxor(mask);
				else
					this->m_value ^= mask;
			}
			inline sub get(var mask: T) -> bool {
				if constexpr (is_type(T, U64))
					return this->m_value.new_band(mask).eq(mask);
				else
					return (this->m_value & mask) == mask;
			}
		};
	}

	alias BitField8 = BitField<u8>;
	alias BitField16 = BitField<u16>;
	alias BitField32 = BitField<u32>;
	alias BitField64 = BitField<U64>;

	// value as text, with `decimals` digits after the point (0..9, rounded): -12.500000. From
	// 1e9 on, in scientific notation: 1.234568e+12. Also "inf", "-inf", "nan" (and -0.000000).
	// result needs 24 bytes. An f32 has about 7 significant digits (and this is computed in
	// f32): the digits after those are not meaningful.
	sub ftoa(var value: f32, var result: u8*, var decimals: u32 = 6) -> string {
		var p: u8* = result;
		if (value != value) {
			p[0] = 'n'; p[1] = 'a'; p[2] = 'n'; p[3] = 0;
			return result;
		}
		if ((*cast<u32*>(&value) & 0x80000000) != 0) {		// also -0.0
			*p = '-';
			p++;
			value = -value;
		}
		if (value == 1.0 / 0.0) {
			p[0] = 'i'; p[1] = 'n'; p[2] = 'f'; p[3] = 0;
			return result;
		}
		if (decimals > 9)
			decimals = 9;
		var exponent: u32 = 0;
		var scientific: bool = value >= 1e9;
		if (scientific) {
			while (value >= 10.0) {
				value /= 10.0;
				exponent++;
			}
		}
		var half: f32 = 0.5;
		for (var i: u32 = 0; i < decimals; i++)
			half /= 10.0;
		value += half;
		if (scientific and value >= 10.0) {
			value /= 10.0;
			exponent++;
		}
		var whole: u32 = cast<u32>(value);
		var frac: f32 = value - whole;
		utoa(whole, p);
		while (*p != 0)
			p++;
		if (decimals > 0) {
			*p = '.';
			p++;
			for (var i: u32 = 0; i < decimals; i++) {
				frac *= 10.0;
				var digit: u32 = cast<u32>(frac);
				if (digit > 9)
					digit = 9;
				*p = cast<u8>('0' + digit);
				p++;
				frac -= digit;
			}
		}
		if (scientific) {
			p[0] = 'e';
			p[1] = '+';
			p += 2;
			if (exponent < 10) {
				*p = '0';
				p++;
			}
			utoa(exponent, p);
			while (*p != 0)
				p++;
		}
		*p = 0;
		return result;
	}

	sub itoa(var value: i32, var result: u8*, var base: i32 = 10) -> string
	{
		// check that the base if valid
		if (base < 2 or base > 36) { *result = '\0'; return result; }

		var ptr: u8* = result;
		var ptr1: u8* = result;
		var tmp_char: u8;
		var tmp_value: i32;

		do {
			tmp_value = value;
	        value /= base;
	        *ptr++ = "zyxwvutsrqponmlkjihgfedcba9876543210123456789abcdefghijklmnopqrstuvwxyz" [35 + (tmp_value - value * base)];
	    } while (value);

		// Apply negative sign
	    if (tmp_value < 0) *ptr++ = '-';
	    *ptr-- = '\0';

	    // Reverse the string
	    while(ptr1 < ptr) {
	        tmp_char = *ptr;
	        *ptr--= *ptr1;
	        *ptr1++ = tmp_char;
	    }
	    return result;
	}

	// Like itoa, for an unsigned integer (result: up to 33 bytes, in base 2; 11 in base 10).
	sub utoa(var value: u32, var result: u8*, var base: i32 = 10) -> string
	{
		// check that the base if valid
		if (base < 2 or base > 36) { *result = '\0'; return result; }

		var ubase: u32 = cast<u32>(base);
		var ptr: u8* = result;
		var ptr1: u8* = result;
		var tmp_char: u8;

		do {
			*ptr++ = "0123456789abcdefghijklmnopqrstuvwxyz" [value % ubase];
			value /= ubase;
		} while (value);
		*ptr-- = '\0';

		// Reverse the string
		while (ptr1 < ptr) {
			tmp_char = *ptr;
			*ptr-- = *ptr1;
			*ptr1++ = tmp_char;
		}
		return result;
	}

	// The opposites of utoa, itoa and ftoa: text to a number. True when the whole text is the
	// number (spaces before and after are allowed), *out then has it; false when it isn't a number
	// or (atou, atoi) it doesn't fit, *out unchanged. base: 2..36, or 0: from the prefix ("0x"
	// hex, "0b" binary, "0o" octal, otherwise decimal). Base 16 also takes a "0x" prefix.

	// "4096", "0x1000", "  12 " (no sign).
	sub atou(var text: string, var out: u32*, var base: i32 = 10) -> bool {
		var p: u8* = text;
		while (__internal::isspace(*p))
			p++;
		var b: u32 = __internal::number_base(&p, base);
		if (b == 0)
			return false;
		return __internal::parse_digits(&p, b, 0xFFFFFFFF, out);
	}

	// "-12", "+7", "-0x80000000" (-2147483648..2147483647).
	sub atoi(var text: string, var out: i32*, var base: i32 = 10) -> bool {
		var p: u8* = text;
		while (__internal::isspace(*p))
			p++;
		var negative: bool = *p == '-';
		if (*p == '-' or *p == '+')
			p++;
		var b: u32 = __internal::number_base(&p, base);
		if (b == 0)
			return false;
		var magnitude: u32 = 0;
		if (not __internal::parse_digits(&p, b, negative ? 0x80000000 : 0x7FFFFFFF, &magnitude))
			return false;
		*out = negative ? cast<i32>(0 - magnitude) : cast<i32>(magnitude);
		return true;
	}

	// "3.5", "-0.25", ".5", "2.", "1e9", "1.5E-3", "inf", "-inf", "nan" (what ftoa writes). Computed
	// in f32 (about 7 significant digits); too big gives inf, too small 0.
	sub atof(var text: string, var out: f32*) -> bool {
		var p: u8* = text;
		while (__internal::isspace(*p))
			p++;
		var negative: bool = *p == '-';
		if (*p == '-' or *p == '+')
			p++;
		var value: f32 = 0.0;
		if (p[0] == 'i' and p[1] == 'n' and p[2] == 'f') {
			value = 1.0 / 0.0;
			p += 3;
		} else if (p[0] == 'n' and p[1] == 'a' and p[2] == 'n') {
			value = 0.0 / 0.0;
			p += 3;
		} else {
			// The first 9 significant digits in an integer (exact), the others only move the point.
			var mantissa: u32 = 0;
			var digits: u32 = 0;
			var exponent: i32 = 0;
			var any: bool = false;
			while (*p >= '0' and *p <= '9') {
				if (digits < 9) {
					mantissa = mantissa * 10 + (*p - '0');
					if (mantissa != 0)
						digits++;
				} else {
					exponent++;
				}
				any = true;
				p++;
			}
			if (*p == '.') {
				p++;
				while (*p >= '0' and *p <= '9') {
					if (digits < 9) {
						mantissa = mantissa * 10 + (*p - '0');
						if (mantissa != 0)
							digits++;
						exponent--;
					}
					any = true;
					p++;
				}
			}
			if (not any)
				return false;
			if (*p == 'e' or *p == 'E') {
				p++;
				var e: i32 = 0;
				var q: u8* = p;
				var eNegative: bool = *q == '-';
				if (*q == '-' or *q == '+')
					q++;
				if (*q < '0' or *q > '9')
					return false;
				while (*q >= '0' and *q <= '9') {
					if (e < 1000)
						e = e * 10 + (*q - '0');
					q++;
				}
				exponent += eNegative ? -e : e;
				p = q;
			}
			// 10^|exponent| by squaring (fewer roundings than one multiplication per digit).
			value = cast<f32>(mantissa);
			if (mantissa != 0 and exponent != 0) {
				var n: u32 = cast<u32>(exponent < 0 ? -exponent : exponent);
				if (n > 100)
					n = 100;						// enough for inf or 0 (f32: 1e-45..3.4e38)
				var scale: f32 = 1.0;
				var power: f32 = 10.0;
				while (n != 0) {
					if ((n & 1) != 0)
						scale *= power;
					power *= power;
					n >>= 1;
				}
				if (exponent < 0)
					value /= scale;
				else
					value *= scale;
			}
		}
		while (__internal::isspace(*p))
			p++;
		if (*p != 0)
			return false;
		*out = negative ? -value : value;
		return true;
	}

	inline sub isprint(var c: u32) -> bool {
		return c >= 0x20 && c <= 0x7E;
	}

	sub format_size(var bytes: u32, var out: u8*, var skipUnit: bool = false, var forceUnit: i32 = -1) -> i32 {
		const __units: string[] = { "B", "KiB", "MiB", "GiB" };
		var write_u32 = sub(var p: u8*, var n: u32) -> u8* {
			var tmp: u8[10];
			var i: i32 = 0;
			do {
				tmp[i++] = cast<u8>('0' + n % 10);
				n /= 10;
			} while(n);
			while (i)
				*p++ = tmp[--i];
			return p;
		};
		var p: u8* = out;
		var unit: u32 = 0;
		if (forceUnit >= 0)
		{
			unit = cast<u32>(forceUnit);
			if (unit > 3)
				unit = 3;
		}
		else
		{
			while (unit < 3 && bytes >= (1 << (10 * (unit + 1))))
				unit++;
		}
		if (unit == 0)
		{
			p = write_u32(p, bytes);
		}
		else
		{
			var shift: u32 = 10 * unit;
			var whole: u32 = bytes >> shift;
			var frac: u32 = (bytes >> (shift - 10)) & 1023;
			var tenths: u32 = (frac * 10 + 512) >> 10;

			if (tenths == 10)
			{
				tenths = 0;
				whole++;
				if (whole == 1024 && unit < 3 && forceUnit < 0)
				{
					whole = 1;
					unit++;
				}
			}
			p = write_u32(p, whole);
			*p++ = '.';
			*p++ = cast<u8>('0' + tenths);
		}
		if (!skipUnit)
		{
			*p++ = ' ';
			for (var u: u8* = __units[unit]; *u; )
				*p++ = *u++;
		}
		*p = '\0';
		return cast<i32>(p - out);
	}

	namespace __internal {
		inline sub isspace(var c: u8) -> bool {
			return c == ' ' or c == '\t' or c == '\n' or c == '\r';
		}

		// The value of digit c, 99 when it isn't one.
		inline sub digit_value(var c: u8) -> u32 {
			if (c >= '0' and c <= '9') return c - '0';
			if (c >= 'a' and c <= 'z') return c - 'a' + 10;
			if (c >= 'A' and c <= 'Z') return c - 'A' + 10;
			return 99;
		}

		// The base (0 when it isn't valid), *pp moved past its prefix.
		sub number_base(var pp: u8**, var base: i32) -> u32 {
			var p: u8* = *pp;
			if (base == 0 or base == 16) {
				if (p[0] == '0' and (p[1] == 'x' or p[1] == 'X')) {
					*pp = p + 2;
					return 16;
				}
			}
			if (base == 0) {
				if (p[0] == '0' and (p[1] == 'b' or p[1] == 'B')) {
					*pp = p + 2;
					return 2;
				}
				if (p[0] == '0' and (p[1] == 'o' or p[1] == 'O')) {
					*pp = p + 2;
					return 8;
				}
				return 10;
			}
			if (base < 2 or base > 36)
				return 0;
			return cast<u32>(base);
		}

		// The digits at *pp (then moved past them), up to the end of the text and its spaces: false
		// when there are none, something else follows or the number is bigger than limit.
		sub parse_digits(var pp: u8**, var base: u32, var limit: u32, var out: u32*) -> bool {
			var p: u8* = *pp;
			var value: u32 = 0;
			var any: bool = false;
			while (true) {
				var d: u32 = __internal::digit_value(*p);
				if (d >= base)
					break;
				if (value > (limit - d) / base)
					return false;
				value = value * base + d;
				any = true;
				p++;
			}
			while (__internal::isspace(*p))
				p++;
			if (not any or *p != 0)
				return false;
			*pp = p;
			*out = value;
			return true;
		}
	}
}
