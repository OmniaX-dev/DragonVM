#import(<dragon-sdk>)

#define(KEY_BUFF_SIZE = 128)

var keyBuff: u32[KEY_BUFF_SIZE];
var keyRingBuff: dr::RingBuffer;
var console: dr::Text16Console;
var bootParts: dr::DPTPartitionBlock*[dr::DPTStructure.MaxPartitions];
var dpt_block: dr::DPTBlock;
var boot_part_count: u8 = 0;
var selected_index: u8 = 0;
var list_entries_count: u8 = 0;
var reboot_entry_index: u8 = 0;
var horizontalLine: u8* = null;
var pressedKey: u32 = 0;


sub main() {
	dr::TextSingle::clear_screen();
	dr::vga_set_video_mode(dr::VGAVideoModes.Text16Color);

	halt_on_condition(not dr::dpt_load_block(&dpt_block), "No valid DPT block found.");
	get_bootable_partitions(&dpt_block, bootParts);
	halt_on_condition(not bootParts[0], "No bootable partition found.");

	console.new();
	keyRingBuff.init(keyBuff, sizeof(u32), KEY_BUFF_SIZE);

	dr::vga_enable_double_buffering();
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.KeyPressed, &key_pressed_handler);
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.VSync, &on_draw);

	var screenWidth: u16 = console.get_console_width();
	horizontalLine = dr::malloc(screenWidth + 1);
	halt_on_condition(not horizontalLine, "Allocation for <horizontalLine> failed.");
	for (var i: u16 = 0; i < screenWidth - 2; i++)
		horizontalLine[i] = dr::ASCII.BoxHorizontal;
	horizontalLine[screenWidth] = '\0';

	while(true) {
		var key: u32 = 0;
		if (keyRingBuff.pop(&key)) {
			on_key_pressed(key);
		}
	}

	// Should never be reached
	cleanup();
	low { hlt }
}

sub on_key_pressed(var key: u32) {
	if (key == dr::KeyCodes.DownArrow)
		update_list_index(true);
	else if (key == dr::KeyCodes.UpArrow)
		update_list_index(false);
	else if (key == dr::KeyCodes.Return)
		execute_selected_entry();
}

interrupt sub on_draw() {
	static var b: bool = false;
	b = !b;
	if (b) return;
	console.clear(dr::DefaultPaletteText16.Black)->xy(0, 0);
	print_system_info(dpt_block.versionMaj, dpt_block.versionMin);
	print_top_line();
	print_box_sides();
	print_bottom_line();
	print_list();
	console.present();
}

inline sub print_top_line() {
	console.print(dr::ASCII.BoxDownRight);
	console.print(horizontalLine);
	console.print(dr::ASCII.BoxDownLeft);
	console.nl();
}

inline sub print_bottom_line() {
	console.print(dr::ASCII.BoxUpRight);
	console.print(horizontalLine);
	console.print(dr::ASCII.BoxUpLeft);
	console.nl();
}

inline sub print_box_sides() {
	for (var y: u16 = 2; y < 12; y++)
	{
		console.xy(0, y);
		console.print(dr::ASCII.BoxVertical);
		console.xy(console.get_console_width() - 1, y);
		console.print(dr::ASCII.BoxVertical);
	}
	console.nl();
}

inline sub print_list() {
	console.y(2);
	var i: u8 = 0;
	var part = bootParts[i++];
	while (part and i < dr::DPTStructure.MaxPartitions)
	{
		console.x(2)->store_colors();
		if ((i - 1) == selected_index)
			console.fg(dr::DefaultPaletteText16.Black)->bg(dr::DefaultPaletteText16.Green)->print(" >");
		console.print(' ')->print(part->label)->print(' ')->nl()->restore_colors();
		part = bootParts[i++];
	}
	console.x(2)->store_colors();
	if ((i - 1) == selected_index)
		console.fg(dr::DefaultPaletteText16.Black)->bg(dr::DefaultPaletteText16.Green)->print(" >");
	console.print(" Reboot ")->nl()->restore_colors();
}

interrupt sub key_pressed_handler() {
	pressedKey = *cast<u32*>(dr::KeyboardRegisters.KeyCode);
	if (not keyRingBuff.push(&pressedKey))
	{
		//TODO: Handle missed key presses
	}
}

inline sub update_list_index(var forward: bool) {
	if (boot_part_count == 0)
		return;
	selected_index = (selected_index + (forward ? 1 : list_entries_count - 1)) % list_entries_count;
}

sub execute_selected_entry() {
	if (selected_index == reboot_entry_index)
		dr::raise_interrupt(0x20, INT20_REBOOT);
	else if (selected_index < boot_part_count)
	{
		load_kernel0_block(bootParts[selected_index]);
		cleanup();
		low {
			jmp $dr::DPTBootPartStructure.CodeLoadAddr
			hlt
		}
	}
}

inline sub cleanup() {
	dr::clear_interrupt_vector_entry(dr::HardwareInterrupts.KeyPressed);
	dr::clear_interrupt_vector_entry(dr::HardwareInterrupts.VSync);
	console.clear(dr::DefaultPaletteText16.Black)->xy(0, 0)->present()->destroy();
}

sub load_kernel0_block(var part: dr::DPTPartitionBlock*) {
	var ddd: dr::DiskDriverData;
	ddd.mode = dr::DiskMode.Read;
	ddd.disk = dr::get_boot_disk();
	ddd.address = part->startAddress + dr::DPTBootPartStructure.CodeStart;
	ddd.dataSize = dr::DPTBootPartStructure.CodeSize;
	ddd.memoryAddress = dr::DPTBootPartStructure.CodeLoadAddr;
	dr::raise_interrupt(0x20, INT20_LOAD_FROM_DDD_BLOCKING, cast<u32>(&ddd));
}

sub get_bootable_partitions(var dpt_block: dr::DPTBlock*, var outEntries: dr::DPTPartitionBlock**) {
	var j: i8 = 0;
	for (; j < dr::DPTStructure.MaxPartitions; j++)
		outEntries[j] = null;
	j = 0;
	for (var i: i8 = 0; i < dpt_block->partitionCount; i++)
	{
		if (dr::dpt_is_partition_bootable(&dpt_block->entries[i]))
			outEntries[j++] = &dpt_block->entries[i];
	}
	boot_part_count = j;
	reboot_entry_index = j++;
	list_entries_count = j;
}

sub print_system_info(var dpt_ver_maj: u8, var dpt_ver_min: u8) {
	console.bg(dr::DefaultPaletteText16.Green)->fg(dr::DefaultPaletteText16.Black);
	console.print(" Drake 0.2 -- DPT Version ")->print(cast<u32>(dpt_ver_maj))->print('.')->print(cast<u32>(dpt_ver_min))->print(' ');
	console.bg(dr::DefaultPaletteText16.Black)->fg(dr::DefaultPaletteText16.Green)->nl();
}

sub halt_on_condition(var condition: bool, var err_msg: string) {
	if (condition)
	{
		dr::Text16::print(err_msg, 0, 0, dr::DefaultPaletteText16.Red, dr::DefaultPaletteText16.Black);
		low { hlt };
	}
}
