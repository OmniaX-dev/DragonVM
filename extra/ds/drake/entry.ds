#import(<dragon-sdk>)

#define(KEY_BUFF_SIZE = 128)

var keyBuff: u32[KEY_BUFF_SIZE];
var keyRingBuff: dr::RingBuffer;
var console: dr::Text16Console;
var bootParts: dr::DPTPartitionBlock*[dr::DPTStructure.MaxPartitions];
var bootPartsLbl: u8[64][dr::DPTStructure.MaxPartitions];
var dpt_block: dr::DPTBlock;
var boot_part_count: u8 = 0;
var selected_index: u8 = 0;
var list_entries_count: u8 = 0;
var reboot_entry_index: u8 = 0;
var horizontalLine: u8* = null;
var pressedKey: u32 = 0;
var boot_error: string = null;
var drake_load_addr: u32 = 0;
var drake_size: u32 = 0;
var kernel_size: u32 = 0;
var kernel_load_addr: u32 = 0;

// load_kernel0's own errors (below dr::dfs's, which go from -1 to -14).
const KernelNotAFile: i32 = -100;
const KernelEmpty: i32 = -101;
const KernelTooBig: i32 = -102;
const UnableToMount: i32 = -103;
const KernelNoRoom: i32 = -104;
const KernelInvalidDrx: i32 = -105;

const KERNEL0_PATH = "/boot/kernel0";	// the kernel on a DFS partition
const MAX_KERNEL0_SIZE: u32 = 1024*1024*10; // 10 MiB


// argv[0] = Load address for Drake
// argv[1] = Drake size
sub main(var argc: i32, var argv: u8**) {
	dr::TextSingle::clear_screen();
	dr::vga_set_video_mode(dr::VGAVideoModes.Text16Color);

	halt_on_condition(argc != 2 or not dr::atou(argv[0], &drake_load_addr) or not dr::atou(argv[1], &drake_size),
		"Invalid arguments from the BIOS (Drake's load address and size).");

	halt_on_condition(not dr::dpt_load_block(&dpt_block), "No valid DPT block found.");
	get_bootable_partitions(&dpt_block, bootParts);
	halt_on_condition(not bootParts[0], "No bootable partition found.");

	console.new();
	keyRingBuff.init(keyBuff, sizeof(u32), KEY_BUFF_SIZE);

	dr::vga_enable_double_buffering();
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.KeyPressed, &key_pressed_handler);
	dr::set_interrupt_vector_entry(dr::HardwareInterrupts.VSync, &on_draw);

	var screenWidth: u16 = console.get_console_width();
	horizontalLine = dr::malloc(screenWidth - 1);		// between the two corners
	halt_on_condition(not horizontalLine, "Allocation for <horizontalLine> failed.");
	for (var i: u16 = 0; i < screenWidth - 2; i++)
		horizontalLine[i] = dr::ASCII.BoxHorizontal;
	horizontalLine[screenWidth - 2] = '\0';

	#ifdef(DRAKE_AUTOBOOT)
		execute_selected_entry();	// boots the first entry without a key (dsc -D DRAKE_AUTOBOOT: headless tests)
	#endif
	while(true) {
		var key: u32 = 0;
		if (keyRingBuff.pop(&key)) {
			on_key_pressed(key);
		}
	}

	// Should never be reached
	cleanup();
	low { hlt }
}

sub on_key_pressed(var key: u32) {
	if (key == dr::KeyCodes.DownArrow)
		update_list_index(true);
	else if (key == dr::KeyCodes.UpArrow)
		update_list_index(false);
	else if (key == dr::KeyCodes.Return)
		execute_selected_entry();
}

interrupt sub on_draw() {
	static var b: bool = false;
	b = !b;
	if (b) return;
	console.clear(dr::DefaultPaletteText16.Black)->xy(0, 0);
	print_system_info(dpt_block.versionMaj, dpt_block.versionMin);
	print_top_line();
	print_box_sides();
	print_bottom_line();
	print_list();
	if (boot_error) {
		console.xy(2, 13)->fg(dr::DefaultPaletteText16.Red)->print("Boot failed: ")->print(KERNEL0_PATH)->print(": ")->print(boot_error);
		console.fg(dr::DefaultPaletteText16.Green);
	}
	console.present();
}

inline sub print_top_line() {
	console.print(dr::ASCII.BoxDownRight);
	console.print(horizontalLine);
	console.print(dr::ASCII.BoxDownLeft);
	console.nl();
}

inline sub print_bottom_line() {
	console.print(dr::ASCII.BoxUpRight);
	console.print(horizontalLine);
	console.print(dr::ASCII.BoxUpLeft);
	console.nl();
}

inline sub print_box_sides() {
	for (var y: u16 = 2; y < 12; y++)
	{
		console.xy(0, y);
		console.print(dr::ASCII.BoxVertical);
		console.xy(console.get_console_width() - 1, y);
		console.print(dr::ASCII.BoxVertical);
	}
	console.nl();
}

inline sub print_list() {
	console.y(2);
	var i: u8 = 0;
	while (i < dr::DPTStructure.MaxPartitions and bootParts[i])
	{
		console.x(2)->store_colors();
		if (i == selected_index)
			console.fg(dr::DefaultPaletteText16.Black)->bg(dr::DefaultPaletteText16.Green)->print(" >");
		console.print(' ')->print(bootPartsLbl[i])->print(' ')->nl()->restore_colors();
		i++;
	}
	console.x(2)->store_colors();
	if (i == selected_index)
		console.fg(dr::DefaultPaletteText16.Black)->bg(dr::DefaultPaletteText16.Green)->print(" >");
	console.print(" Reboot ")->nl()->restore_colors();
}

interrupt sub key_pressed_handler() {
	pressedKey = *cast<u32*>(dr::KeyboardRegisters.KeyCode);
	if (not keyRingBuff.push(&pressedKey))
	{
		//TODO: Handle missed key presses
	}
}

inline sub update_list_index(var forward: bool) {
	if (boot_part_count == 0)
		return;
	selected_index = (selected_index + (forward ? 1 : list_entries_count - 1)) % list_entries_count;
}

sub execute_selected_entry() {
	if (selected_index == reboot_entry_index)
		dr::raise_interrupt(0x20, INT20_REBOOT);
	else if (selected_index < boot_part_count)
	{
		var load_addr: u32 = 0;
		if (not load_kernel0(bootParts[selected_index], &load_addr))
			return;
		cleanup();
		if (load_addr == 0)
		{
			low {
				jmp $dr::DPTBootPartStructure.CodeLoadAddr
				hlt
			}
		}
		const argc: u32 = 2;
		var argv: u8*[argc];
		argv[0] = dr::malloc(11);
		argv[1] = dr::malloc(11);
		dr::utoa(cast<u32>(kernel_load_addr), argv[0]);
		dr::utoa(cast<u32>(kernel_size), argv[1]);
		dr::drx::run(load_addr, argc, argv);
		low { hlt }
	}
}

inline sub cleanup() {
	dr::clear_interrupt_vector_entry(dr::HardwareInterrupts.KeyPressed);
	dr::clear_interrupt_vector_entry(dr::HardwareInterrupts.VSync);
	console.clear(dr::DefaultPaletteText16.Black)->xy(0, 0)->present()->destroy();
}

sub kernel_error_name(var error: i32) -> string {
	if (error == KernelNotAFile) return "not a file";
	if (error == KernelEmpty) return "empty file";
	if (error == KernelTooBig) return "too big";
	if (error == UnableToMount) return "unable to mount dfs volume";
	if (error == KernelNoRoom) return "not enough memory between Drake and the heap";
	if (error == KernelInvalidDrx) return "invalid DRX file";
	return dr::dfs::error_name(error);
}

// Loads the partition's kernel, the first that works of: /boot/kernel0 as a DRX (at a random
// address after Drake), /boot/kernel0 as a raw kernel (at CodeLoadAddr), and on a partition that
// isn't DFS the raw block after the boot header (at CodeLoadAddr). *out_load_addr: the DRX's entry,
// 0 for a raw kernel. False (with boot_error set) when it can't.
sub load_kernel0(var part: dr::DPTPartitionBlock*, var out_load_addr: u32*) -> bool {
	boot_error = null;
	*out_load_addr = 0;
	var fs: dr::fs::FileSystem;
	var disk: dr::dfs::DiskPartition;
	dr::dfs::dpt_partition(&disk, part);
	if (not fs.mount_partition(&disk, true))
	{
		if (fs.last_error() == dr::dfs::Unsupported)
		{
			// Not DFS: the raw kernel block after the boot header, at its fixed address.
			load_kernel0_legacy(part);
			return true;
		}
		boot_error = fs.error_text();
		return false;
	}
	defer fs.unmount();
	var info: dr::fs::Info;
	if (not fs.info(KERNEL0_PATH, &info))
	{
		boot_error = fs.error_text();
		return false;
	}
	if (info.type != dr::fs::Type.File)
	{
		boot_error = kernel_error_name(KernelNotAFile);
		return false;
	}
	if (info.size == 0)
	{
		boot_error = kernel_error_name(KernelEmpty);
		return false;
	}
	if (info.size > MAX_KERNEL0_SIZE)
	{
		boot_error = kernel_error_name(KernelTooBig);
		return false;
	}
	const KASLR_ALIGN: u32 = 0x10000; // 64 KiB slots (a power of 2)
	var first: u32 = (drake_load_addr + drake_size + KASLR_ALIGN - 1) & ~(KASLR_ALIGN - 1); // round up
	var heap_start: u32 = dr::read_cmos(dr::CMOSRegisters.HeapStart);
	if (heap_start < first or heap_start - first < info.size) {
		boot_error = kernel_error_name(KernelNoRoom);
		return false;
	}
	var last: u32 = (heap_start - info.size) & ~(KASLR_ALIGN - 1);  // round down
	var slots: u32 = (last - first) / KASLR_ALIGN + 1;
	var slot: u32 = cast<u32>(dr::random::next()) % slots;
	var load_addr: u8* = cast<u8*>(first + slot * KASLR_ALIGN);
	var r: i32 = fs.read_all(KERNEL0_PATH, load_addr, info.size);
	if (r < 0)
	{
		boot_error = fs.error_text();
		return false;
	}
	var entry_addr: u32 = 0;
	r = dr::drx::load(load_addr, info.size, load_addr, heap_start - cast<u32>(load_addr), &entry_addr);
	if (r == dr::drx::Errors.InvalidMagic or r == dr::drx::Errors.FileTooSmall)
	{
		// Not a DRX: a raw kernel, at its fixed address.
		r = load_kernel0_dfs_fixed(part);
		if (r < 0)
		{
			boot_error = kernel_error_name(r);
			return false;
		}
		*out_load_addr = 0;
		return true;
	}
	if (r != dr::drx::Errors.NoError)
	{
		boot_error = kernel_error_name(KernelInvalidDrx);
		return false;
	}
	*out_load_addr = entry_addr;
	kernel_size = info.size;
	kernel_load_addr = cast<u32>(load_addr);
	return true;
}

sub load_kernel0_dfs_fixed(var part: dr::DPTPartitionBlock*) -> i32 {
	var vol: dr::dfs::Volume* = cast<dr::dfs::Volume*>(dr::malloc(sizeof(dr::dfs::Volume)));
	if (not vol)
		return dr::dfs::NoSpace;
	defer dr::free(vol);
	var disk: dr::dfs::DiskPartition;
	var dev: dr::dfs::Device;
	dr::dfs::dpt_partition(&disk, part);
	dr::dfs::disk_device(&dev, &disk);
	var r: i32 = dr::dfs::mount(vol, &dev, true);
	if (r < 0)
		return r;
	defer dr::dfs::unmount(vol);
	var node: dr::dfs::Inode;
	r = dr::dfs::stat(vol, KERNEL0_PATH, &node);
	if (r < 0)
		return r;
	if ((node.mode & dr::dfs::ModeTypeMask) != dr::dfs::ModeFile)
		return KernelNotAFile;
	if (node.size == 0)
		return KernelEmpty;
	if (node.size > dr::DPTBootPartStructure.CodeSize)
		return KernelTooBig;
	r = dr::dfs::inode_read(vol, &node, 0, cast<u8*>(dr::DPTBootPartStructure.CodeLoadAddr), node.size);
	if (r < 0)
		return r;
	return dr::dfs::Ok;
}

// The kernel of a partition that isn't DFS: the raw block after its boot header.
sub load_kernel0_legacy(var part: dr::DPTPartitionBlock*) {
	var ddd: dr::DiskDriverData;
	ddd.mode = dr::DiskMode.Read;
	ddd.disk = dr::get_boot_disk();
	ddd.address = part->startAddress + dr::DPTBootPartStructure.CodeStart;
	ddd.dataSize = dr::DPTBootPartStructure.CodeSize;
	ddd.memoryAddress = dr::DPTBootPartStructure.CodeLoadAddr;
	dr::raise_interrupt(0x20, INT20_LOAD_FROM_DDD_BLOCKING, cast<u32>(&ddd));
}

sub get_bootable_partitions(var dpt_block: dr::DPTBlock*, var outEntries: dr::DPTPartitionBlock**) {
	var j: i8 = 0;
	for (; j < dr::DPTStructure.MaxPartitions; j++)
		outEntries[j] = null;
	j = 0;
	var fs: dr::fs::FileSystem;
	var disk: dr::dfs::DiskPartition;
	for (var i: i8 = 0; i < dpt_block->partitionCount; i++)
	{
		if (dr::dpt_is_partition_bootable(&dpt_block->entries[i]))
		{
			outEntries[j++] = &dpt_block->entries[i];
			dr::dfs::dpt_partition(&disk, &dpt_block->entries[i]);
			bootPartsLbl[j - 1][0] = 0;
			if (fs.mount_partition(&disk, true))
			{
				fs.label(bootPartsLbl[j - 1], 64);
				fs.unmount();
			}
			if (bootPartsLbl[j - 1][0] == 0)
				dr::memcpy(bootPartsLbl[j - 1], dpt_block->entries[i].label, 64);
		}
	}
	boot_part_count = j;
	reboot_entry_index = j++;
	list_entries_count = j;
}

sub print_system_info(var dpt_ver_maj: u8, var dpt_ver_min: u8) {
	console.bg(dr::DefaultPaletteText16.Green)->fg(dr::DefaultPaletteText16.Black);
	console.print(" Drake 0.3 -- DPT Version ")->print(cast<u32>(dpt_ver_maj))->print('.')->print(cast<u32>(dpt_ver_min))->print(' ');
	console.bg(dr::DefaultPaletteText16.Black)->fg(dr::DefaultPaletteText16.Green)->nl();
}

sub halt_on_condition(var condition: bool, var err_msg: string) {
	if (condition)
	{
		dr::Text16::print(err_msg, 0, 0, dr::DefaultPaletteText16.Red, dr::DefaultPaletteText16.Black);
		low { hlt };
	}
}
