#once

struct DiskDriverData {
	var mode: u8;
	var disk: u8;
	var reserverd: u16;
	var address: u32;
	var dataSize: u32;
	var memoryAddress: u32;
};

const DISK_MODE_READ: u8 = 0x00;
const CMOS_ADDR: u32 = 0x01000000;
const CMOS_BOOT_DISK_ADDR: u32 = CMOS_ADDR + 0x0019;
const RAM_START: u32 = 0x01010000;
const INT20_LOAD_FROM_DDD_BLOCKING: u8 = 0x12;

sub main() {
	var ddd: DiskDriverData;
	ddd.mode = DISK_MODE_READ;
	ddd.disk = *cast<u8*>(CMOS_BOOT_DISK_ADDR);
	ddd.address = 0x00000400;
	ddd.dataSize = 524288;
	ddd.memoryAddress = RAM_START;
	low {
		mov R9, $ddd
		mov R10, $INT20_LOAD_FROM_DDD_BLOCKING
		int 0x20
		jmp $RAM_START
	}
}
