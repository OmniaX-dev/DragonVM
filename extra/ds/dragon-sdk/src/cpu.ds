#include(dragon.ds)

// Supervisor mode and user mode, for kernels. The BIOS, the boot loader and the kernel run in
// supervisor mode; a kernel runs programs in user mode (enter_user_mode), where privileged
// instructions (hlt, rti, umode, the interrupt flag, int to a fault vector) and writes to the
// protected device registers (CMOS, keyboard controller, CPU control, the Timer's interrupt
// interval) are faults, and so are the accesses the permission map denies (set_permission_map).
// Traps from user mode (int: system calls, hardware interrupts, faults)
// run their handler in supervisor mode, on the kernel stack (set_kernel_stack); rti goes back.
namespace dr::cpu {
	// The fault vectors: an instruction that fails in user mode raises its fault when the vector
	// is enabled (set_interrupt_vector_entry); otherwise (and in supervisor mode) the machine stops
	// with the error. The handler returns to the faulting instruction, unless it changes the return
	// address (set_trap_return_address) or doesn't return.
	const Faults: struct {
		var DivisionByZero: u8					= 0x00;
		var InvalidInstruction: u8				= 0x01;
		var PrivilegedInstruction: u8			= 0x02;
		var AccessViolation: u8					= 0x03;	// a protected, read-only or missing address
		var StackOverflow: u8					= 0x04;
		var General: u8							= 0x05;
		var Last: u8							= 0x0F;	// 0x00 - 0x0F: the CPU's (int can't use them in user mode)
	};

	// Memory protection: the permission map has 2 bits for each 4 KiB page of the address space
	// (bit 0: user mode may read and execute it, bit 1: write it); 16 KiB in the RAM, read in place
	// (changes count at once). Without a map (0), user mode may access everything. A denied access
	// is an access violation fault (fault_address: where).
	const PageSize: u32 = 4096;
	const PermissionMapSize: u32 = 16384;
	const Permissions: struct {
		var None: u8							= 0x00;
		var Read: u8							= 0x01;	// read and execute
		var Write: u8							= 0x02;
		var ReadWrite: u8						= 0x03;
	};

	// The map user mode is checked against (null: none). Supervisor mode only.
	sub set_permission_map(var map: u8*) {
		*cast<u32*>(CPUControlRegisters.PermissionMap) = cast<u32>(map);
	}
	inline sub permission_map() -> u8* {
		return cast<u8*>(*cast<u32*>(CPUControlRegisters.PermissionMap));
	}

	// The pages with any byte in [address, address + size) get permissions.
	sub set_page_permissions(var map: u8*, var address: u32, var size: u32, var permissions: u8) {
		if (size == 0)
			return;
		var first: u32 = (address & 0x0FFFFFFF) / PageSize;
		var last: u32 = ((address & 0x0FFFFFFF) + (size - 1)) / PageSize;
		if (last > 0xFFFF or last < first)
			last = 0xFFFF;
		permissions = permissions & 0x03;
		var page: u32 = first;
		// One by one up to 4 pages (a byte) boundary, then whole bytes, then the rest.
		while (page <= last and (page & 3) != 0) {
			__set_page(map, page, permissions);
			page++;
		}
		if (page + 3 <= last) {
			var bytes: u32 = (last + 1 - page) / 4;
			memset(&map[page / 4], permissions * 0x55, bytes);
			page += bytes * 4;
		}
		while (page <= last) {
			__set_page(map, page, permissions);
			page++;
		}
	}

	inline sub __set_page(var map: u8*, var page: u32, var permissions: u8) {
		var shift: u32 = (page & 3) * 2;
		map[page / 4] = (map[page / 4] & ~(0x03 << shift)) | (permissions << shift);
	}

	// The permissions of the page with address.
	sub page_permissions(var map: u8*, var address: u32) -> u8 {
		var page: u32 = (address & 0x0FFFFFFF) / PageSize;
		return (map[page / 4] >> ((page & 3) * 2)) & 0x03;
	}

	inline sub is_supervisor() -> bool {
		return *cast<u32*>(CPUControlRegisters.Mode) != 0;
	}

	// The stack traps from user mode switch to (top: its last word; 0: they stay on the user's
	// stack). Each trap from user mode starts it again from the top.
	sub set_kernel_stack(var top: u32, var size: u32) {
		*cast<u32*>(CPUControlRegisters.KernelStackTop) = top;
		*cast<u32*>(CPUControlRegisters.KernelStackSize) = size;
	}

	// The user program's stack, for the stack check (top 0: none).
	sub set_user_stack(var top: u32, var size: u32) {
		*cast<u32*>(CPUControlRegisters.UserStackTop) = top;
		*cast<u32*>(CPUControlRegisters.UserStackSize) = size;
	}

	// The last fault: its vector, the faulting instruction, the address it accessed (memory
	// faults; the instruction's otherwise).
	inline sub fault_vector() -> u8 {
		return cast<u8>(*cast<u32*>(CPUControlRegisters.FaultVector));
	}
	inline sub fault_ip() -> u32 {
		return *cast<u32*>(CPUControlRegisters.FaultIP);
	}
	inline sub fault_address() -> u32 {
		return *cast<u32*>(CPUControlRegisters.FaultAddress);
	}

	// Called directly from an interrupt sub: its frame (the trap's), for the subs below.
	sub trap_frame() -> u32 {
		var fp: u32 = 0;
		low { mov $fp, FP }
		return *cast<u32*>(fp + 8);		// the caller's FP (saved in this sub's frame)
	}

	// Where rti returns to (the frame's saved IP), and changing it: e.g. past a faulting
	// instruction, or to another program (a task switch also needs its registers and stack).
	sub trap_return_address(var frame: u32) -> u32 {
		return *cast<u32*>(frame + 12);
	}
	sub set_trap_return_address(var frame: u32, var address: u32) {
		*cast<u32*>(frame + 12) = address;
	}

	// The trap came from user mode (the mode saved under the frame).
	sub trap_from_user(var frame: u32) -> bool {
		var count: u32 = *cast<u32*>(frame + 4 * 26);	// the argument count (0 for traps)
		var marker: u32 = *cast<u32*>(frame + 4 * 27);
		var mode_at: u32 = frame + 4 * 28;
		if (marker == 0x48574952)						// with the saved RV, S1, S2, OFFSET, FL
			mode_at += 4 * 5;
		return count == 0 and *cast<u32*>(mode_at) == 0;
	}

	// The boot stack: where the CPU starts (SP at the RAM's last word, CMOS StackSize bytes below
	// it). The BIOS, the boot loader and the kernel's main all run on it, one call inside the other.
	inline sub boot_stack_end() -> u32 {
		return read_cmos(CMOSRegisters.MemoryStart) + read_cmos(CMOSRegisters.MemorySize);
	}
	inline sub boot_stack_start() -> u32 {
		return boot_stack_end() - read_cmos(CMOSRegisters.StackSize);
	}

	// Moves to a new stack for good: it becomes the kernel stack (set_kernel_stack(top, size): the
	// stack check accepts it, and traps from user mode use it), SP and FP go to its top and
	// continuation runs there. It never returns: whatever was on the old stack (this caller's
	// locals too) is not used again, and if continuation returns, the machine halts. Supervisor
	// mode only. Then release_boot_stack can give the boot stack's memory away.
	// (Traps from user mode start the kernel stack again from its top, so once the kernel runs user
	// programs, what continuation was doing before can't continue: as with enter_user_mode.)
	sub switch_stack(var top: u32, var size: u32, var continuation: sub()) {
		set_kernel_stack(top, size);
		low {
			mov R1, $continuation
			mov R2, $top
			mov SP, R2
			mov FP, R2
			push 0x00000000
			call R1
			hlt
		}
	}

	// Gives up the boot stack (CMOS StackSize 0: SP there is a stack overflow from now on, so a
	// stray use of it stops the machine instead of writing over what the memory is used for
	// then). The memory is [boot_stack_start(), boot_stack_end()): read them first. False (and
	// nothing changes) while SP is still on it: call it after switch_stack. Supervisor mode only;
	// a reset gives the stack back.
	sub release_boot_stack() -> bool {
		var sp: u32 = 0;
		low { mov $sp, SP }
		if (sp >= boot_stack_start() and sp < boot_stack_end())
			return false;
		write_cmos(CMOSRegisters.StackSize, 0);
		return true;
	}

	// Supervisor mode -> user mode, here (on the same stack). Privileged.
	sub drop_to_user() {
		low { umode }
	}

	// Runs entry in user mode on its own stack (stack_top: the stack's last word, stack_size
	// bytes): it never returns here. If entry returns, the next instruction is a hlt: a privileged
	// instruction fault (the kernel's handler ends the program). From supervisor mode only.
	sub enter_user_mode(var entry: sub(), var stack_top: u32, var stack_size: u32) {
		set_user_stack(stack_top, stack_size);
		// A trap frame as int from user mode leaves it (the user SP, the user mode, no saved
		// registers, no arguments), with the return address changed: rti goes there.
		low {
			mov R1, $entry
			mov R2, $stack_top
			push R2
			push 0x00000000
			push 0x00000000
			push 0x00000000
			call $__dr_cpu_enter_user_frame
		__dr_cpu_enter_user_frame:
			mov R3, $__dr_cpu_user_start
			omov *FP, R3, 0x0C
			rti
		__dr_cpu_user_start:
			push 0x00000000
			call R1
			hlt
		}
	}
}
