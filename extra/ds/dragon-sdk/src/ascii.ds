// ascii.ds - every character of Code Page 437 (the PC's character set, which DragonVM's
// font uses), by name: dr::ASCII.Escape, dr::ASCII.a, dr::ASCII.BoxDoubleDownRight.
//
// 0..31 and 127 have their ASCII control names; the screen shows them as the pictures in the
// comments (as on the IBM PC). 32..126 are ASCII; 128..255 are CP437's accented letters,
// symbols, box drawing, blocks, Greek letters and maths. Accented letters keep the letter's
// case (CCedilla: Ç, cCedilla: ç), Greek letters too (Sigma: Σ, sigma: σ).
// At the end, 1..31 and 127 again, named after their pictures: dr::ASCII.Escape and
// dr::ASCII.ArrowLeft are both 0x1B.

#once
namespace dr {
	const ASCII: struct {
		var Null: u8										= 0x00;	// (blank)
		var StartOfHeading: u8								= 0x01;	// ☺
		var StartOfText: u8									= 0x02;	// ☻
		var EndOfText: u8									= 0x03;	// ♥
		var EndOfTransmission: u8							= 0x04;	// ♦
		var Enquiry: u8										= 0x05;	// ♣
		var Acknowledge: u8									= 0x06;	// ♠
		var Bell: u8										= 0x07;	// •
		var Backspace: u8									= 0x08;	// ◘
		var Tab: u8											= 0x09;	// ○
		var LineFeed: u8									= 0x0A;	// ◙
		var VerticalTab: u8									= 0x0B;	// ♂
		var FormFeed: u8									= 0x0C;	// ♀
		var CarriageReturn: u8								= 0x0D;	// ♪
		var ShiftOut: u8									= 0x0E;	// ♫
		var ShiftIn: u8										= 0x0F;	// ☼
		var DataLinkEscape: u8								= 0x10;	// ►
		var DeviceControl1: u8								= 0x11;	// ◄
		var DeviceControl2: u8								= 0x12;	// ↕
		var DeviceControl3: u8								= 0x13;	// ‼
		var DeviceControl4: u8								= 0x14;	// ¶
		var NegativeAcknowledge: u8							= 0x15;	// §
		var SynchronousIdle: u8								= 0x16;	// ▬
		var EndOfTransmissionBlock: u8						= 0x17;	// ↨
		var Cancel: u8										= 0x18;	// ↑
		var EndOfMedium: u8									= 0x19;	// ↓
		var Substitute: u8									= 0x1A;	// →
		var Escape: u8										= 0x1B;	// ←
		var FileSeparator: u8								= 0x1C;	// ∟
		var GroupSeparator: u8								= 0x1D;	// ↔
		var RecordSeparator: u8								= 0x1E;	// ▲
		var UnitSeparator: u8								= 0x1F;	// ▼

		var Space: u8										= 0x20;	// (space)
		var ExclamationMark: u8								= 0x21;	// !
		var DoubleQuote: u8									= 0x22;	// "
		var Hash: u8										= 0x23;	// #
		var DollarSign: u8									= 0x24;	// $
		var Percent: u8										= 0x25;	// %
		var Ampersand: u8									= 0x26;	// &
		var SingleQuote: u8									= 0x27;	// '
		var LeftParenthesis: u8								= 0x28;	// (
		var RightParenthesis: u8							= 0x29;	// )
		var Asterisk: u8									= 0x2A;	// *
		var Plus: u8										= 0x2B;	// +
		var Comma: u8										= 0x2C;	// ,
		var Minus: u8										= 0x2D;	// -
		var Period: u8										= 0x2E;	// .
		var ForwardSlash: u8								= 0x2F;	// /
		var Digit0: u8										= 0x30;	// 0
		var Digit1: u8										= 0x31;	// 1
		var Digit2: u8										= 0x32;	// 2
		var Digit3: u8										= 0x33;	// 3
		var Digit4: u8										= 0x34;	// 4
		var Digit5: u8										= 0x35;	// 5
		var Digit6: u8										= 0x36;	// 6
		var Digit7: u8										= 0x37;	// 7
		var Digit8: u8										= 0x38;	// 8
		var Digit9: u8										= 0x39;	// 9
		var Colon: u8										= 0x3A;	// :
		var Semicolon: u8									= 0x3B;	// ;
		var LessThan: u8									= 0x3C;	// <
		var Equals: u8										= 0x3D;	// =
		var GreaterThan: u8									= 0x3E;	// >
		var QuestionMark: u8								= 0x3F;	// ?
		var At: u8											= 0x40;	// @
		var A: u8											= 0x41;	// A
		var B: u8											= 0x42;	// B
		var C: u8											= 0x43;	// C
		var D: u8											= 0x44;	// D
		var E: u8											= 0x45;	// E
		var F: u8											= 0x46;	// F
		var G: u8											= 0x47;	// G
		var H: u8											= 0x48;	// H
		var I: u8											= 0x49;	// I
		var J: u8											= 0x4A;	// J
		var K: u8											= 0x4B;	// K
		var L: u8											= 0x4C;	// L
		var M: u8											= 0x4D;	// M
		var N: u8											= 0x4E;	// N
		var O: u8											= 0x4F;	// O
		var P: u8											= 0x50;	// P
		var Q: u8											= 0x51;	// Q
		var R: u8											= 0x52;	// R
		var S: u8											= 0x53;	// S
		var T: u8											= 0x54;	// T
		var U: u8											= 0x55;	// U
		var V: u8											= 0x56;	// V
		var W: u8											= 0x57;	// W
		var X: u8											= 0x58;	// X
		var Y: u8											= 0x59;	// Y
		var Z: u8											= 0x5A;	// Z
		var LeftBracket: u8									= 0x5B;	// [
		var Backslash: u8									= 0x5C;	// \
		var RightBracket: u8								= 0x5D;	// ]
		var Caret: u8										= 0x5E;	// ^
		var Underscore: u8									= 0x5F;	// _
		var Backtick: u8									= 0x60;	// `
		var a: u8											= 0x61;	// a
		var b: u8											= 0x62;	// b
		var c: u8											= 0x63;	// c
		var d: u8											= 0x64;	// d
		var e: u8											= 0x65;	// e
		var f: u8											= 0x66;	// f
		var g: u8											= 0x67;	// g
		var h: u8											= 0x68;	// h
		var i: u8											= 0x69;	// i
		var j: u8											= 0x6A;	// j
		var k: u8											= 0x6B;	// k
		var l: u8											= 0x6C;	// l
		var m: u8											= 0x6D;	// m
		var n: u8											= 0x6E;	// n
		var o: u8											= 0x6F;	// o
		var p: u8											= 0x70;	// p
		var q: u8											= 0x71;	// q
		var r: u8											= 0x72;	// r
		var s: u8											= 0x73;	// s
		var t: u8											= 0x74;	// t
		var u: u8											= 0x75;	// u
		var v: u8											= 0x76;	// v
		var w: u8											= 0x77;	// w
		var x: u8											= 0x78;	// x
		var y: u8											= 0x79;	// y
		var z: u8											= 0x7A;	// z
		var LeftBrace: u8									= 0x7B;	// {
		var VerticalBar: u8									= 0x7C;	// |
		var RightBrace: u8									= 0x7D;	// }
		var Tilde: u8										= 0x7E;	// ~
		var Delete: u8										= 0x7F;	// ⌂

		var CCedilla: u8									= 0x80;	// Ç
		var uUmlaut: u8										= 0x81;	// ü
		var eAcute: u8										= 0x82;	// é
		var aCircumflex: u8									= 0x83;	// â
		var aUmlaut: u8										= 0x84;	// ä
		var aGrave: u8										= 0x85;	// à
		var aRing: u8										= 0x86;	// å
		var cCedilla: u8									= 0x87;	// ç
		var eCircumflex: u8									= 0x88;	// ê
		var eUmlaut: u8										= 0x89;	// ë
		var eGrave: u8										= 0x8A;	// è
		var iUmlaut: u8										= 0x8B;	// ï
		var iCircumflex: u8									= 0x8C;	// î
		var iGrave: u8										= 0x8D;	// ì
		var AUmlaut: u8										= 0x8E;	// Ä
		var ARing: u8										= 0x8F;	// Å
		var EAcute: u8										= 0x90;	// É
		var aeLigature: u8									= 0x91;	// æ
		var AELigature: u8									= 0x92;	// Æ
		var oCircumflex: u8									= 0x93;	// ô
		var oUmlaut: u8										= 0x94;	// ö
		var oGrave: u8										= 0x95;	// ò
		var uCircumflex: u8									= 0x96;	// û
		var uGrave: u8										= 0x97;	// ù
		var yUmlaut: u8										= 0x98;	// ÿ
		var OUmlaut: u8										= 0x99;	// Ö
		var UUmlaut: u8										= 0x9A;	// Ü
		var Cent: u8										= 0x9B;	// ¢
		var Pound: u8										= 0x9C;	// £
		var Yen: u8											= 0x9D;	// ¥
		var Peseta: u8										= 0x9E;	// ₧
		var Florin: u8										= 0x9F;	// ƒ
		var aAcute: u8										= 0xA0;	// á
		var iAcute: u8										= 0xA1;	// í
		var oAcute: u8										= 0xA2;	// ó
		var uAcute: u8										= 0xA3;	// ú
		var nTilde: u8										= 0xA4;	// ñ
		var NTilde: u8										= 0xA5;	// Ñ
		var FeminineOrdinal: u8								= 0xA6;	// ª
		var MasculineOrdinal: u8							= 0xA7;	// º
		var InvertedQuestionMark: u8						= 0xA8;	// ¿
		var ReversedNotSign: u8								= 0xA9;	// ⌐
		var NotSign: u8										= 0xAA;	// ¬
		var OneHalf: u8										= 0xAB;	// ½
		var OneQuarter: u8									= 0xAC;	// ¼
		var InvertedExclamationMark: u8						= 0xAD;	// ¡
		var LeftGuillemet: u8								= 0xAE;	// «
		var RightGuillemet: u8								= 0xAF;	// »
		var ShadeLight: u8									= 0xB0;	// ░
		var ShadeMedium: u8									= 0xB1;	// ▒
		var ShadeDark: u8									= 0xB2;	// ▓
		var BoxVertical: u8									= 0xB3;	// │
		var BoxVerticalLeft: u8								= 0xB4;	// ┤
		var BoxVerticalSingleLeftDouble: u8					= 0xB5;	// ╡
		var BoxVerticalDoubleLeftSingle: u8					= 0xB6;	// ╢
		var BoxDownDoubleLeftSingle: u8						= 0xB7;	// ╖
		var BoxDownSingleLeftDouble: u8						= 0xB8;	// ╕
		var BoxDoubleVerticalLeft: u8						= 0xB9;	// ╣
		var BoxDoubleVertical: u8							= 0xBA;	// ║
		var BoxDoubleDownLeft: u8							= 0xBB;	// ╗
		var BoxDoubleUpLeft: u8								= 0xBC;	// ╝
		var BoxUpDoubleLeftSingle: u8						= 0xBD;	// ╜
		var BoxUpSingleLeftDouble: u8						= 0xBE;	// ╛
		var BoxDownLeft: u8									= 0xBF;	// ┐
		var BoxUpRight: u8									= 0xC0;	// └
		var BoxUpHorizontal: u8								= 0xC1;	// ┴
		var BoxDownHorizontal: u8							= 0xC2;	// ┬
		var BoxVerticalRight: u8							= 0xC3;	// ├
		var BoxHorizontal: u8								= 0xC4;	// ─
		var BoxVerticalHorizontal: u8						= 0xC5;	// ┼
		var BoxVerticalSingleRightDouble: u8				= 0xC6;	// ╞
		var BoxVerticalDoubleRightSingle: u8				= 0xC7;	// ╟
		var BoxDoubleUpRight: u8							= 0xC8;	// ╚
		var BoxDoubleDownRight: u8							= 0xC9;	// ╔
		var BoxDoubleUpHorizontal: u8						= 0xCA;	// ╩
		var BoxDoubleDownHorizontal: u8						= 0xCB;	// ╦
		var BoxDoubleVerticalRight: u8						= 0xCC;	// ╠
		var BoxDoubleHorizontal: u8							= 0xCD;	// ═
		var BoxDoubleVerticalHorizontal: u8					= 0xCE;	// ╬
		var BoxUpSingleHorizontalDouble: u8					= 0xCF;	// ╧
		var BoxUpDoubleHorizontalSingle: u8					= 0xD0;	// ╨
		var BoxDownSingleHorizontalDouble: u8				= 0xD1;	// ╤
		var BoxDownDoubleHorizontalSingle: u8				= 0xD2;	// ╥
		var BoxUpDoubleRightSingle: u8						= 0xD3;	// ╙
		var BoxUpSingleRightDouble: u8						= 0xD4;	// ╘
		var BoxDownSingleRightDouble: u8					= 0xD5;	// ╒
		var BoxDownDoubleRightSingle: u8					= 0xD6;	// ╓
		var BoxVerticalDoubleHorizontalSingle: u8			= 0xD7;	// ╫
