#include(hardware.ds)

namespace dr {
	// Milliseconds since the machine started (the timer device). Wraps after about 49.7 days:
	// measure intervals as millis() - start, which stays right across the wrap.
	inline sub millis() -> u32 {
		return *cast<u32*>(TimerRegisters.Milliseconds);
	}

	// The low 32 bits of the cycles executed since the machine started (for short measurements:
	// cycles() - start is right up to 2^32 cycles).
	inline sub cycles() -> u32 {
		return *cast<u32*>(TimerRegisters.CyclesLow);
	}

	// Waits ms milliseconds, by the timer: right at any clock speed (also uncapped). Interrupts
	// keep running meanwhile (their handlers' time counts as part of the wait).
	sub sleep(var ms: i32) {
		if (ms <= 0)
			return;
		var start: u32 = millis();
		while (millis() - start < cast<u32>(ms));
	}

	// value as text, with `decimals` digits after the point (0..9, rounded): -12.500000. From
	// 1e9 on, in scientific notation: 1.234568e+12. Also "inf", "-inf", "nan" (and -0.000000).
	// result needs 24 bytes. An f32 has about 7 significant digits (and this is computed in
	// f32): the digits after those are not meaningful.
	sub ftoa(var value: f32, var result: u8*, var decimals: u32 = 6) -> string {
		var p: u8* = result;
		if (value != value) {
			p[0] = 'n'; p[1] = 'a'; p[2] = 'n'; p[3] = 0;
			return result;
		}
		if ((*cast<u32*>(&value) & 0x80000000) != 0) {		// also -0.0
			*p = '-';
			p++;
			value = -value;
		}
		if (value == 1.0 / 0.0) {
			p[0] = 'i'; p[1] = 'n'; p[2] = 'f'; p[3] = 0;
			return result;
		}
		if (decimals > 9)
			decimals = 9;
		var exponent: u32 = 0;
		var scientific: bool = value >= 1e9;
		if (scientific) {
			while (value >= 10.0) {
				value /= 10.0;
				exponent++;
			}
		}
		var half: f32 = 0.5;
		for (var i: u32 = 0; i < decimals; i++)
			half /= 10.0;
		value += half;
		if (scientific and value >= 10.0) {
			value /= 10.0;
			exponent++;
		}
		var whole: u32 = cast<u32>(value);
		var frac: f32 = value - whole;
		utoa(whole, p);
		while (*p != 0)
			p++;
		if (decimals > 0) {
			*p = '.';
			p++;
			for (var i: u32 = 0; i < decimals; i++) {
				frac *= 10.0;
				var digit: u32 = cast<u32>(frac);
				if (digit > 9)
					digit = 9;
				*p = cast<u8>('0' + digit);
				p++;
				frac -= digit;
			}
		}
		if (scientific) {
			p[0] = 'e';
			p[1] = '+';
			p += 2;
			if (exponent < 10) {
				*p = '0';
				p++;
			}
			utoa(exponent, p);
			while (*p != 0)
				p++;
		}
		*p = 0;
		return result;
	}

	sub itoa(var value: i32, var result: u8*, var base: i32 = 10) -> string
	{
		// check that the base if valid
		if (base < 2 or base > 36) { *result = '\0'; return result; }

		var ptr: u8* = result;
		var ptr1: u8* = result;
		var tmp_char: u8;
		var tmp_value: i32;

		do {
			tmp_value = value;
	        value /= base;
	        *ptr++ = "zyxwvutsrqponmlkjihgfedcba9876543210123456789abcdefghijklmnopqrstuvwxyz" [35 + (tmp_value - value * base)];
	    } while (value);

		// Apply negative sign
	    if (tmp_value < 0) *ptr++ = '-';
	    *ptr-- = '\0';

	    // Reverse the string
	    while(ptr1 < ptr) {
	        tmp_char = *ptr;
	        *ptr--= *ptr1;
	        *ptr1++ = tmp_char;
	    }
	    return result;
	}

	// Like itoa, for an unsigned integer (result: up to 33 bytes, in base 2; 11 in base 10).
	sub utoa(var value: u32, var result: u8*, var base: i32 = 10) -> string
	{
		// check that the base if valid
		if (base < 2 or base > 36) { *result = '\0'; return result; }

		var ubase: u32 = cast<u32>(base);
		var ptr: u8* = result;
		var ptr1: u8* = result;
		var tmp_char: u8;

		do {
			*ptr++ = "0123456789abcdefghijklmnopqrstuvwxyz" [value % ubase];
			value /= ubase;
		} while (value);
		*ptr-- = '\0';

		// Reverse the string
		while (ptr1 < ptr) {
			tmp_char = *ptr;
			*ptr-- = *ptr1;
			*ptr1++ = tmp_char;
		}
		return result;
	}

	inline sub isprint(var c: u32) -> bool {
		return c >= 0x20 && c <= 0x7E;
	}

	sub format_size(var bytes: u32, var out: u8*, var skipUnit: bool = false, var forceUnit: i32 = -1) -> i32 {
		const __units: string[] = { "B", "KiB", "MiB", "GiB" };
		var write_u32 = sub(var p: u8*, var n: u32) -> u8* {
			var tmp: u8[10];
			var i: i32 = 0;
			do {
				tmp[i++] = cast<u8>('0' + n % 10);
				n /= 10;
			} while(n);
			while (i)
				*p++ = tmp[--i];
			return p;
		};
		var p: u8* = out;
		var unit: u32 = 0;
		if (forceUnit >= 0)
		{
			unit = cast<u32>(forceUnit);
			if (unit > 3)
				unit = 3;
		}
		else
		{
			while (unit < 3 && bytes >= (1 << (10 * (unit + 1))))
				unit++;
		}
		if (unit == 0)
		{
			p = write_u32(p, bytes);
		}
		else
		{
			var shift: u32 = 10 * unit;
			var whole: u32 = bytes >> shift;
			var frac: u32 = (bytes >> (shift - 10)) & 1023;
			var tenths: u32 = (frac * 10 + 512) >> 10;

			if (tenths == 10)
			{
				tenths = 0;
				whole++;
				if (whole == 1024 && unit < 3 && forceUnit < 0)
				{
					whole = 1;
					unit++;
				}
			}
			p = write_u32(p, whole);
			*p++ = '.';
			*p++ = cast<u8>('0' + tenths);
		}
		if (!skipUnit)
		{
			*p++ = ' ';
			for (var u: u8* = __units[unit]; *u; )
				*p++ = *u++;
		}
		*p = '\0';
		return cast<i32>(p - out);
	}
}
