#include(hardware.ds)

namespace dr {
	atomic sub sleep(var ms: i32) {
		var clock_speed_hz: u32 = read_cmos(dr::CMOSRegisters.ClockSpeed);
		var cycles_per_ms: u32 = clock_speed_hz / 1000;
		var sleep_cycles: u32 = ms * cycles_per_ms;
		sleep_cycles /= 2; // The loop is 2 instructions
		low {
			mov ACC, 0
			mov R9, $sleep_cycles
			___sleep_loop___:
				dec R
				jgr $___sleep_loop___, R9
		}
	}

	sub itoa(var value: i32, var result: u8*, var base: i32 = 10) -> string
	{
		// check that the base if valid
		if (base < 2 or base > 36) { *result = '\0'; return result; }

		var ptr: u8* = result;
		var ptr1: u8* = result;
		var tmp_char: u8;
		var tmp_value: i32;

		do {
			tmp_value = value;
	        value /= base;
	        *ptr++ = "zyxwvutsrqponmlkjihgfedcba9876543210123456789abcdefghijklmnopqrstuvwxyz" [35 + (tmp_value - value * base)];
	    } while (value);

		// Apply negative sign
	    if (tmp_value < 0) *ptr++ = '-';
	    *ptr-- = '\0';

	    // Reverse the string
	    while(ptr1 < ptr) {
	        tmp_char = *ptr;
	        *ptr--= *ptr1;
	        *ptr1++ = tmp_char;
	    }
	    return result;
	}

	// Like itoa, for an unsigned integer (result: up to 33 bytes, in base 2; 11 in base 10).
	sub utoa(var value: u32, var result: u8*, var base: i32 = 10) -> string
	{
		// check that the base if valid
		if (base < 2 or base > 36) { *result = '\0'; return result; }

		var ubase: u32 = cast<u32>(base);
		var ptr: u8* = result;
		var ptr1: u8* = result;
		var tmp_char: u8;

		do {
			*ptr++ = "0123456789abcdefghijklmnopqrstuvwxyz" [value % ubase];
			value /= ubase;
		} while (value);
		*ptr-- = '\0';

		// Reverse the string
		while (ptr1 < ptr) {
			tmp_char = *ptr;
			*ptr-- = *ptr1;
			*ptr1++ = tmp_char;
		}
		return result;
	}

	inline sub isprint(var c: u32) -> bool {
		return c >= 0x20 && c <= 0x7E;
	}

	sub format_size(var bytes: u32, var out: u8*, var skipUnit: bool = false, var forceUnit: i32 = -1) -> i32 {
		const __units: string[] = { "B", "KiB", "MiB", "GiB" };
		var write_u32 = sub(var p: u8*, var n: u32) -> u8* {
			var tmp: u8[10];
			var i: i32 = 0;
			do {
				tmp[i++] = cast<u8>('0' + n % 10);
				n /= 10;
			} while(n);
			while (i)
				*p++ = tmp[--i];
			return p;
		};
		var p: u8* = out;
		var unit: u32 = 0;
		if (forceUnit >= 0)
		{
			unit = cast<u32>(forceUnit);
			if (unit > 3)
				unit = 3;
		}
		else
		{
			while (unit < 3 && bytes >= (1 << (10 * (unit + 1))))
				unit++;
		}
		if (unit == 0)
		{
			p = write_u32(p, bytes);
		}
		else
		{
			var shift: u32 = 10 * unit;
			var whole: u32 = bytes >> shift;
			var frac: u32 = (bytes >> (shift - 10)) & 1023;
			var tenths: u32 = (frac * 10 + 512) >> 10;

			if (tenths == 10)
			{
				tenths = 0;
				whole++;
				if (whole == 1024 && unit < 3 && forceUnit < 0)
				{
					whole = 1;
					unit++;
				}
			}
			p = write_u32(p, whole);
			*p++ = '.';
			*p++ = cast<u8>('0' + tenths);
		}
		if (!skipUnit)
		{
			*p++ = ' ';
			for (var u: u8* = __units[unit]; *u; )
				*p++ = *u++;
		}
		*p = '\0';
		return cast<i32>(p - out);
	}
}
