// DScript SDK: DFS, the Dragon File System.
//
// The port of the C++ core (src/storage/dfs/DfsCore.cpp, which dtools and the debugger use);
// the two are kept function for function the same. The format is documented in
// other/info/dfs.md.
//
// A simplified ext2: superblock, inode bitmap, block bitmap, inode table, data blocks. Inodes
// have 12 direct pointers, a single-indirect and a double-indirect one. Directories are files of
// fixed size entries.
//
//   - Every fallible sub returns an i32: >= 0 success (or a value), < 0 an error (NotFound, ...;
//     error_name() describes one). Struct results go through out pointers.
//   - The disk is reached through a Device (sub pointers over partition relative bytes):
//     disk_device() makes one for a partition of a machine disk (through the BIOS, int 0x20).
//   - All the memory DFS needs is in a Volume (about 28 KiB: allocate it, don't put it on the
//     stack). No globals: the SDK stays usable in ROM.
//   - On disk integers are big endian, like the machine: the on disk structures are copied as
//     they are.
#include(dragon.ds)
#include(int.ds)
#include(dpt.ds)

namespace dr::dfs {
	// ---- Errors ----
	const Ok: i32 = 0;
	const NotFound: i32 = -1;
	const Exists: i32 = -2;
	const NoSpace: i32 = -3;
	const NotDir: i32 = -4;
	const IsDir: i32 = -5;
	const NotEmpty: i32 = -6;
	const Invalid: i32 = -7;
	const IOError: i32 = -8;
	const Corrupt: i32 = -9;
	const TooBig: i32 = -10;
	const NameTooLong: i32 = -11;
	const ReadOnly: i32 = -12;
	const Unsupported: i32 = -13;
	const TooManyLinks: i32 = -14;

	// ---- Fixed format constants ----
	const Magic: u32 = 0x44465331;			// 'DFS1'
	const Version: u32 = 1;
	const BootHeaderSize: u32 = 0x20;		// the start of the partition, never written by DFS (DPT boot header)
	const SuperblockOffset: u32 = 0x20;		// fixed byte offset, whatever the block size
	const SuperblockSize: u32 = 256;
	const InodeSize: u32 = 128;				// what mkfs writes (mount uses the superblock's)
	const DirEntrySize: u32 = 64;			// same
	const DirectPointers: u32 = 12;
	const RootInode: u32 = 1;
	const FirstInode: u32 = 8;				// 0 is null, 1 the root, 2-7 reserved (2: future journal)
	const MinBlockSizeLog2: u32 = 9;		// 512 B
	const MaxBlockSizeLog2: u32 = 12;		// 4 KiB
	const MaxBlockSize: u32 = 4096;
	const MaxNameLength: u32 = 56;
	const StateClean: u32 = 1;
	const StateDirty: u32 = 2;

	// Inode modes (the Unix encoding: the type in the high 4 bits, permissions in the low 12).
	const ModeTypeMask: u16 = 0xF000;
	const ModeFile: u16 = 0x8000;
	const ModeDir: u16 = 0x4000;
	const ModeCharDevice: u16 = 0x2000;
	const ModeSymlink: u16 = 0xA000;		// reserved, not implemented
	const ModePermMask: u16 = 0x0FFF;

	// Directory entry: inode (u32), name length (u8), type (u8, mode >> 12), reserved (u16), name (56).
	const DirEntInode: u32 = 0;
	const DirEntNameLen: u32 = 4;
	const DirEntType: u32 = 5;
	const DirEntName: u32 = 8;

	// ---- The device: partition relative byte offsets (the backend adds the partition's start) ----
	struct Device {
		var user: void*;
		var read: sub(void*, u32, u8*, u32) -> i32;		// (user, offset, buffer, size): Ok or IOError
		var write: sub(void*, u32, u8*, u32) -> i32;	// same
		var now: sub(void*) -> u32;						// seconds (any epoch), may be null
	};

	// ---- On disk structures (the machine is big endian: in memory exactly as on disk) ----
	struct Superblock {					// 256 bytes, at SuperblockOffset
		var magic: u32;
		var version: u32;
		var block_size_log2: u32;
		var total_blocks: u32;
		var inode_count: u32;
		var inode_size: u32;
		var dirent_size: u32;
		var inode_bitmap_block: u32;
		var inode_bitmap_len: u32;
		var block_bitmap_block: u32;
		var block_bitmap_len: u32;
		var inode_table_block: u32;
		var inode_table_len: u32;
		var first_data_block: u32;
		var root_inode: u32;
		var first_inode: u32;
		var free_blocks: u32;
		var free_inodes: u32;
		var feature_compat: u32;		// unknown bits: ignored
		var feature_ro_compat: u32;		// unknown bits: mounted read only
		var feature_incompat: u32;		// unknown bits: not mounted
		var state: u32;					// StateClean / StateDirty
		var mount_count: u32;
		var created: u32;
		var last_mount: u32;
		var last_write: u32;
		var journal_inode: u32;			// 0 (reserved)
		var checksum: u32;				// 0 (reserved)
		var uuid: u8[16];
		var label: u8[16];				// not null terminated when 16 long
		var reserved: u8[112];
	};

	struct Inode {						// 128 bytes
		var mode: u16;					// 0x00
		var links: u16;					// 0x02
		var uid: u16;					// 0x04
		var gid: u16;					// 0x06
		var flags: u32;					// 0x08
		var size: u32;					// 0x0C
		var reserved0: u32;				// 0x10  reserved (would be size_hi)
		var atime: u32;					// 0x14  set at creation only (reads don't write the inode)
		var mtime: u32;					// 0x18
		var ctime: u32;					// 0x1C
		var crtime: u32;				// 0x20
		var direct: u32[12];			// 0x24
		var indirect: u32;				// 0x54
		var dindirect: u32;				// 0x58
		var reserved1: u32;				// 0x5C  reserved (would be tindirect)
		var xattr: u32;					// 0x60  reserved
		var checksum: u32;				// 0x64  reserved
		var reserved: u8[24];			// 0x68
	};

	struct DirEntry {					// a decoded directory entry
		var inode: u32;
		var type: u8;
		var name_len: u8;
		var name: u8[57];				// null terminated
	};

	struct Layout {
		var block_size_log2: u32;
		var block_size: u32;
		var block_mask: u32;			// block_size - 1
		var total_blocks: u32;
		var inode_count: u32;
		var inode_size: u32;
		var dirent_size: u32;
		var inodes_per_block: u32;
		var pointers_per_block: u32;
		var dirents_per_block: u32;
		var bits_per_block: u32;
		var inode_bitmap_block: u32;
		var inode_bitmap_len: u32;
		var block_bitmap_block: u32;
		var block_bitmap_len: u32;
		var inode_table_block: u32;
		var inode_table_len: u32;
		var first_data_block: u32;
	};

	struct MkfsParams {
		var partition_size: u32;		// bytes
		var block_size_log2: u32;		// 9..12 (0: 12)
		var bytes_per_inode: u32;		// 0: 16384
		var label: string;				// may be null
		var uuid: u8*;					// 16 bytes, may be null
	};

	// The mounted volume. All the memory DFS needs is in here: the block buffers have a role
	// each (which subs use which is noted on the subs).
	// The buffers must stay 4 byte aligned (DScript structs are packed: every field before
	// them is a multiple of 4 bytes, the bools and u16s go at the end). mem_copy copies words
	// only between aligned addresses: misaligned buffers make every block copy ~9 times slower.
	struct Volume {
		var dev: Device;
		var layout: Layout;
		var sb: Superblock;
		var block_hint: u32;			// where the next block search starts (RAM only)
		var inode_hint: u32;
		var ind_block: u32;				// the pointer block buf_ind holds (0: none), see read_pointer_block
		var ind2_block: u32;			// the double indirect block buf_ind2 holds (0: none)

		var buf_meta: u8[4096];			// bitmaps, superblock (allocators)
		var buf_inode: u8[4096];		// inode table blocks (read_inode / write_inode)
		var buf_ind: u8[4096];			// a pointer block (bmap, truncate): cached, ind_block says which
		var buf_ind2: u8[4096];			// a double indirect block (bmap, truncate): cached, ind2_block says which
		var buf_data: u8[4096];			// partial data blocks (inode_read / inode_write), truncate's scratch
		var buf_dir: u8[4096];			// the directory block being looked at (dir_*)
		var buf_zero: u8[4096];			// always zero

		var read_only: bool;
		var mounted: bool;
		var uid: u16;					// given to new inodes
		var gid: u16;
	};

	// ============================================================================
	// Helpers
	// ============================================================================
	// Word copies, 8 per round, when everything is 4 byte aligned (block buffers and on disk
	// structures always are): most of DFS's time is spent copying blocks.
	sub mem_copy(var dst: void*, var src: void*, var size: u32) {
		var d: u8* = cast<u8*>(dst);
		var s: u8* = cast<u8*>(src);
		if (((cast<u32>(d) | cast<u32>(s) | size) & 3) == 0) {
			var dw: u32* = cast<u32*>(dst);
			var sw: u32* = cast<u32*>(src);
			var rounds: u32 = size >> 5;
			while (rounds > 0) {
				dw[0] = sw[0]; dw[1] = sw[1]; dw[2] = sw[2]; dw[3] = sw[3];
				dw[4] = sw[4]; dw[5] = sw[5]; dw[6] = sw[6]; dw[7] = sw[7];
				dw += 8;
				sw += 8;
				rounds--;
			}
			var words: u32 = (size >> 2) & 7;
			while (words > 0) {
				*dw = *sw;
				dw++;
				sw++;
				words--;
			}
			return;
		}
		for (var i: u32 = 0; i < size; i++)
			d[i] = s[i];
	}

	sub mem_set(var dst: void*, var value: u8, var size: u32) {
		var d: u8* = cast<u8*>(dst);
		if (((cast<u32>(d) | size) & 3) == 0) {
			var dw: u32* = cast<u32*>(dst);
			var v: u32 = value;
			v = v | (v << 8);
			v = v | (v << 16);
			var rounds: u32 = size >> 5;
			while (rounds > 0) {
				dw[0] = v; dw[1] = v; dw[2] = v; dw[3] = v;
				dw[4] = v; dw[5] = v; dw[6] = v; dw[7] = v;
				dw += 8;
				rounds--;
			}
			var words: u32 = (size >> 2) & 7;
			while (words > 0) {
				*dw = v;
				dw++;
				words--;
			}
			return;
		}
		for (var i: u32 = 0; i < size; i++)
			d[i] = value;
	}

	sub mem_equal(var a: u8*, var b: u8*, var size: u32) -> bool {
		for (var i: u32 = 0; i < size; i++) {
			if (a[i] != b[i])
				return false;
		}
		return true;
	}

	sub str_len(var str: u8*) -> u32 {
		var len: u32 = 0;
		while (str[len] != 0)
			len++;
		return len;
	}

	// Big endian loads and stores (the machine's order: plain accesses).
	inline sub get16(var p: u8*) -> u16 { return *cast<u16*>(p); }
	inline sub get32(var p: u8*) -> u32 { return *cast<u32*>(p); }
	inline sub put16(var p: u8*, var value: u16) { *cast<u16*>(p) = value; }
	inline sub put32(var p: u8*, var value: u32) { *cast<u32*>(p) = value; }

	sub div_up(var a: u32, var b: u32) -> u32 {
		return a / b + (a % b != 0 ? 1 : 0);
	}

	inline sub is_dir(var node: Inode*) -> bool {
		return (node->mode & ModeTypeMask) == ModeDir;
	}

	sub is_dot_name(var name: u8*, var len: u32) -> bool {
		return (len == 1 and name[0] == '.') or (len == 2 and name[0] == '.' and name[1] == '.');
	}

	// The error's description ("not found").
	sub error_name(var error: i32) -> string {
		if (error == Ok) return "ok";
		if (error == NotFound) return "not found";
		if (error == Exists) return "already exists";
		if (error == NoSpace) return "no space left";
		if (error == NotDir) return "not a directory";
		if (error == IsDir) return "is a directory";
		if (error == NotEmpty) return "directory not empty";
		if (error == Invalid) return "invalid argument";
		if (error == IOError) return "I/O error";
		if (error == Corrupt) return "corrupted file system";
		if (error == TooBig) return "file too big";
		if (error == NameTooLong) return "name too long";
		if (error == ReadOnly) return "read only file system";
		if (error == Unsupported) return "unsupported file system";
		if (error == TooManyLinks) return "too many links";
		return "unknown error";
	}

	// ============================================================================
	// L0: device
	// ============================================================================
	sub now(var vol: Volume*) -> u32 {
		if (vol->dev.now == null)
			return 0;
		return vol->dev.now(vol->dev.user);
	}

	sub dev_read(var vol: Volume*, var offset: u32, var buffer: u8*, var size: u32) -> i32 {
		if (vol->dev.read(vol->dev.user, offset, buffer, size) < 0)
			return IOError;
		return Ok;
	}

	// Every write goes through here, so a read only volume can't write anything.
	sub dev_write(var vol: Volume*, var offset: u32, var buffer: u8*, var size: u32) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		if (vol->dev.write(vol->dev.user, offset, buffer, size) < 0)
			return IOError;
		return Ok;
	}

	sub read_block(var vol: Volume*, var block: u32, var buffer: u8*) -> i32 {
		if (block == 0 or block >= vol->layout.total_blocks)
			return Corrupt;
		return dev_read(vol, block << vol->layout.block_size_log2, buffer, vol->layout.block_size);
	}

	// Every block write goes through here: a block the pointer caches hold, written from another
	// buffer (e.g. freed, then reused for data), is dropped from them.
	sub write_block(var vol: Volume*, var block: u32, var buffer: u8*) -> i32 {
		if (block == 0 or block >= vol->layout.total_blocks)
			return Corrupt;
		if (block == vol->ind_block and buffer != vol->buf_ind)
			vol->ind_block = 0;
		if (block == vol->ind2_block and buffer != vol->buf_ind2)
			vol->ind2_block = 0;
		return dev_write(vol, block << vol->layout.block_size_log2, buffer, vol->layout.block_size);
	}

	// The pointer block caches: buf_ind (single indirect blocks and the blocks a double indirect
	// one points to) and buf_ind2 (double indirect blocks) keep the last block read, so reading a
	// file in order reads each pointer block once instead of once per data block. They stay
	// right because the blocks are only changed in these buffers (then written) or through
	// write_block, which drops them.
	sub read_pointer_block(var vol: Volume*, var block: u32, var dindirect: bool, var out_result: i32*) -> u8* {
		var buffer: u8* = (dindirect ? vol->buf_ind2 : vol->buf_ind);
		var cached: u32* = (dindirect ? &vol->ind2_block : &vol->ind_block);
		*out_result = Ok;
		if (*cached == block and block != 0)
			return buffer;
		*cached = 0;
		*out_result = read_block(vol, block, buffer);
		if (*out_result == Ok)
			*cached = block;
		return buffer;
	}

	// ============================================================================
	// Layout
	// ============================================================================
	sub layout_compute(var l: Layout*, var log2: u32, var total_blocks: u32, var inode_count: u32, var inode_size: u32, var dirent_size: u32) -> i32 {
		l->block_size_log2 = log2;
		l->block_size = cast<u32>(1) << log2;
		l->block_mask = l->block_size - 1;
		l->total_blocks = total_blocks;
		l->inode_count = inode_count;
		l->inode_size = inode_size;
		l->dirent_size = dirent_size;
		l->inodes_per_block = l->block_size / inode_size;
		l->pointers_per_block = l->block_size / 4;
		l->dirents_per_block = l->block_size / dirent_size;
		l->bits_per_block = l->block_size * 8;
		if (inode_count <= FirstInode or inode_count % l->inodes_per_block != 0)
			return Invalid;
		l->inode_bitmap_block = 1;
		l->inode_bitmap_len = div_up(inode_count, l->bits_per_block);
		l->block_bitmap_block = l->inode_bitmap_block + l->inode_bitmap_len;
		l->block_bitmap_len = div_up(total_blocks, l->bits_per_block);
		l->inode_table_block = l->block_bitmap_block + l->block_bitmap_len;
		l->inode_table_len = inode_count / l->inodes_per_block;
		l->first_data_block = l->inode_table_block + l->inode_table_len;
		if (l->first_data_block >= total_blocks or l->inode_table_len > total_blocks)
			return Invalid;
		return Ok;
	}

	sub layout_from_params(var out: Layout*, var partition_size: u32, var block_size_log2: u32, var bytes_per_inode: u32) -> i32 {
		if (block_size_log2 < MinBlockSizeLog2 or block_size_log2 > MaxBlockSizeLog2 or bytes_per_inode < InodeSize)
			return Invalid;
		var block_size: u32 = cast<u32>(1) << block_size_log2;
		var inodes_per_block: u32 = block_size / InodeSize;
		var count: u32 = partition_size / bytes_per_inode;
		if (count < inodes_per_block)
			count = inodes_per_block;
		if (count <= FirstInode)
			count = FirstInode * 2;
		count = div_up(count, inodes_per_block) * inodes_per_block;
		return layout_compute(out, block_size_log2, partition_size >> block_size_log2, count, InodeSize, DirEntrySize);
	}

	sub layout_from_superblock(var out: Layout*, var sb: Superblock*) -> i32 {
		if (sb->block_size_log2 < MinBlockSizeLog2 or sb->block_size_log2 > MaxBlockSizeLog2)
			return Corrupt;
		var block_size: u32 = cast<u32>(1) << sb->block_size_log2;
		if (sb->inode_size < InodeSize or block_size % sb->inode_size != 0)
			return Corrupt;
		if (sb->dirent_size < DirEntrySize or block_size % sb->dirent_size != 0)
			return Corrupt;
		if (layout_compute(out, sb->block_size_log2, sb->total_blocks, sb->inode_count, sb->inode_size, sb->dirent_size) < 0)
			return Corrupt;
		if (out->inode_bitmap_block != sb->inode_bitmap_block or out->inode_bitmap_len != sb->inode_bitmap_len
				or out->block_bitmap_block != sb->block_bitmap_block or out->block_bitmap_len != sb->block_bitmap_len
				or out->inode_table_block != sb->inode_table_block or out->inode_table_len != sb->inode_table_len
				or out->first_data_block != sb->first_data_block)
			return Corrupt;
		return Ok;
	}

	// ============================================================================
	// L2: allocators (buf_meta)
	// ============================================================================
	// Finds a clear bit (searching from *hint, wrapping around), sets it and writes the bitmap.
	sub bitmap_alloc(var vol: Volume*, var bitmap_block: u32, var bitmap_len: u32, var count: u32, var hint: u32*, var out: u32*) -> i32 {
		var bits: u32 = vol->layout.bits_per_block;
		var start: u32 = (*hint < count ? *hint : 0);
		var first: u32 = start / bits;
		// One more round than there are blocks: the last one looks at the start of the first block.
		for (var k: u32 = 0; k <= bitmap_len; k++) {
			var b: u32 = (first + k) % bitmap_len;
			var r: i32 = read_block(vol, bitmap_block + b, vol->buf_meta);
			if (r < 0) return r;
			var first_byte: u32 = (k == 0 ? (start % bits) / 8 : 0);
			for (var i: u32 = first_byte; i < vol->layout.block_size; i++) {
				var byte: u32 = vol->buf_meta[i];
				if (byte == 0xFF)
					continue;
				var bit: u32 = 0;
				while ((byte & (cast<u32>(1) << bit)) != 0)
					bit++;
				var n: u32 = b * bits + i * 8 + bit;
				if (n >= count)
					break;
				vol->buf_meta[i] = cast<u8>(byte | (cast<u32>(1) << bit));
				r = write_block(vol, bitmap_block + b, vol->buf_meta);
				if (r < 0) return r;
				*hint = n + 1;
				*out = n;
				return Ok;
			}
		}
		return NoSpace;
	}

	sub bitmap_free(var vol: Volume*, var bitmap_block: u32, var n: u32) -> i32 {
		var block: u32 = bitmap_block + n / vol->layout.bits_per_block;
		var bit: u32 = n % vol->layout.bits_per_block;
		var r: i32 = read_block(vol, block, vol->buf_meta);
		if (r < 0) return r;
		var mask: u32 = cast<u32>(1) << (bit % 8);
		if ((vol->buf_meta[bit / 8] & mask) == 0)
			return Corrupt;		// already free
		vol->buf_meta[bit / 8] = cast<u8>(vol->buf_meta[bit / 8] & ~mask);
		return write_block(vol, block, vol->buf_meta);
	}

	// Sets the bits [from, to) (mkfs).
	sub bitmap_mark(var vol: Volume*, var bitmap_block: u32, var from: u32, var to: u32) -> i32 {
		var bits: u32 = vol->layout.bits_per_block;
		var current: u32 = 0xFFFFFFFF;
		var r: i32 = Ok;
		for (var n: u32 = from; n < to; n++) {
			if (n / bits != current) {
				if (current != 0xFFFFFFFF) {
					r = write_block(vol, bitmap_block + current, vol->buf_meta);
					if (r < 0) return r;
				}
				current = n / bits;
				r = read_block(vol, bitmap_block + current, vol->buf_meta);
				if (r < 0) return r;
			}
			var byte: u32 = (n % bits) / 8;
			if ((n & 7) == 0 and to - n >= 8) {
				vol->buf_meta[byte] = 0xFF;		// a whole byte at once
				n += 7;
				continue;
			}
			vol->buf_meta[byte] = cast<u8>(vol->buf_meta[byte] | (cast<u32>(1) << (n % 8)));
		}
		if (current != 0xFFFFFFFF)
			r = write_block(vol, bitmap_block + current, vol->buf_meta);
		return r;
	}

	sub alloc_block(var vol: Volume*, var out_block: u32*) -> i32 {
		if (vol->sb.free_blocks == 0)
			return NoSpace;
		var l: Layout* = &vol->layout;
		var r: i32 = bitmap_alloc(vol, l->block_bitmap_block, l->block_bitmap_len, l->total_blocks, &vol->block_hint, out_block);
		if (r < 0) return r;
		if (*out_block < l->first_data_block)
			return Corrupt;		// mkfs marks the metadata blocks as used
		vol->sb.free_blocks--;
		return Ok;
	}

	sub free_block(var vol: Volume*, var block: u32) -> i32 {
		if (block < vol->layout.first_data_block or block >= vol->layout.total_blocks)
			return Corrupt;
		var r: i32 = bitmap_free(vol, vol->layout.block_bitmap_block, block);
		if (r < 0) return r;
		vol->sb.free_blocks++;
		return Ok;
	}

	sub alloc_inode(var vol: Volume*, var out_ino: u32*) -> i32 {
		if (vol->sb.free_inodes == 0)
			return NoSpace;
		var l: Layout* = &vol->layout;
		var r: i32 = bitmap_alloc(vol, l->inode_bitmap_block, l->inode_bitmap_len, l->inode_count, &vol->inode_hint, out_ino);
		if (r < 0) return r;
		if (*out_ino < FirstInode)
			return Corrupt;		// mkfs marks the reserved inodes as used
		vol->sb.free_inodes--;
		return Ok;
	}

	sub free_inode(var vol: Volume*, var ino: u32) -> i32 {
		if (ino < FirstInode or ino >= vol->layout.inode_count)
			return Corrupt;
		var r: i32 = bitmap_free(vol, vol->layout.inode_bitmap_block, ino);
		if (r < 0) return r;
		vol->sb.free_inodes++;
		return Ok;
	}

	sub alloc_zeroed_block(var vol: Volume*, var out_block: u32*) -> i32 {
		var r: i32 = alloc_block(vol, out_block);
		if (r < 0) return r;
		r = write_block(vol, *out_block, vol->buf_zero);
		if (r < 0) {
			free_block(vol, *out_block);
			*out_block = 0;
		}
		return r;
	}

	// ============================================================================
	// L1: volume
	// ============================================================================
	sub write_superblock(var vol: Volume*) -> i32 {
		return dev_write(vol, SuperblockOffset, cast<u8*>(&vol->sb), SuperblockSize);
	}

	sub mount(var vol: Volume*, var dev: Device*, var read_only: bool) -> i32 {
		vol->dev = *dev;
		vol->mounted = false;
		vol->read_only = true;
		vol->uid = 0;
		vol->gid = 0;
		vol->block_hint = 0;
		vol->inode_hint = 0;
		vol->ind_block = 0;
		vol->ind2_block = 0;
		mem_set(vol->buf_zero, 0, MaxBlockSize);
		var r: i32 = dev_read(vol, SuperblockOffset, cast<u8*>(&vol->sb), SuperblockSize);
		if (r < 0) return r;
		var sb: Superblock* = &vol->sb;
		if (sb->magic != Magic)
			return Unsupported;
		if (sb->version != Version or sb->feature_incompat != 0)
			return Unsupported;
		r = layout_from_superblock(&vol->layout, sb);
		if (r < 0) return r;
		if (sb->root_inode != RootInode or sb->first_inode != FirstInode)
			return Corrupt;
		vol->read_only = (read_only or sb->feature_ro_compat != 0);
		vol->mounted = true;
		if (not vol->read_only) {
			sb->state = StateDirty;
			sb->mount_count++;
			sb->last_mount = now(vol);
			r = write_superblock(vol);
			if (r < 0) {
				vol->mounted = false;
				return r;
			}
		}
		return Ok;
	}

	sub sync(var vol: Volume*) -> i32 {
		if (not vol->mounted or vol->read_only)
			return Ok;
		vol->sb.last_write = now(vol);
		return write_superblock(vol);
	}

	sub unmount(var vol: Volume*) -> i32 {
		if (not vol->mounted)
			return Ok;
		var r: i32 = Ok;
		if (not vol->read_only) {
			vol->sb.state = StateClean;
			vol->sb.last_write = now(vol);
			r = write_superblock(vol);
		}
		vol->mounted = false;
		return r;
	}

	sub fill_dir_entry(var entry: u8*, var size: u32, var ino: u32, var name: u8*, var name_len: u32, var mode: u16) {
		mem_set(entry, 0, size);
		put32(entry + DirEntInode, ino);
		entry[DirEntNameLen] = cast<u8>(name_len);
		entry[DirEntType] = cast<u8>(mode >> 12);
		mem_copy(entry + DirEntName, name, name_len);
	}

	// A new directory's first block (. and ..) in buf_dir.
	sub make_dir_block(var vol: Volume*, var ino: u32, var parent: u32) {
		mem_set(vol->buf_dir, 0, vol->layout.block_size);
		fill_dir_entry(vol->buf_dir, vol->layout.dirent_size, ino, "..", 1, ModeDir);
		fill_dir_entry(vol->buf_dir + vol->layout.dirent_size, vol->layout.dirent_size, parent, "..", 2, ModeDir);
	}

	sub init_inode(var vol: Volume*, var node: Inode*, var mode: u16, var links: u16) {
		mem_set(node, 0, sizeof(Inode));
		node->mode = mode;
		node->links = links;
		node->uid = vol->uid;
		node->gid = vol->gid;
		var t: u32 = now(vol);
		node->atime = t;
		node->mtime = t;
		node->ctime = t;
		node->crtime = t;
	}

	// Formats the partition (and leaves vol unmounted: it is only the workspace).
	sub mkfs(var vol: Volume*, var dev: Device*, var params: MkfsParams*) -> i32 {
		vol->dev = *dev;
		vol->mounted = false;
		vol->read_only = false;
		vol->uid = 0;
		vol->gid = 0;
		vol->ind_block = 0;
		vol->ind2_block = 0;
		mem_set(vol->buf_zero, 0, MaxBlockSize);
		var log2: u32 = (params->block_size_log2 != 0 ? params->block_size_log2 : 12);
		var bytes_per_inode: u32 = (params->bytes_per_inode != 0 ? params->bytes_per_inode : 16384);
		var l: Layout* = &vol->layout;
		var r: i32 = layout_from_params(l, params->partition_size, log2, bytes_per_inode);
		if (r < 0) return r;

		// Bitmaps and inode table: zeros, then the used bits (the reserved inodes, the
		// metadata blocks, and the bits past the end of the last bitmap block).
		for (var b: u32 = l->inode_bitmap_block; b < l->first_data_block; b++) {
			r = write_block(vol, b, vol->buf_zero);
			if (r < 0) return r;
		}
		r = bitmap_mark(vol, l->inode_bitmap_block, 0, FirstInode);
		if (r < 0) return r;
		r = bitmap_mark(vol, l->inode_bitmap_block, l->inode_count, l->inode_bitmap_len * l->bits_per_block);
		if (r < 0) return r;
		r = bitmap_mark(vol, l->block_bitmap_block, 0, l->first_data_block);
		if (r < 0) return r;
		r = bitmap_mark(vol, l->block_bitmap_block, l->total_blocks, l->block_bitmap_len * l->bits_per_block);
		if (r < 0) return r;

		// Block 0: the boot header stays, the rest is the superblock and zeros.
		var tail: u32 = SuperblockOffset + SuperblockSize;
		r = dev_write(vol, tail, vol->buf_zero, l->block_size - tail);
		if (r < 0) return r;
		var sb: Superblock* = &vol->sb;
		mem_set(sb, 0, sizeof(Superblock));
		sb->magic = Magic;
		sb->version = Version;
		sb->block_size_log2 = l->block_size_log2;
		sb->total_blocks = l->total_blocks;
		sb->inode_count = l->inode_count;
		sb->inode_size = l->inode_size;
		sb->dirent_size = l->dirent_size;
		sb->inode_bitmap_block = l->inode_bitmap_block;
		sb->inode_bitmap_len = l->inode_bitmap_len;
		sb->block_bitmap_block = l->block_bitmap_block;
		sb->block_bitmap_len = l->block_bitmap_len;
		sb->inode_table_block = l->inode_table_block;
		sb->inode_table_len = l->inode_table_len;
		sb->first_data_block = l->first_data_block;
		sb->root_inode = RootInode;
		sb->first_inode = FirstInode;
		sb->free_blocks = l->total_blocks - l->first_data_block;
		sb->free_inodes = l->inode_count - FirstInode;
		sb->state = StateClean;
		sb->created = now(vol);
		if (params->label != null) {
			for (var i: u32 = 0; i < 16 and params->label[i] != 0; i++)
				sb->label[i] = params->label[i];
		}
		if (params->uuid != null)
			mem_copy(sb->uuid, params->uuid, 16);
		r = write_superblock(vol);
		if (r < 0) return r;

		// The root directory (its inode is one of the reserved ones, already marked).
		r = mount(vol, dev, false);
		if (r < 0) return r;
		var root: Inode;
		init_inode(vol, &root, cast<u16>(ModeDir | 0x1ED), 2);		// 0755
		make_dir_block(vol, RootInode, RootInode);
		r = inode_write(vol, RootInode, &root, 0, vol->buf_dir, l->block_size);
		var r2: i32 = unmount(vol);
		if (r < 0) return r;
		return r2;
	}

	// ============================================================================
	// L3: inodes
	// ============================================================================
	sub inode_location(var vol: Volume*, var ino: u32, var out_block: u32*, var out_offset: u32*) -> i32 {
		if (ino == 0 or ino >= vol->layout.inode_count)
			return Invalid;
		var byte: u32 = ino * vol->layout.inode_size;
		*out_block = vol->layout.inode_table_block + (byte >> vol->layout.block_size_log2);
		*out_offset = byte & vol->layout.block_mask;
		return Ok;
	}

	sub read_inode(var vol: Volume*, var ino: u32, var out: Inode*) -> i32 {		// buf_inode
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = inode_location(vol, ino, &block, &offset);
		if (r < 0) return r;
		r = read_block(vol, block, vol->buf_inode);
		if (r < 0) return r;
		mem_copy(out, vol->buf_inode + offset, InodeSize);
		return Ok;
	}

	sub write_inode(var vol: Volume*, var ino: u32, var node: Inode*) -> i32 {		// buf_inode
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = inode_location(vol, ino, &block, &offset);
		if (r < 0) return r;
		r = read_block(vol, block, vol->buf_inode);
		if (r < 0) return r;
		mem_copy(vol->buf_inode + offset, node, InodeSize);
		return write_block(vol, block, vol->buf_inode);
	}

	// The disk block of the file's block index, 0 for a hole (when not allocating). Returns 1
	// when the data block was just allocated (its content is garbage), 0 otherwise. May change
	// node's pointers: the caller writes the inode. buf_ind, buf_ind2, buf_zero, buf_meta.
	sub bmap(var vol: Volume*, var node: Inode*, var file_block: u32, var allocate: bool, var out_block: u32*) -> i32 {
		var P: u32 = vol->layout.pointers_per_block;
		*out_block = 0;
		var r: i32 = Ok;
		if (file_block < DirectPointers) {
			if (node->direct[file_block] != 0 or not allocate) {
				*out_block = node->direct[file_block];
				return 0;
			}
			r = alloc_block(vol, &node->direct[file_block]);
			if (r < 0) return r;
			*out_block = node->direct[file_block];
			return 1;
		}

		// The pointer blocks: the path from the inode to the data block.
		var index: u32 = file_block - DirectPointers;
		var levels: u32 = 1;
		var top: u32* = &node->indirect;
		var path: u32[2];
		path[0] = index;
		if (index >= P) {
			index -= P;
			if (index / P >= P)
				return TooBig;
			levels = 2;
			top = &node->dindirect;
			path[0] = index / P;
			path[1] = index % P;
		}
		if (*top == 0) {
			if (not allocate)
				return 0;
			r = alloc_zeroed_block(vol, top);
			if (r < 0) return r;
		}
		var block: u32 = *top;
		var fresh: i32 = 0;
		for (var level: u32 = 0; level < levels; level++) {
			// The double indirect block in buf_ind2, the block with the data pointers in buf_ind.
			var pointers: u8* = read_pointer_block(vol, block, level + 1 < levels, &r);
			if (r < 0) return r;
			var slot: u8* = pointers + path[level] * 4;
			var next: u32 = get32(slot);
			if (next == 0) {
				if (not allocate)
					return 0;
				if (level + 1 < levels)
					r = alloc_zeroed_block(vol, &next);
				else {
					r = alloc_block(vol, &next);
					fresh = 1;
				}
				if (r < 0) return r;
				put32(slot, next);
				r = write_block(vol, block, pointers);
				if (r < 0) return r;
			}
			block = next;
		}
		*out_block = block;
		return fresh;
	}

	// Frees the entries from start of a pointer block of the given depth (1: its entries are
	// data blocks, 2: they are depth 1 pointer blocks). With start 0 the block was already
	// detached from its parent, and is freed too; otherwise it stays, and the entries are
	// cleared on disk before their blocks are freed.
	// depth 1: buf_ind (and buf_data when start > 0); depth 2: buf_ind2 too.
	sub free_tree(var vol: Volume*, var block: u32, var depth: u32, var start: u32) -> i32 {
		var P: u32 = vol->layout.pointers_per_block;
		var size: u32 = vol->layout.block_size;
		var r: i32 = Ok;
		var entries: u8* = null;
		var first: u32 = start;
		if (depth == 1) {
			if (start >= P)
				return Ok;
			entries = read_pointer_block(vol, block, false, &r);
			if (r < 0) return r;
		}
		else {
			first = start / P;
			if (first >= P)
				return Ok;
			entries = read_pointer_block(vol, block, true, &r);
			if (r < 0) return r;
			if (start % P != 0) {
				// The first child keeps some of its entries.
				var child: u32 = get32(entries + first * 4);
				if (child != 0) {
					r = free_tree(vol, child, 1, start % P);
					if (r < 0) return r;
				}
				first++;
			}
		}
		if (start > 0 and first < P) {
			// Detach the entries on disk, keeping a copy to free them from.
			mem_copy(vol->buf_data, entries, size);
			mem_set(entries + first * 4, 0, (P - first) * 4);
			r = write_block(vol, block, entries);
			if (r < 0) return r;
			entries = vol->buf_data;
		}
		for (var i: u32 = first; i < P; i++) {
			var child: u32 = get32(entries + i * 4);
			if (child == 0)
				continue;
			if (depth == 1)
				r = free_block(vol, child);
			else
				r = free_tree(vol, child, 1, 0);		// buf_ind only: buf_data (entries) stays
			if (r < 0) return r;
		}
		if (start == 0)
			r = free_block(vol, block);
		return r;
	}

	// Frees the blocks after new_size (pointer blocks included) and writes the inode.
	// buf_ind, buf_ind2, buf_data, buf_meta, buf_inode.
	sub truncate(var vol: Volume*, var ino: u32, var node: Inode*, var new_size: u32) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var l: Layout* = &vol->layout;
		var P: u32 = l->pointers_per_block;
		var r: i32 = Ok;
		if (new_size >= node->size) {
			// Growing: the new bytes are a hole.
			node->size = new_size;
			node->mtime = now(vol);
			node->ctime = node->mtime;
			return write_inode(vol, ino, node);
		}
		var keep: u32 = (new_size >> l->block_size_log2) + ((new_size & l->block_mask) != 0 ? 1 : 0);

		// Zero the tail of the last block kept (so growing again reads zeros).
		if ((new_size & l->block_mask) != 0) {
			var block: u32 = 0;
			r = bmap(vol, node, new_size >> l->block_size_log2, false, &block);
			if (r < 0) return r;
			if (block != 0) {
				r = read_block(vol, block, vol->buf_data);
				if (r < 0) return r;
				var offset: u32 = new_size & l->block_mask;
				mem_set(vol->buf_data + offset, 0, l->block_size - offset);
				r = write_block(vol, block, vol->buf_data);
				if (r < 0) return r;
			}
		}

		// Detach in the inode what goes entirely, write it, then free.
		var old_direct: u32[12];
		for (var i: u32 = 0; i < DirectPointers; i++) {
			old_direct[i] = 0;
			if (i >= keep) {
				old_direct[i] = node->direct[i];
				node->direct[i] = 0;
			}
		}
		var old_indirect: u32 = 0;
		var old_dindirect: u32 = 0;
		if (keep <= DirectPointers) {
			old_indirect = node->indirect;
			node->indirect = 0;
		}
		if (keep <= DirectPointers + P) {
			old_dindirect = node->dindirect;
			node->dindirect = 0;
		}
		node->size = new_size;
		node->mtime = now(vol);
		node->ctime = node->mtime;
		r = write_inode(vol, ino, node);
		if (r < 0) return r;

		for (var j: u32 = 0; j < DirectPointers; j++) {
			if (old_direct[j] != 0) {
				r = free_block(vol, old_direct[j]);
				if (r < 0) return r;
			}
		}
		if (old_indirect != 0)
			r = free_tree(vol, old_indirect, 1, 0);
		else if (node->indirect != 0)
			r = free_tree(vol, node->indirect, 1, keep - DirectPointers);
		if (r < 0) return r;
		if (old_dindirect != 0)
			r = free_tree(vol, old_dindirect, 2, 0);
		else if (node->dindirect != 0)
			r = free_tree(vol, node->dindirect, 2, keep - DirectPointers - P);
		return r;
	}

	// ============================================================================
	// L4: inode data
	// ============================================================================
	// Bytes read (stops at the size; holes read as zeros). buf_data, buf_ind, buf_ind2.
	sub inode_read(var vol: Volume*, var node: Inode*, var offset: u32, var buffer: u8*, var size: u32) -> i32 {
		var l: Layout* = &vol->layout;
		if (offset >= node->size)
			return 0;
		if (size > node->size - offset)
			size = node->size - offset;
		if (size > 0x7FFFFFFF)
			size = 0x7FFFFFFF;
		var done: u32 = 0;
		while (done < size) {
			var pos: u32 = offset + done;
			var in_block: u32 = pos & l->block_mask;
			var n: u32 = l->block_size - in_block;
			if (n > size - done)
				n = size - done;
			var block: u32 = 0;
			var r: i32 = bmap(vol, node, pos >> l->block_size_log2, false, &block);
			if (r < 0) return r;
			if (block == 0)
				mem_set(buffer + done, 0, n);
			else if (n == l->block_size)
				r = read_block(vol, block, buffer + done);
			else {
				r = read_block(vol, block, vol->buf_data);
				mem_copy(buffer + done, vol->buf_data + in_block, n);
			}
			if (r < 0) return r;
			done += n;
		}
		return cast<i32>(done);
	}

	// Bytes written (fewer when the disk fills up); grows the size and writes the inode.
	// buf_data, buf_ind, buf_ind2, buf_zero, buf_meta, buf_inode.
	sub inode_write(var vol: Volume*, var ino: u32, var node: Inode*, var offset: u32, var buffer: u8*, var size: u32) -> i32 {
		var l: Layout* = &vol->layout;
		if (vol->read_only)
			return ReadOnly;
		if (size > 0x7FFFFFFF)
			return Invalid;
		if (offset + size < offset)
			return TooBig;
		var done: u32 = 0;
		var r: i32 = Ok;
		while (done < size) {
			var pos: u32 = offset + done;
			var in_block: u32 = pos & l->block_mask;
			var n: u32 = l->block_size - in_block;
			if (n > size - done)
				n = size - done;
			var block: u32 = 0;
			r = bmap(vol, node, pos >> l->block_size_log2, true, &block);
			if (r < 0)
				break;
			if (n == l->block_size)
				r = write_block(vol, block, buffer + done);
			else {
				if (r == 1)
					mem_set(vol->buf_data, 0, l->block_size);		// just allocated
				else {
					r = read_block(vol, block, vol->buf_data);
					if (r < 0)
						break;
				}
				mem_copy(vol->buf_data + in_block, buffer + done, n);
				r = write_block(vol, block, vol->buf_data);
			}
			if (r < 0)
				break;
			r = Ok;
			done += n;
			if (pos + n > node->size)
				node->size = pos + n;
		}
		node->mtime = now(vol);
		node->ctime = node->mtime;
		var w: i32 = write_inode(vol, ino, node);
		if (done == 0 and r < 0)
			return r;
		if (w < 0)
			return w;
		return cast<i32>(done);
	}

	// ============================================================================
	// L5: directories (buf_dir, plus what inode_write uses)
	// ============================================================================
	const MatchName: u32 = 0;
	const MatchEmpty: u32 = 1;
	const MatchUsed: u32 = 2;
	const MatchNotDot: u32 = 3;		// used, and not . or ..

	// The one loop over a directory's entries: finds the first entry at or after *index that
	// matches. On success buf_dir holds its block, *index is the entry's index, and out_block /
	// out_offset say where it is.
	sub dir_find(var vol: Volume*, var dir: Inode*, var index: u32*, var match: u32, var name: u8*, var name_len: u32, var out_block: u32*, var out_offset: u32*) -> i32 {
		var l: Layout* = &vol->layout;
		if ((dir->size & l->block_mask) != 0)
			return Corrupt;
		var count: u32 = dir->size / l->dirent_size;
		var loaded: u32 = 0xFFFFFFFF;
		var block: u32 = 0;
		for (var i: u32 = *index; i < count; i++) {
			var file_block: u32 = i / l->dirents_per_block;
			if (file_block != loaded) {
				var r: i32 = bmap(vol, dir, file_block, false, &block);
				if (r < 0) return r;
				if (block == 0)
					return Corrupt;		// directories have no holes
				r = read_block(vol, block, vol->buf_dir);
				if (r < 0) return r;
				loaded = file_block;
			}
			var offset: u32 = (i % l->dirents_per_block) * l->dirent_size;
			var entry: u8* = vol->buf_dir + offset;
			var ino: u32 = get32(entry + DirEntInode);
			var len: u32 = entry[DirEntNameLen];
			var hit: bool = false;
			if (match == MatchEmpty)
				hit = (ino == 0);
			else if (ino == 0)
				hit = false;
			else if (match == MatchUsed)
				hit = true;
			else if (match == MatchNotDot)
				hit = not is_dot_name(entry + DirEntName, len);
			else
				hit = (len == name_len and mem_equal(entry + DirEntName, name, len));
			if (hit) {
				*index = i;
				*out_block = block;
				*out_offset = offset;
				return Ok;
			}
		}
		*index = count;
		return NotFound;
	}

	sub touch_dir(var vol: Volume*, var dir_ino: u32, var dir: Inode*) -> i32 {
		dir->mtime = now(vol);
		dir->ctime = dir->mtime;
		return write_inode(vol, dir_ino, dir);
	}

	sub dir_lookup(var vol: Volume*, var dir: Inode*, var name: u8*, var name_len: u32, var out_ino: u32*) -> i32 {
		var index: u32 = 0;
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = dir_find(vol, dir, &index, MatchName, name, name_len, &block, &offset);
		if (r < 0) return r;
		*out_ino = get32(vol->buf_dir + offset + DirEntInode);
		return Ok;
	}

	sub dir_add(var vol: Volume*, var dir_ino: u32, var dir: Inode*, var name: u8*, var name_len: u32, var ino: u32, var mode: u16) -> i32 {
		var l: Layout* = &vol->layout;
		if (name_len == 0)
			return Invalid;
		if (name_len > MaxNameLength)
			return NameTooLong;
		for (var i: u32 = 0; i < name_len; i++) {
			if (name[i] == '/' or name[i] == 0)
				return Invalid;
		}
		var index: u32 = 0;
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = dir_find(vol, dir, &index, MatchName, name, name_len, &block, &offset);
		if (r == Ok)
			return Exists;
		if (r != NotFound)
			return r;
		index = 0;
		r = dir_find(vol, dir, &index, MatchEmpty, name, name_len, &block, &offset);
		if (r == Ok) {
			fill_dir_entry(vol->buf_dir + offset, l->dirent_size, ino, name, name_len, mode);
			r = write_block(vol, block, vol->buf_dir);
			if (r < 0) return r;
			return touch_dir(vol, dir_ino, dir);
		}
		if (r != NotFound)
			return r;
		// Full: append a block (inode_write writes the inode).
		mem_set(vol->buf_dir, 0, l->block_size);
		fill_dir_entry(vol->buf_dir, l->dirent_size, ino, name, name_len, mode);
		r = inode_write(vol, dir_ino, dir, dir->size, vol->buf_dir, l->block_size);
		if (r < 0) return r;
		if (cast<u32>(r) != l->block_size)
			return NoSpace;
		return Ok;
	}

	sub dir_remove(var vol: Volume*, var dir_ino: u32, var dir: Inode*, var name: u8*, var name_len: u32, var out_ino: u32*) -> i32 {
		var index: u32 = 0;
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = dir_find(vol, dir, &index, MatchName, name, name_len, &block, &offset);
		if (r < 0) return r;
		*out_ino = get32(vol->buf_dir + offset + DirEntInode);
		mem_set(vol->buf_dir + offset, 0, vol->layout.dirent_size);
		r = write_block(vol, block, vol->buf_dir);
		if (r < 0) return r;
		return touch_dir(vol, dir_ino, dir);
	}

	// Points the entry to another inode (a moved directory's ..).
	sub dir_set(var vol: Volume*, var dir: Inode*, var name: u8*, var name_len: u32, var ino: u32) -> i32 {
		var index: u32 = 0;
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = dir_find(vol, dir, &index, MatchName, name, name_len, &block, &offset);
		if (r < 0) return r;
		put32(vol->buf_dir + offset + DirEntInode, ino);
		return write_block(vol, block, vol->buf_dir);
	}

	// Fills out with the entry at or after *cursor (start at 0) and moves the cursor past it.
	// NotFound at the end.
	sub dir_next(var vol: Volume*, var dir: Inode*, var cursor: u32*, var out: DirEntry*) -> i32 {
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = dir_find(vol, dir, cursor, MatchUsed, null, 0, &block, &offset);
		if (r < 0) return r;
		var entry: u8* = vol->buf_dir + offset;
		out->inode = get32(entry + DirEntInode);
		out->type = entry[DirEntType];
		out->name_len = entry[DirEntNameLen];
		if (out->name_len > MaxNameLength)
			return Corrupt;
		mem_copy(out->name, entry + DirEntName, out->name_len);
		out->name[out->name_len] = 0;
		*cursor = *cursor + 1;
		return Ok;
	}

	// 1 when only . and .. are left, 0 if not.
	sub dir_is_empty(var vol: Volume*, var dir: Inode*) -> i32 {
		var index: u32 = 0;
		var block: u32 = 0;
		var offset: u32 = 0;
		var r: i32 = dir_find(vol, dir, &index, MatchNotDot, null, 0, &block, &offset);
		if (r == Ok)
			return 0;
		if (r == NotFound)
			return 1;
		return r;
	}

	// ============================================================================
	// L6: paths (absolute only; repeated '/' are collapsed)
	// ============================================================================
	sub walk(var vol: Volume*, var path: u8*, var parent: bool, var out_ino: u32*, var out_name: u8**, var out_name_len: u32*) -> i32 {
		if (path == null or path[0] != '/')
			return Invalid;
		var ino: u32 = RootInode;
		var node: Inode;
		var p: u8* = path;
		while (true) {
			while (*p == '/')
				p++;
			if (*p == 0) {
				if (parent)
					return Invalid;		// "/" has no parent
				*out_ino = ino;
				return Ok;
			}
			var name: u8* = p;
			var len: u32 = 0;
			while (p[len] != 0 and p[len] != '/')
				len++;
			if (len > MaxNameLength)
				return NameTooLong;
			var next: u8* = p + len;
			while (*next == '/')
				next++;
			var r: i32 = read_inode(vol, ino, &node);
			if (r < 0) return r;
			if (not is_dir(&node))
				return NotDir;
			if (parent and *next == 0) {
				*out_ino = ino;
				*out_name = name;
				*out_name_len = len;
				return Ok;
			}
			r = dir_lookup(vol, &node, name, len, &ino);
			if (r < 0) return r;
			p = next;
		}
		return Invalid;
	}

	sub resolve(var vol: Volume*, var path: u8*, var out_ino: u32*) -> i32 {
		return walk(vol, path, false, out_ino, null, null);
	}

	// The parent directory of the path's last component, which is returned in out_name /
	// out_name_len (pointing into path).
	sub resolve_parent(var vol: Volume*, var path: u8*, var out_parent: u32*, var out_name: u8**, var out_name_len: u32*) -> i32 {
		return walk(vol, path, true, out_parent, out_name, out_name_len);
	}

	// ============================================================================
	// L7: file system operations
	// ============================================================================
	// Frees an inode that nothing points to anymore: its blocks, its record, its bit.
	sub release_inode(var vol: Volume*, var ino: u32, var node: Inode*) -> i32 {
		var r: i32 = truncate(vol, ino, node, 0);
		if (r < 0) return r;
		mem_set(node, 0, sizeof(Inode));
		r = write_inode(vol, ino, node);
		if (r < 0) return r;
		return free_inode(vol, ino);
	}

	sub make_node(var vol: Volume*, var path: u8*, var mode: u16, var out_ino: u32*) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var parent: u32 = 0;
		var ino: u32 = 0;
		var name: u8* = null;
		var name_len: u32 = 0;
		var r: i32 = resolve_parent(vol, path, &parent, &name, &name_len);
		if (r < 0) return r;
		var parent_node: Inode;
		var node: Inode;
		r = read_inode(vol, parent, &parent_node);
		if (r < 0) return r;
		r = dir_lookup(vol, &parent_node, name, name_len, &ino);
		if (r == Ok)
			return Exists;
		if (r != NotFound)
			return r;
		var dir: bool = ((mode & ModeTypeMask) == ModeDir);
		if (dir and parent_node.links == 0xFFFF)
			return TooManyLinks;

		r = alloc_inode(vol, &ino);
		if (r < 0) return r;
		init_inode(vol, &node, mode, cast<u16>(dir ? 2 : 1));
		if (dir) {
			make_dir_block(vol, ino, parent);
			r = inode_write(vol, ino, &node, 0, vol->buf_dir, vol->layout.block_size);
			if (r >= 0 and cast<u32>(r) != vol->layout.block_size)
				r = NoSpace;
		}
		else
			r = write_inode(vol, ino, &node);
		if (r >= 0)
			r = dir_add(vol, parent, &parent_node, name, name_len, ino, mode);
		if (r < 0) {
			release_inode(vol, ino, &node);
			return r;
		}
		if (dir) {
			parent_node.links++;
			r = write_inode(vol, parent, &parent_node);
			if (r < 0) return r;
		}
		if (out_ino != null)
			*out_ino = ino;
		return Ok;
	}

	sub create(var vol: Volume*, var path: u8*, var perm: u16, var out_ino: u32* = null) -> i32 {
		return make_node(vol, path, cast<u16>(ModeFile | (perm & ModePermMask)), out_ino);
	}

	sub mkdir(var vol: Volume*, var path: u8*, var perm: u16, var out_ino: u32* = null) -> i32 {
		return make_node(vol, path, cast<u16>(ModeDir | (perm & ModePermMask)), out_ino);
	}

	// The parent directory and the inode of the path's last component.
	sub lookup_entry(var vol: Volume*, var path: u8*, var out_parent: u32*, var out_parent_node: Inode*, var out_name: u8**, var out_name_len: u32*, var out_ino: u32*, var out_node: Inode*) -> i32 {
		var r: i32 = resolve_parent(vol, path, out_parent, out_name, out_name_len);
		if (r < 0) return r;
		r = read_inode(vol, *out_parent, out_parent_node);
		if (r < 0) return r;
		r = dir_lookup(vol, out_parent_node, *out_name, *out_name_len, out_ino);
		if (r < 0) return r;
		return read_inode(vol, *out_ino, out_node);
	}

	sub unlink(var vol: Volume*, var path: u8*) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var parent: u32 = 0;
		var ino: u32 = 0;
		var name_len: u32 = 0;
		var name: u8* = null;
		var parent_node: Inode;
		var node: Inode;
		var r: i32 = lookup_entry(vol, path, &parent, &parent_node, &name, &name_len, &ino, &node);
		if (r < 0) return r;
		if (is_dir(&node))
			return IsDir;
		r = dir_remove(vol, parent, &parent_node, name, name_len, &ino);
		if (r < 0) return r;
		if (node.links > 0)
			node.links--;
		if (node.links == 0)
			return release_inode(vol, ino, &node);
		node.ctime = now(vol);
		return write_inode(vol, ino, &node);
	}

	sub rmdir(var vol: Volume*, var path: u8*) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var parent: u32 = 0;
		var ino: u32 = 0;
		var name_len: u32 = 0;
		var name: u8* = null;
		var parent_node: Inode;
		var node: Inode;
		var r: i32 = lookup_entry(vol, path, &parent, &parent_node, &name, &name_len, &ino, &node);
		if (r < 0) return r;
		if (is_dot_name(name, name_len))
			return Invalid;
		if (not is_dir(&node))
			return NotDir;
		r = dir_is_empty(vol, &node);
		if (r < 0) return r;
		if (r == 0)
			return NotEmpty;
		r = dir_remove(vol, parent, &parent_node, name, name_len, &ino);
		if (r < 0) return r;
		if (parent_node.links > 0)
			parent_node.links--;
		r = write_inode(vol, parent, &parent_node);
		if (r < 0) return r;
		return release_inode(vol, ino, &node);
	}

	// The destination must not exist; a directory can't move into itself.
	sub rename(var vol: Volume*, var from: u8*, var to: u8*) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var src_parent: u32 = 0;
		var ino: u32 = 0;
		var src_len: u32 = 0;
		var dst_parent: u32 = 0;
		var dst_len: u32 = 0;
		var other: u32 = 0;
		var src_name: u8* = null;
		var dst_name: u8* = null;
		var src_node: Inode;
		var dst_node: Inode;
		var node: Inode;
		var r: i32 = lookup_entry(vol, from, &src_parent, &src_node, &src_name, &src_len, &ino, &node);
		if (r < 0) return r;
		r = resolve_parent(vol, to, &dst_parent, &dst_name, &dst_len);
		if (r < 0) return r;
		if (is_dot_name(src_name, src_len) or is_dot_name(dst_name, dst_len))
			return Invalid;
		var dst: Inode* = &src_node;		// the same directory: one copy of its inode
		if (dst_parent != src_parent) {
			r = read_inode(vol, dst_parent, &dst_node);
			if (r < 0) return r;
			dst = &dst_node;
		}
		r = dir_lookup(vol, dst, dst_name, dst_len, &other);
		if (r == Ok)
			return Exists;
		if (r != NotFound)
			return r;
		var moving_dir: bool = (is_dir(&node) and dst_parent != src_parent);
		if (moving_dir) {
			// Not into itself: walk up from the destination to the root.
			var current: u32 = dst_parent;
			var walk_node: Inode;
			for (var steps: u32 = 0; current != RootInode; steps++) {
				if (current == ino)
					return Invalid;
				if (steps >= vol->layout.inode_count)
					return Corrupt;
				r = read_inode(vol, current, &walk_node);
				if (r < 0) return r;
				r = dir_lookup(vol, &walk_node, "..", 2, &current);
				if (r < 0) return r;
			}
			if (dst->links == 0xFFFF)
				return TooManyLinks;
		}
		if (node.links == 0xFFFF)
			return TooManyLinks;

		// One more link while both entries exist (a crash can only leak it).
		node.links++;
		r = write_inode(vol, ino, &node);
		if (r < 0) return r;
		r = dir_add(vol, dst_parent, dst, dst_name, dst_len, ino, node.mode);
		if (r < 0) {
			node.links--;
			write_inode(vol, ino, &node);
			return r;
		}
		r = dir_remove(vol, src_parent, &src_node, src_name, src_len, &other);
		if (r < 0) return r;
		if (moving_dir) {
			r = dir_set(vol, &node, "..", 2, dst_parent);
			if (r < 0) return r;
			dst->links++;
			r = write_inode(vol, dst_parent, dst);
			if (r < 0) return r;
			src_node.links--;
			r = write_inode(vol, src_parent, &src_node);
			if (r < 0) return r;
		}
		node.links--;
		node.ctime = now(vol);
		return write_inode(vol, ino, &node);
	}

	sub link(var vol: Volume*, var existing: u8*, var new_path: u8*) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var ino: u32 = 0;
		var parent: u32 = 0;
		var name_len: u32 = 0;
		var name: u8* = null;
		var node: Inode;
		var parent_node: Inode;
		var r: i32 = resolve(vol, existing, &ino);
		if (r < 0) return r;
		r = read_inode(vol, ino, &node);
		if (r < 0) return r;
		if (is_dir(&node))
			return IsDir;
		if (node.links == 0xFFFF)
			return TooManyLinks;
		r = resolve_parent(vol, new_path, &parent, &name, &name_len);
		if (r < 0) return r;
		r = read_inode(vol, parent, &parent_node);
		if (r < 0) return r;
		// The link count first (a crash can only leak it).
		node.links++;
		node.ctime = now(vol);
		r = write_inode(vol, ino, &node);
		if (r < 0) return r;
		r = dir_add(vol, parent, &parent_node, name, name_len, ino, node.mode);
		if (r < 0) {
			node.links--;
			write_inode(vol, ino, &node);
		}
		return r;
	}

	sub stat(var vol: Volume*, var path: u8*, var out: Inode*, var out_ino: u32* = null) -> i32 {
		var ino: u32 = 0;
		var r: i32 = resolve(vol, path, &ino);
		if (r < 0) return r;
		if (out_ino != null)
			*out_ino = ino;
		return read_inode(vol, ino, out);
	}

	sub chmod(var vol: Volume*, var path: u8*, var perm: u16) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var ino: u32 = 0;
		var node: Inode;
		var r: i32 = stat(vol, path, &node, &ino);
		if (r < 0) return r;
		node.mode = cast<u16>((node.mode & ModeTypeMask) | (perm & ModePermMask));
		node.ctime = now(vol);
		return write_inode(vol, ino, &node);
	}

	sub chown(var vol: Volume*, var path: u8*, var uid: u16, var gid: u16) -> i32 {
		if (vol->read_only)
			return ReadOnly;
		var ino: u32 = 0;
		var node: Inode;
		var r: i32 = stat(vol, path, &node, &ino);
		if (r < 0) return r;
		node.uid = uid;
		node.gid = gid;
		node.ctime = now(vol);
		return write_inode(vol, ino, &node);
	}

	// ============================================================================
	// Convenience: whole files by path
	// ============================================================================
	// Reads up to size bytes of the file at path into buffer: the bytes read.
	sub read_file(var vol: Volume*, var path: u8*, var buffer: u8*, var size: u32) -> i32 {
		var node: Inode;
		var r: i32 = stat(vol, path, &node);
		if (r < 0) return r;
		if (is_dir(&node))
			return IsDir;
		return inode_read(vol, &node, 0, buffer, size);
	}

	// Creates (or replaces the content of) the file at path: the bytes written.
	sub write_file(var vol: Volume*, var path: u8*, var buffer: u8*, var size: u32, var perm: u16 = 0x1A4) -> i32 {	// 0644
		var ino: u32 = 0;
		var node: Inode;
		var r: i32 = stat(vol, path, &node, &ino);
		if (r == NotFound) {
			r = create(vol, path, perm, &ino);
			if (r < 0) return r;
			r = read_inode(vol, ino, &node);
		}
		else if (r == Ok and is_dir(&node))
			return IsDir;
		else if (r == Ok)
			r = truncate(vol, ino, &node, 0);
		if (r < 0) return r;
		return inode_write(vol, ino, &node, 0, buffer, size);
	}

	// ============================================================================
	// A device on a partition of a machine disk (through the BIOS: int 0x20)
	// ============================================================================
	struct DiskPartition {
		var disk: u8;					// the machine's disk number
		var start: u32;					// the partition's first byte on the disk
		var size: u32;					// bytes
	};

	sub disk_transfer(var part: DiskPartition*, var mode: u8, var offset: u32, var buffer: u8*, var size: u32) -> i32 {
		if (offset > part->size or size > part->size - offset)
			return IOError;
		var ddd: DiskDriverData;
		ddd.mode = mode;
		ddd.disk = part->disk;
		ddd.address = part->start + offset;
		ddd.dataSize = size;
		ddd.memoryAddress = cast<u32>(buffer);
		raise_interrupt(0x20, INT20_LOAD_FROM_DDD_BLOCKING, cast<u32>(&ddd));
		return Ok;
	}

	sub disk_read(var user: void*, var offset: u32, var buffer: u8*, var size: u32) -> i32 {
		return disk_transfer(cast<DiskPartition*>(user), DiskMode.Read, offset, buffer, size);
	}

	sub disk_write(var user: void*, var offset: u32, var buffer: u8*, var size: u32) -> i32 {
		return disk_transfer(cast<DiskPartition*>(user), DiskMode.Write, offset, buffer, size);
	}

	// Fills out with a device on part (which must live as long as the device is used). There is
	// no real time clock yet: timestamps are 0.
	sub disk_device(var out: Device*, var part: DiskPartition*) {
		out->user = part;
		out->read = disk_read;
		out->write = disk_write;
		out->now = null;
	}

	// The DiskPartition of a DPT entry on the boot disk.
	sub dpt_partition(var out: DiskPartition*, var entry: DPTPartitionBlock*) {
		out->disk = get_boot_disk();
		out->start = entry->startAddress;
		out->size = entry->size;
	}
}
