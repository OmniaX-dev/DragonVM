#include(dragon.ds)

namespace dr {
	struct VGADevice {
		var mode: u8;
		var clearColor: u8;
		var palette: u8;
		var signal: u8;
		var textSingleColorChar: u8;
		var textSingleColorInverted: u8;
	    var __padding0: u8[2];
	    var textSingleColorBufferStringAddr: u32;
	    var __padding1: u8[24];
	    var text16ColorCustomPaletteAddr: u32;
	    var text16ColorConsoleAddr: u32;
	    var text16ColorClearSoftwareBufferAddr: u32;
	    var text16ColorBufferStringAddr: u32;
	    var text16ColorBufferStringCellAddr: u32;
	    var text16ColorFrameAddr: u32;
	    var text16ColorFrameSize: u32;
	    var text16ColorFrameYOffset: u32;
	    var __padding2: u8[56];
	    var flags: u32;
	    var text16MemoryController: struct {
	            var x: u32;
	            var y: u32;
	            var character: u8;
	            var background: u8;
	            var foreground: u8;
	    };
	    var __padding3: u8[117];
	};

	inline sub get_boot_disk() -> u8 {
		return *cast<u8*>(CMOSRegisters.BootDisk);
	}

	sub cpu_halt() {
		low { hlt }
	}

	inline sub vga_get_device() -> VGADevice* {
		return cast<dr::VGADevice*>(dr::MemoryLayout.VGA);
	}

	inline sub vga_is_valid_video_mode(var mode: u8) -> bool {
		if (mode == VGAVideoModes.TextSingleColor) return true;
		if (mode == VGAVideoModes.Text16Color) return true;
		return false;
	}

	inline sub vga_get_video_mode() -> u8 {
		return *cast<u8*>(VGARegisters.VideoMode);
	}

	inline sub vga_set_video_mode(var mode: u8) {
		if (vga_get_video_mode() == mode)
			return;
		if (not vga_is_valid_video_mode(mode))
			return;
		*cast<u8*>(VGARegisters.VideoMode) = mode;
	}

	inline sub vga_is_text16() -> bool {
		return vga_get_video_mode() == VGAVideoModes.Text16Color;
	}

	inline sub vga_is_textSingle() -> bool {
		return vga_get_video_mode() == VGAVideoModes.TextSingleColor;
	}

	inline sub vga_enable_double_buffering(var enable: bool = true) {
		if (not vga_is_text16())
			return;
		var flags: std::BitField32* = cast<std::BitField32*>(VGARegisters.Flags);
		flags->val(VGAFlags.DoubleBufferingEnabled, enable);
	}

	inline sub read_cmos(var addr: u32) -> u32 {
		return *cast<u32*>(addr);
	}

	inline sub write_cmos(var addr: u32, var value: u32) {
		*cast<u32*>(addr) = value;
	}

	// The Timer interrupt (HardwareInterrupts.Timer) every ms milliseconds of the timer's time
	// (0: off), e.g. a kernel's scheduler tick. A tick is skipped while its previous handler is
	// still running. Supervisor mode only.
	inline sub set_interrupt_interval(var ms: u32) {
		*cast<u32*>(TimerRegisters.InterruptInterval) = ms;
	}

	inline sub time_get_millis() -> u32 { return *cast<u32*>(dr::TimerRegisters.Milliseconds); }
	inline sub time_get_cycles() -> u32 { return *cast<u32*>(dr::TimerRegisters.CyclesLow); }
	inline sub time_get_unix() -> u32 { return *cast<u32*>(dr::TimerRegisters.UnixTime); }


	inline sub random_get_next_int() -> i32 { return *cast<i32*>(dr::RandomRegisters.Int); }
	sub random_get_next_float() -> f32 { low { mov RV, [$dr::RandomRegisters.Float] }; }
	inline sub random_set_seed(var seed: u32) { *cast<u32*>(dr::RandomRegisters.Seed) = seed; }
}
