// heap.ds - the SDK's heap: libcore's allocator (std::BasicHeap, see libcore/src/heap.ds), with
// its operations protected from interrupts, and the system heap.
//
//     var heap: dr::Heap* = dr::Heap::create(cast<u8*>(0x01800000), 4 * 1024 * 1024);
//     heap->add_region(cast<u8*>(boot_stack_start), boot_stack_size);	// more memory, anywhere
//     var p: u8* = heap->alloc(100);
//     heap->free(p);
//
// In supervisor mode every operation runs with interrupts disabled (an interrupt handler may use
// the heap the code it interrupted is using), and puts them back as they were; in user mode (where
// the interrupt flag is privileged) nothing changes: a user program has no interrupt handlers of
// its own (it can use std::Heap directly).
#include(cpu.ds)

namespace dr {
	// The guard of a heap interrupt handlers may use (see std::BasicHeap).
	struct InterruptGuard {
		// Supervisor mode: disables interrupts, and says whether they were enabled. User mode: 0.
		static sub enter() -> u32 {
			if (not cpu::is_supervisor())
				return 0;
			var flags: u32 = 0;
			low {
				mov $flags, FL
				zflg $CPUFlags.InterruptsEnabled
			}
			return flags & (1u << CPUFlags.InterruptsEnabled);
		}

		static sub leave(var saved: u32) {
			if (saved != 0) {
				low { sflg $CPUFlags.InterruptsEnabled }
			}
		}
	};

	alias Heap = std::BasicHeap<InterruptGuard>;
	alias HeapRegion = std::HeapRegion;

	// The system heap: the one dr::bios_alloc and dr::bios_free use (through the BIOS's int 0x20), its
	// header's address in the CMOS (HeapStart; HeapEnd: the end of its first region). The BIOS
	// makes one (4 MiB under the stack, at the end of the RAM); a kernel can make its own and
	// make it the system heap: from then on dr::bios_alloc serves the kernel's heap, and
	// programs that use dr::bios_alloc need no changes. null if there is none.
	sub system_heap() -> Heap* {
		var h: Heap* = cast<Heap*>(read_cmos(CMOSRegisters.HeapStart));
		if (not Heap::valid(h))
			return null;
		return h;
	}

	// Supervisor mode only (the CMOS).
	sub set_system_heap(var h: Heap*) {
		write_cmos(CMOSRegisters.HeapStart, cast<u32>(h));
		write_cmos(CMOSRegisters.HeapEnd, h == null ? 0 : h->first_region()->end);
	}

	// libcore's containers on the system heap (a kernel's: after set_system_heap):
	//     var procs: std::BasicVector<Process*, dr::SystemAllocator>;
	//     var name: std::BasicString<dr::SystemAllocator> = "init";
	// (null: no system heap, or no room in it.)
	struct SystemAllocator {
		static sub alloc(var size: u32) -> void* {
			var h: Heap* = system_heap();
			return h != null ? h->alloc(size) : null;
		}
		static sub free(var p: void*) {
			var h: Heap* = system_heap();
			if (h != null)
				h->free(p);
		}
	};
}
