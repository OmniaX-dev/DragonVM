// A failed-assert handler for programs that run without an OS: a BIOS, a boot loader, a kernel.
//
// assert(condition[, message]) calls the global ::__assert_fail when the condition is false. The
// libraries don't define it (neither libcore nor the SDK): each program decides what a failed
// assert does. DragonOS programs get it from the stdlib (#import(<stdlib>)); a program on the SDK
// writes its own, which can be just this:
//
//     sub __assert_fail(var file: string, var line: u32, var condition: string, var message: string) {
//         dr::assert_fail_halt(file, line, condition, message);
//     }
//
// (or a kernel's panic screen). Define NDEBUG (dsc -D NDEBUG) to compile the asserts out.

#include(dragon.ds)

namespace dr {
	// Prints "Assertion failed: <condition> (<file>:<line>): <message>" to the host's terminal
	// (debug_print: it doesn't need the VGA stack) and stops the machine; with dsc -g, ddb stops
	// first at the debug_break.
	sub assert_fail_halt(var file: string, var line: u32, var condition: string, var message: string) {
		var buff: u8[12];
		debug_print("Assertion failed: ");
		debug_print(condition);
		debug_print(" (");
		debug_print(file);
		debug_print(":");
		debug_print(std::utoa(line, buff));
		debug_print(")");
		if (message[0] != 0) {
			debug_print(": ");
			debug_print(message);
		}
		debug_print("\n");
		low {
			debug_break
			hlt
		}
	}
}
