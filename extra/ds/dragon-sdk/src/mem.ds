// DScript SDK: memory and string helpers.
#include(int.ds)

namespace dr {
	// Copies size bytes from src to dst, forward (as a byte loop would: dst may overlap src at or
	// below it, and dst 1 - 3 bytes above src repeats the first bytes, as before). A word at a time
	// (a dasm loop, ~7 instructions per 4 bytes; the machine takes unaligned words), the last 0 - 3
	// bytes one by one.
	sub memcpy(var dst: void*, var src: void*, var size: u32) -> void* {
		var d: u8* = cast<u8*>(dst);
		var s: u8* = cast<u8*>(src);
		var gap: u32 = cast<u32>(d) - cast<u32>(s);
		var words: u32 = size / 4;
		if (gap >= 1 and gap <= 3)
			words = 0;		// a word would read bytes this copy has to write first
		if (words > 0) {
			low {
				mov R1, $s
				mov R2, $d
				mov R3, $words
			__mem_memcpy_loop:
				mov R4, *R1
				mov *R2, R4
				addip R1, 0x00000004
				addip R2, 0x00000004
				dec R3
				mov ACC, R3
				jne $__mem_memcpy_loop, 0x00000000
			}
			d = d + words * 4;
			s = s + words * 4;
			size = size - words * 4;
		}
		while (size > 0) {
			*d = *s;
			d++;
			s++;
			size--;
		}
		return dst;
	}

	// Sets size bytes at dst to value: a word at a time (a dasm loop), the last 0 - 3 bytes one by one.
	sub memset(var dst: void*, var value: u8, var size: u32) -> void* {
		var d: u8* = cast<u8*>(dst);
		var words: u32 = size / 4;
		if (words > 0) {
			var fill: u32 = cast<u32>(value) * 0x01010101;
			low {
				mov R1, $d
				mov R2, $fill
				mov R3, $words
			__mem_memset_loop:
				mov *R1, R2
				addip R1, 0x00000004
				dec R3
				mov ACC, R3
				jne $__mem_memset_loop, 0x00000000
			}
			d = d + words * 4;
			size = size - words * 4;
		}
		while (size > 0) {
			*d = value;
			d++;
			size--;
		}
		return dst;
	}

	sub memcmp(var a: void*, var b: void*, var size: u32) -> i32 {
	    var x: u8* = cast<u8*>(a);
	    var y: u8* = cast<u8*>(b);
	    for (var i: u32 = 0; i < size; i++) {
	        if (x[i] != y[i])
	            return cast<i32>(x[i]) - cast<i32>(y[i]);
	    }
	    return 0;
	}

	sub strlen(var s: string) -> u32 {
	    var n: u32 = 0;
	    while (s[n] != 0)
	        n++;
	    return n;
	}

	sub strcmp(var a: string, var b: string) -> i32 {
	    while (*a != 0 and *a == *b) {
	        a++;
	        b++;
	    }
	    return cast<i32>(*a) - cast<i32>(*b);
	}

	sub strcpy(var dst: string, var src: string) -> string {
	    var d: string = dst;
	    while (*src != 0) {
	        *d = *src;
	        d++;
	        src++;
	    }
	    *d = 0;
	    return dst;
	}

	inline sub malloc(var size: u32) -> void* {
		var ptr: void* = null;
		raise_interrupt(0x20, INT20_ALLOC_HEAP, size, cast<u32>(&ptr));
		return ptr;
	}

	sub free(var ptr: void*) -> bool {
		raise_interrupt(0x20, INT20_FREE_HEAP, cast<u32>(ptr));
		var rv: u32 = 0;
		low { mov $rv, RV };
		return rv != 0;
	}
}
