#once

#include(dragon.ds)
#include(int.ds)
#include(mem.ds)

namespace dr {
	struct TextSingle {
		// Prints a null-terminated string.
		static sub print(var text: string) -> void {
			if (!vga_is_textSingle())
				return;
			raise_interrupt(0x30, INT30_PRINT_STRING_BUFFERED, cast<u32>(text));
		}

		// Prints one character.
		static sub print(var c: u8) -> void {
			if (!vga_is_textSingle())
				return;
			raise_interrupt(0x30, INT30_DIRECT_PRINT_CHAR_TEXT_SINGLE, cast<u32>(c));
		}

		// Prints an unsigned integer (decimal).
		static sub print(var n: u32) -> void {
			if (!vga_is_textSingle())
				return;
			raise_interrupt(0x30, INT30_DIRECT_PRINT_INTEGER_TEXT_SINGLE, n);
		}

		// Prints a signed integer (decimal).
		static sub print(var n: i32) -> void {
			if (!vga_is_textSingle())
				return;
			if (n < 0) {
				TextSingle::print('-');
				TextSingle::print(cast<u32>(-n));
				return;
			}
			TextSingle::print(cast<u32>(n));
		}

		static sub new_line() -> void {
			if (!vga_is_textSingle())
				return;
			raise_interrupt(0x30, INT30_DIRECT_NEW_LINE_TEXT_SINGLE);
		}

		static sub clear_screen() -> void {
			if (!vga_is_textSingle())
				return;
			raise_interrupt(0x30, INT30_CLEAR_SCREEN);
		}

		static sub println(var text: string) -> void {
			TextSingle::print(text);
			TextSingle::new_line();
		}
	};

	const DefaultPaletteText16: struct {
		var Black: u8					= 0x00;
		var Gray: u8					= 0x01;
		var White: u8					= 0x02;
		var Red: u8						= 0x03;
		var Pink: u8					= 0x04;
		var Brown: u8					= 0x05;
		var DarkOrange: u8				= 0x06;
		var Orange: u8					= 0x07;
		var Yellow: u8					= 0x08;
		var DarkGreen: u8				= 0x09;
		var Green: u8					= 0x0A;
		var Lime: u8					= 0x0B;
		var DarkBlue: u8				= 0x0C;
		var Blue: u8					= 0x0D;
		var LightBlue: u8				= 0x0E;
		var Sky: u8						= 0x0F;
	};

	const Text16Flags: struct {
		var AllowXWrap: u32 			= 0b00000000_00000000_00000000_00000001;
		var AllowScroll: u32 			= 0b00000000_00000000_00000000_00000010;
	};

	struct Text16 {
		// Prints a null-terminated string.
		static sub print(var text: string, var x: u8, var y: u8, var fg: u8, var bg: u8) -> void {
			if (!vga_is_text16())
				return;
			var cell: VGAText16Cell;
			cell.foreground = fg;
			cell.background = bg;
			cell.x = x;
			cell.y = y;
			var flags: BitField32;
			flags.set(Text16Flags.AllowXWrap | Text16Flags.AllowScroll);
			raise_interrupt(0x30, INT30_PRINT_STRING_TEXT16, cast<u32>(&cell), cast<u32>(text), *cast<u32*>(&flags));
		}

		// Prints one character.
		static sub print(var c: u8, var x: u8, var y: u8, var fg: u8, var bg: u8) -> void {
			if (!vga_is_text16())
				return;
			var buff: u8[2] = " \0";
			buff[0] = c;
			Text16::print(buff, x, y, fg, bg);
		}

		// Prints an unsigned integer (decimal).
		static sub print(var n: u32, var x: u8, var y: u8, var fg: u8, var bg: u8) -> void {
			if (!vga_is_text16())
				return;
			var buff: u8[12];
			dr::utoa(n, buff);
			Text16::print(buff, x, y, fg, bg);
		}

		// Prints a signed integer (decimal).
		static sub print(var n: i32, var x: u8, var y: u8, var fg: u8, var bg: u8) -> void {
			if (!vga_is_text16())
				return;
			var buff: u8[12];
			dr::itoa(n, buff);
			Text16::print(buff, x, y, fg, bg);
		}

		static sub clear_screen(var color: u8) -> void {
			if (!vga_is_text16())
				return;
			var cell: VGAText16Cell;
			cell.character = ' ';
			cell.foreground = color;
			cell.background = color;
			raise_interrupt(0x30, INT30_CLEAR_SCREEN_TEXT16, cast<u32>(&cell), 0);	// (0: no frame buffer of the program's)
		}
	};

	struct Text16Console {
		enum Errors: u8 {
			NoError						= 0x00,
			ScreenBufferAllocFail		= 0x01,
			Uninitialized				= 0x02,
			WrongVideoMode				= 0x03,
			VerticalOverflow			= 0x04,
			HorizontalOverflow			= 0x05,
			InvalidOverflowPolicy		= 0x06,
			InvalidState				= 0x07
		};
		enum VOverflowPolicy: u8 {
			Ignore						= 0x00,
			Scroll						= 0x01,
			Error						= 0x02
		};
		enum HOverflowPolicy: u8 {
			Ignore						= 0x00,
			Wrap						= 0x01,
			Error						= 0x02
		};

		priv var m_cursor_x: u16 = 0;
		priv var m_cursor_y: u16 = 0;
		priv var m_stored_cursor_x: u16 = 0;
		priv var m_stored_cursor_y: u16 = 0;
		priv var m_bg_col: u8 = DefaultPaletteText16.Black;
		priv var m_fg_col: u8 = DefaultPaletteText16.Green;
		priv var m_stored_bg_col: u8 = DefaultPaletteText16.Black;
		priv var m_stored_fg_col: u8 = DefaultPaletteText16.Green;
		priv var m_screen_x: u32 = 0;
		priv var m_screen_y: u32 = 0;
		priv var m_screenBufferSize: u32 = 0;
		priv var m_screenBuffer: u8* = null;
		priv var m_yOffset: u32 = 0;
		priv var m_scrollOffset: u32 = 0;
		priv var m_initialized: bool = false;
		priv var m_error: u8 = 0;
		priv var m_overflowPolicyH: u8 = 0;
		priv var m_overflowPolicyV: u8 = 0;

		sub new() {
			this->m_initialized = false;
			this->m_screen_x = *cast<u32*>(CMOSRegisters.ScreenColumns);
			this->m_screen_y = *cast<u32*>(CMOSRegisters.ScreenRows);
			this->m_screenBufferSize = this->m_screen_x * this->m_screen_y * 4;
			if (this->m_screenBuffer)
				free(this->m_screenBuffer);
			this->m_screenBuffer = malloc(this->m_screenBufferSize);
			if (not this->m_screenBuffer)
			{
				this->set_error(Errors.ScreenBufferAllocFail);
				return;
			}
			this->m_overflowPolicyV = VOverflowPolicy.Ignore;
			this->m_overflowPolicyH = HOverflowPolicy.Ignore;
			dr::vga_enable_double_buffering();
			this->m_initialized = true;
			this->set_error(Errors.NoError);
		}
		sub destroy() {
			if (this->m_screenBuffer)
				dr::free(this->m_screenBuffer);
			this->m_screenBuffer = null;
			this->set_error(Errors.NoError);
			this->m_initialized = false;
		}
		sub is_valid() -> bool {
			if (not this->m_initialized)
				return this->set_error(Errors.Uninitialized, false);
			if (not vga_is_text16())
				return this->set_error(Errors.WrongVideoMode, false);
			return true;
		}
		sub present() {
			dr::raise_interrupt(0x30, INT30_COPY_FRAME_TEXT16, cast<u32>(this->m_screenBuffer), this->m_screenBufferSize, this->m_yOffset);
			dr::raise_interrupt(0x30, INT30_SWAP_BUFFERS_TEXT16);
		}

		sub print(var text: string) -> Text16Console* {
			if (not this->is_valid() or this->has_error())
				return this;
			var cols: u32 = this->m_screen_x;
			var x: u32 = this->m_cursor_x;
			var attr: u32 = (cast<u32>(this->m_fg_col) << 16) | (cast<u32>(this->m_bg_col) << 8);
			var row: u32* = cast<u32*>(this->m_screenBuffer) + ((this->m_cursor_y + this->m_yOffset) % this->m_screen_y) * cols;
			var skip: bool = false;         // Ignore policy: past the right edge until '\n'
			var i: u32 = 0;
			var c: u8 = text[0];
			while (c != 0) {
				if (c == '\n' or (x >= cols and not skip)) {
					if (c != '\n' and this->m_overflowPolicyH != HOverflowPolicy.Wrap) {
						if (this->m_overflowPolicyH == HOverflowPolicy.Error) {
							this->set_error(Errors.HorizontalOverflow);
							break;
						}
						skip = true;                    // Ignore
					}
					else
					{
						this->m_cursor_x = cast<u16>(x);
						var y0: u16 = this->m_cursor_y;
						var s0: u32 = this->m_scrollOffset;
						this->nl();                             // rare: the full logic (policy, scroll(false))
						// An error, or no new line (vertical Ignore on the last row): the rest is dropped.
						if (this->has_error() or (this->m_cursor_y == y0 and this->m_scrollOffset == s0))
							break;
						x = 0;
						skip = false;
						row = cast<u32*>(this->m_screenBuffer) + ((this->m_cursor_y + this->m_yOffset) % this->m_screen_y) * cols;
						if (c == '\n') { c = text[++i]; continue; }
					}
				}
				if (not skip)
					row[x++] = (cast<u32>(c) << 24) | attr;
				c = text[++i];
			}
			this->m_cursor_x = cast<u16>(x);
			return this;
		}
		sub print(var c: u8) -> Text16Console* {
			if (not this->is_valid() or this->has_error())
				return this;
			var buff: u8[2] = " \0";
			buff[0] = c;
			return this->print(buff);
		}
		sub print(var n: u32) -> Text16Console* {
			if (not this->is_valid() or this->has_error())
				return this;
			var buff: u8[12];
			dr::utoa(n, buff);
			return this->print(buff);
		}
		sub print(var n: i32) -> Text16Console* {
			if (not this->is_valid() or this->has_error())
				return this;
			var buff: u8[12];
			dr::itoa(n, buff);
			return this->print(buff);
		}
		sub nl() -> Text16Console* {
			if (not this->is_valid() or this->has_error())
				return this;
			if (not this->check_new_line())
			{
				if (this->get_vertical_overflow_policy() != VOverflowPolicy.Ignore)
					this->set_error(Errors.VerticalOverflow);
				return this;
			}
			if (this->m_cursor_y < this->m_screen_y - 1)
				this->m_cursor_y++;
			else if (this->m_cursor_y == this->m_screen_y - 1)
				this->scroll(false);
			else
			{
				this->set_error(Errors.InvalidState);
				return this;
			}
			this->m_cursor_x = 0;
			return this;
		}
		sub scroll(var present: bool = true) -> Text16Console* {
			if (not this->is_valid() or this->has_error())
				return this;
			this->m_yOffset = (this->m_yOffset + 1) % this->m_screen_y;
			var start: u32 = ((this->m_yOffset + this->m_screen_y - 1) % this->m_screen_y) * this->m_screen_x * 4;
			for (var i: u32 = start; i < start + this->m_screen_x * 4; i += 4)
			{
				this->m_screenBuffer[i + 0] = ' ';
				this->m_screenBuffer[i + 1] = this->m_fg_col;
				this->m_screenBuffer[i + 2] = this->m_bg_col;
				this->m_screenBuffer[i + 3] = 0;
			}
			if (present)
				this->present();
			this->m_scrollOffset++;
			return this;
		}
		sub clear(var col: u8, var present: bool = true, var clear_buffer: bool = true) -> Text16Console* {
			var cell: VGAText16Cell;
			cell.character = ' ';
			cell.background = col;
			cell.foreground = col;
			raise_interrupt(0x30, INT30_CLEAR_SCREEN_TEXT16, cast<u32>(&cell), (clear_buffer ? cast<u32>(this->m_screenBuffer) : 0));
			if (present)
				this->present();
			return this;
		}
		sub println(var text: string) -> Text16Console* {
			return this->print(text)->nl();
		}
		sub xy(var x: u16, var y: u16) -> Text16Console* {
			return this->x(x)->y(y);
		}
		sub x(var x: u16) -> Text16Console* {
			var stop: bool = false;
			var new_x: u16 = this->check_horizontal_overflow(x, &stop);
			if (not stop and not this->has_error())
				this->m_cursor_x = new_x;
			return this;
		}
		sub y(var y: u16) -> Text16Console* {
			var stop: bool = false;
			var new_y: u16 = this->check_vertical_overflow(y, &stop);
			if (not stop and not this->has_error())
				this->m_cursor_y = new_y;
			return this;
		}
		sub fg(var col: u8) -> Text16Console* {
			if (this->check_color(col))
				this->m_fg_col = col;
			return this;
		}
		sub bg(var col: u8) -> Text16Console* {
			if (this->check_color(col))
				this->m_bg_col = col;
			return this;
		}
		sub store_fg() -> Text16Console* {
			this->m_stored_fg_col = this->m_fg_col;
			return this;
		}
		sub store_bg() -> Text16Console* {
			this->m_stored_bg_col = this->m_bg_col;
			return this;
		}
		sub store_colors() -> Text16Console* {
			this->store_fg();
			this->store_bg();
			return this;
		}
		sub store_x() -> Text16Console* {
			this->m_stored_cursor_x = this->m_cursor_x;
			return this;
		}
		sub store_y() -> Text16Console* {
			this->m_stored_cursor_y = this->m_cursor_y;
			return this;
		}
		sub store_xy() -> Text16Console* {
			this->store_x();
			this->store_y();
			return this;
		}
		sub restore_bg() -> Text16Console* {
			this->m_bg_col = this->m_stored_bg_col;
			return this;
		}
		sub restore_fg() -> Text16Console* {
			this->m_fg_col = this->m_stored_fg_col;
			return this;
		}
		sub restore_colors() -> Text16Console* {
			this->restore_fg();
			this->restore_bg();
			return this;
		}
		sub restore_x() -> Text16Console* {
			this->m_cursor_x = this->m_stored_cursor_x;
			return this;
		}
		sub restore_y() -> Text16Console* {
			this->m_cursor_y = this->m_stored_cursor_y;
			return this;
		}
		sub restore_xy() -> Text16Console* {
			this->restore_x();
			this->restore_y();
			return this;
		}

		inline sub set_vertical_overflow_policy(var policy: u8) -> Text16Console* {
			this->m_overflowPolicyV = policy;
			return this;
		}
		inline sub set_horizontal_overflow_policy(var policy: u8) -> Text16Console* {
			this->m_overflowPolicyH = policy;
			return this;
		}

		inline sub get_console_width() -> u16 {
			return this->m_screen_x;
		}
		inline sub get_console_height() -> u16 {
			return this->m_screen_y;
		}
		inline sub get_scroll_offset() -> u32 {
			return this->m_scrollOffset;
		}
		inline sub get_vertical_overflow_policy() -> u8 {
			return this->m_overflowPolicyV;
		}
		inline sub get_horizontal_overflow_policy() -> u8 {
			return this->m_overflowPolicyH;
		}
		inline sub get_error() -> u8 {
			return this->m_error;
		}
		inline sub has_error() -> bool {
			return this->get_error() != Errors.NoError;
		}
		inline sub clear_error() {
			this->set_error(Errors.NoError);
		}

		priv sub check_horizontal_overflow(var x: u16, var outStop: bool*) -> u16 {
			if (this->get_horizontal_overflow_policy() == HOverflowPolicy.Error)
			{
				if (x >= this->m_screen_x)
					this->set_error(Errors.HorizontalOverflow);
				return x;
			}
			else if (this->get_horizontal_overflow_policy() == HOverflowPolicy.Ignore)
			{
				if (x >= this->m_screen_x)
					*outStop = true;
				return x;
			}
			else if (this->get_horizontal_overflow_policy() == HOverflowPolicy.Wrap)
			{
				if (x >= this->m_screen_x)
				{
					if (this->check_new_line())
					{
						this->nl();
						return 0;
					}
					else
						this->set_error(Errors.VerticalOverflow);
				}
				return x;
			}
			else
			{
				this->set_error(Errors.InvalidOverflowPolicy);
				return x;
			}
		}
		priv sub check_vertical_overflow(var y: u16, var outStop: bool*) -> u16 {
			if (this->get_vertical_overflow_policy() == VOverflowPolicy.Error)
			{
				if (y >= this->m_screen_y)
					this->set_error(Errors.VerticalOverflow);
				return y;
			}
			else if (this->get_vertical_overflow_policy() == VOverflowPolicy.Ignore)
			{
				if (y >= this->m_screen_y)
					*outStop = true;
				return y;
			}
			else if (this->get_vertical_overflow_policy() == VOverflowPolicy.Scroll)
			{
				if (y >= this->m_screen_y)
				{
					if (y - this->m_screen_y > this->m_screen_y)
					{
						this->clear(this->m_bg_col, false);
						y %= this->m_screen_y;
						return y;
					}
					while (y >= this->m_screen_y)
					{
						this->scroll(false);
						y--;
					}
				}
				return y;
			}
			else
			{
				this->set_error(Errors.InvalidOverflowPolicy);
				return y;
			}
		}
		priv sub check_new_line() -> bool {
			if (this->get_vertical_overflow_policy() == VOverflowPolicy.Scroll)
				return true;
			if (this->m_cursor_y < this->m_screen_y - 1)
				return true;
			return false;
		}
		priv inline sub check_color(var col: u8) -> bool {
			return col < 16;
		}
		priv inline sub set_error(var err: u8, var passthrough: bool = true) -> bool {
			this->m_error = err;
			return passthrough;
		}
	};
}
