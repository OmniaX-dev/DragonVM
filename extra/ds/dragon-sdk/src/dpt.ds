#once

#include(dragon.ds)
#include(mem.ds)

namespace dr {
	struct DPTBlock {
		var ID: u16;
		var versionMaj: u8;
		var versionMin: u8;
		var partitionCount: u8;
		var reserved: u8[7];
		var entries: DPTPartitionBlock[5];
	};

	struct DPTPartitionBlock {
		var startAddress: u32;
		var size: u32;
		var flags: u16;
		var reserved: u8[26];
		var label: u8[64];
	};

	const DPTStructure: struct {
		var DiskAddress: u32 					= 0x400000;	// after the 4 MiB boot area
		var EntriesStart: u32			 		= 0x000C;

		var EntryStart: u32  					= 0x0000;
		var EntryPartitionSize: u32 			= 0x0004;
		var EntryFlags: u32						= 0x0008;
		var EntryPartLabel: u32					= 0x0024;

		var ID: u16								= 0xF1CA;
		var EntrySize: u32						= 100;
		var MaxPartitions: u8					= 5;
	};

	const DPTBootPartStructure: struct {
		var IDAddr: u32 						= 0x0000;
		var CodeStart: u32			 			= 0x0020;

		var CodeSize: u32  						= 131072;
		var HeaderSize: u32						= 32;
		var CodeLoadAddr: u32					= 0x01410000;

		var ID: u16								= 0xF1C4;
	};

	const DPTPartFlags: struct {
		var Boot: u16 = 0b00000000_00000001;
	};

	sub dpt_load_block(var outBlock: DPTBlock*) -> bool {
		if (not outBlock) return false;
		var ddd: DiskDriverData;
		ddd.mode = DiskMode.Read;
		ddd.disk = get_boot_disk();
		ddd.address = DPTStructure.DiskAddress;
		ddd.dataSize = sizeof(DPTBlock);
		ddd.memoryAddress = cast<u32>(outBlock);
		raise_interrupt(0x20, INT20_LOAD_FROM_DDD_BLOCKING, cast<u32>(&ddd));
		if (outBlock->ID != DPTStructure.ID)
		{
			memset(outBlock, 0, sizeof(DPTBlock));
			return false;
		}
		return true;
	}

	sub dpt_is_partition_bootable(var part: DPTPartitionBlock*) -> bool {
		if (!part) return false;
		if (!(part->flags & DPTPartFlags.Boot)) return false;
		var header: u8[32];
		var ddd: DiskDriverData;
		ddd.mode = DiskMode.Read;
		ddd.disk = get_boot_disk();
		ddd.address = part->startAddress;
		ddd.dataSize = DPTBootPartStructure.HeaderSize;
		ddd.memoryAddress = cast<u32>(header);
		raise_interrupt(0x20, INT20_LOAD_FROM_DDD_BLOCKING, cast<u32>(&ddd));
		if (*cast<u16*>(header) != DPTBootPartStructure.ID)
			return false;
		return true;
	}
}
