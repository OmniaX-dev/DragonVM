#include(mem.ds)

namespace dr::drx {
	const Magic: u32 = 0x44525831;	// "DRX1"
	const HeaderSize: u32 = 32;

	enum Errors: i32 {
		NoError = 0,
		FileTooSmall = -1,
		InvalidMagic = -2,
		TruncatedFile = -3,
		NullOutputPtr = -4,
		RelocationOutOfRange = -5,
		InvalidAllocation = -6,
		ImageTooBig = -7,			// load: the image doesn't fit in capacity
		Overlap = -8,				// load: the destination overlaps the file
		EntryOutOfRange = -9,		// the entry isn't in the image
	};

	struct Program
	{
		var image: u8* = null;
		var image_size: u32 = 0;
		var entry: u32 = 0;
		var relocations: u32* = null;
		var relocations_count: u32 = 0;
		var id_hi: u32 = 0;			// the build's id (the header's): see notify_loaded
		var id_lo: u32 = 0;
	};

	sub __readU32(var ptr: u8*) -> u32 { return (cast<u32>(ptr[0]) << 24) | (cast<u32>(ptr[1]) << 16) | (cast<u32>(ptr[2]) << 8) | ptr[3]; }
	sub __writeU32(var ptr: u8*, var v: u32) { ptr[0] = cast<u8>(v >> 24); ptr[1] = cast<u8>(v >> 16); ptr[2] = cast<u8>(v >> 8); ptr[3] = cast<u8>(v); }


	// The header's fields, checked against the file: Errors.NoError or an error.
	struct Header
	{
		var header_size: u32 = 0;
		var image_size: u32 = 0;
		var entry: u32 = 0;
		var reloc_count: u32 = 0;
		var reloc_offset: u32 = 0;
		var id_hi: u32 = 0;			// 0x18: the build's id (0: none)
		var id_lo: u32 = 0;
	};

	// For the debugger (source-level debugging): the program built with this id is at base
	// (size bytes); ddb moves its disassembly (dsc --save-disassembly, which has the id) there.
	// load() does it; a loader of its own calls it once the program is in place (relocated). A
	// no-op without a debugger (one instruction).
	sub notify_loaded(var base: u32, var size: u32, var id_hi: u32, var id_lo: u32) {
		var record: u32[4] = { base, size, id_hi, id_lo };
		low {
			mov R1, $record
			debug_drx_load R1
		}
	}

	// For the debugger: the program at base is gone (its memory is used for something else).
	// free_program() does it for read()'s programs; a program loaded with load() is unloaded
	// with this (a new load over it unloads it too).
	sub notify_unloaded(var base: u32) {
		low {
			mov R1, $base
			debug_drx_unload R1
		}
	}

	sub read_header(var file_bytes: u8*, var file_size: u32, var out: Header*) -> i32 {
		if (not file_bytes or not out) return Errors.NullOutputPtr;
		if (file_size < HeaderSize) return Errors.FileTooSmall;
		if (__readU32(file_bytes) != Magic) return Errors.InvalidMagic;
		out->header_size = __readU32(&file_bytes[0x04]);
		out->image_size = __readU32(&file_bytes[0x08]);
		out->entry = __readU32(&file_bytes[0x0C]);
		out->reloc_count = __readU32(&file_bytes[0x10]);
		out->reloc_offset = __readU32(&file_bytes[0x14]);
		out->id_hi = __readU32(&file_bytes[0x18]);
		out->id_lo = __readU32(&file_bytes[0x1C]);
		if (out->header_size < HeaderSize or out->header_size > file_size or out->image_size > file_size - out->header_size)
			return Errors.TruncatedFile;
		if (out->reloc_offset > file_size or out->reloc_count > (file_size - out->reloc_offset) / 4)
			return Errors.TruncatedFile;
		if (out->reloc_count > 0 and out->image_size < 4)
			return Errors.RelocationOutOfRange;
		if (out->entry >= out->image_size)
			return Errors.EntryOutOfRange;
		return Errors.NoError;
	}

	// Copies the program out of the file (image and relocations in new memory: release them with
	// free_program, also after an error).
	sub read(var file_bytes: u8*, var file_size: u32, var outProgram: Program*) -> i32 {
		if (not outProgram) return Errors.NullOutputPtr;
		var empty: Program;
		*outProgram = empty;
		var h: Header;
		var r: i32 = read_header(file_bytes, file_size, &h);
		if (r != Errors.NoError) return r;
		outProgram->image = malloc(h.image_size == 0 ? 1 : h.image_size);
		if (not outProgram->image)
			return Errors.InvalidAllocation;
		memcpy(outProgram->image, &file_bytes[h.header_size], h.image_size);
		outProgram->image_size = h.image_size;
		outProgram->entry = h.entry;
		outProgram->id_hi = h.id_hi;
		outProgram->id_lo = h.id_lo;
		if (h.reloc_count == 0)
			return Errors.NoError;
		outProgram->relocations = malloc(h.reloc_count * 4);
		if (not outProgram->relocations)
			return Errors.InvalidAllocation;
		for (var i: u32 = 0; i < h.reloc_count; i++)
		{
			var offset: u32 = __readU32(&file_bytes[h.reloc_offset + i * 4]);
			if (offset > h.image_size - 4)
				return Errors.RelocationOutOfRange;
			outProgram->relocations[i] = offset;
			outProgram->relocations_count++;
		}
		return Errors.NoError;
	}

	// Releases what read() allocated (the Program is empty afterwards).
	sub free_program(var prog: Program*) {
		if (not prog) return;
		if (prog->image) {
			notify_unloaded(cast<u32>(prog->image));
			free(prog->image);
		}
		if (prog->relocations) free(prog->relocations);
		var empty: Program;
		*prog = empty;
	}

	// This right now is destructive unlike the C++ version, to avoid copying the program. Relocated
	// to where its image is (base == prog->image: run there), the debugger is told (notify_loaded).
	sub relocate(var prog: Program*, var base: u32) {
		for (var i: u32 = 0; i < prog->relocations_count; i++)
		{
			var offset: u32 = prog->relocations[i];
			var addr: u32 = __readU32(&prog->image[offset]);
			__writeU32(&prog->image[offset], addr + base);
		}
		if (base == cast<u32>(prog->image))
			notify_loaded(base, prog->image_size, prog->id_hi, prog->id_lo);
	}

	// Copies words (4 bytes each) from src to dst, forward (dst may overlap src if it is at or
	// below it). A dasm loop: about 7 instructions a word, against ~30 for the DScript loop.
	sub __copy_words(var dst: u8*, var src: u8*, var words: u32) {
		if (words == 0)
			return;
		low {
			mov R1, $src
			mov R2, $dst
			mov R3, $words
		__drx_copy_words_loop:
			mov R4, *R1
			mov *R2, R4
			addip R1, 0x00000004
			addip R2, 0x00000004
			dec R3
			mov ACC, R3
			jne $__drx_copy_words_loop, 0x00000000
		}
	}

	// Every offset in the table is at most last (unsigned). The CPU's conditional jumps compare
	// the operand with ACC: jlsu jumps if last < the offset (as u32s).
	sub __check_relocations(var table: u32*, var count: u32, var last: u32) -> bool {
		if (count == 0)
			return true;
		var bad: u32 = 0;
		low {
			mov R1, $table
			mov R3, $count
			mov R5, $last
		__drx_check_loop:
			mov ACC, *R1
			jlsu $__drx_check_bad, R5
			addip R1, 0x00000004
			dec R3
			mov ACC, R3
			jne $__drx_check_loop, 0x00000000
			jmp $__drx_check_done
		__drx_check_bad:
			mov $bad, 0x00000001
		__drx_check_done:
		}
		return bad == 0;
	}

	// Adds base to the word at base + offset, for every offset in the table.
	sub __relocate(var base: u8*, var table: u32*, var count: u32) {
		if (count == 0)
			return;
		low {
			mov R1, $table
			mov R2, $base
			mov R3, $count
		__drx_relocate_loop:
			mov R4, *R1
			addip R4, R2
			mov R5, *R4
			addip R5, R2
			mov *R4, R5
			addip R1, 0x00000004
			dec R3
			mov ACC, R3
			jne $__drx_relocate_loop, 0x00000000
		}
	}

	// Loads the DRX in file_bytes to base (at most capacity bytes): copies the image there and adds
	// base to every address in it. Nothing is allocated, and base is untouched on errors (the
	// header and the relocations are checked first). out_entry gets the address to start the
	// program at (base + entry: see run()).
	// In place: base can overlap the file if it is at or below the image in the file (e.g. base ==
	// file_bytes: the file read where the program goes) and the image doesn't reach the
	// relocation table (it is after the image in dsc's files): the image is copied forward, so
	// every byte is read before it is overwritten. Other overlaps: Errors.Overlap.
	sub load(var file_bytes: u8*, var file_size: u32, var base: u8*, var capacity: u32, var out_entry: u32* = null) -> i32 {
		var h: Header;
		var r: i32 = read_header(file_bytes, file_size, &h);
		if (r != Errors.NoError) return r;
		if (not base) return Errors.NullOutputPtr;
		if (h.image_size > capacity) return Errors.ImageTooBig;
		var b: u32 = cast<u32>(base);
		var f: u32 = cast<u32>(file_bytes);
		if (b < f + file_size and f < b + h.image_size) {
			var t: u32 = f + h.reloc_offset;
			if (b > f + h.header_size or (b < t + h.reloc_count * 4 and t < b + h.image_size))
				return Errors.Overlap;
		}
		// The machine is big endian like the file, and takes unaligned words: the offsets and the
		// addresses are read and written as u32s.
		var table: u32* = cast<u32*>(&file_bytes[h.reloc_offset]);
		if (not __check_relocations(table, h.reloc_count, h.image_size - 4))
			return Errors.RelocationOutOfRange;
		// Forward (in place: the destination is never ahead of the source), a word at a time.
		var src: u8* = &file_bytes[h.header_size];
		var words: u32 = h.image_size / 4;
		__copy_words(base, src, words);
		for (var i: u32 = words * 4; i < h.image_size; i++)
			base[i] = src[i];
		__relocate(base, table, h.reloc_count);
		notify_loaded(b, h.image_size, h.id_hi, h.id_lo);	// (h: read before the file was overwritten)
		if (out_entry) *out_entry = b + h.entry;
		return Errors.NoError;
	}

	// Starts a loaded program (load()'s out_entry) the way loaders do: with argc / argv, or with
	// none (argc 0). It returns when the program's main returns, with main's value.
	inline sub run(var entry: u32, var argc: i32 = 0, var argv: string* = null) -> i32 {
		if (argc == 0)
			return cast<sub() -> i32>(entry)();
		return cast<sub(i32, string*) -> i32>(entry)(argc, argv);
	}
}
