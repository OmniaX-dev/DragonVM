Disks = dragon/disk.drd
Bios = dragon/bios.bin
CMOS = dragon/cmos.dr

cpuext = extmov, extalu
fixed_clock = true
clock_rate_sec = 48000
ram_size_kb = 65536
# Bytes the disk interface copies per cycle (default 1024)
disk_block_size = 1024

screen_redraw_rate_per_second = 30

SingleColor_foreground = #009900FF
SingleColor_background = #111111FF
16Color_Palette = 0

# Screen look (needs GPU shader support)
crt_effect = true
bloom_effect = true
